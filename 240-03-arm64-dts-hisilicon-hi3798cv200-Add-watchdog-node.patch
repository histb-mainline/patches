From 5a8bcf2f7c89ffe2f109de233187198ef5f2ea24 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Sun, 22 Nov 2026 06:16:52 +0800
Subject: [PATCH 3/3] arm64: dts: hisilicon: hi3798cv200: Add watchdog node

Add the on-chip watchdog controller node to hi3798cv200.dtsi and its
alias in hi3798cv200-poplar.dts, backed by the new hisilicon,histb-wdt
platform driver.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 arch/arm64/boot/dts/hisilicon/hi3798cv200-poplar.dts | 1 +
 arch/arm64/boot/dts/hisilicon/hi3798cv200.dtsi       | 8 ++++++++
 2 files changed, 9 insertions(+)

--- a/arch/arm64/boot/dts/hisilicon/hi3798cv200-poplar.dts
+++ b/arch/arm64/boot/dts/hisilicon/hi3798cv200-poplar.dts
@@ -18,6 +18,7 @@ / {
 	aliases {
 		serial0 = &uart0;
 		serial2 = &uart2;
+		watchdog0 = &watchdog0;
 	};
 
 	chosen {
--- a/arch/arm64/boot/dts/hisilicon/hi3798cv200.dtsi
+++ b/arch/arm64/boot/dts/hisilicon/hi3798cv200.dtsi
@@ -254,6 +254,14 @@ range: gpio-range {
 			};
 		};
 
+		watchdog0: watchdog@8a2c000 {
+			compatible = "hisilicon,hi3798cv200-wdt", "hisilicon,histb-wdt";
+			reg = <0x8a2c000 0x1000>;
+			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HISTB_OSC_CLK>;
+			clock-names = "wdgclk";
+		};
+
 		uart0: serial@8b00000 {
 			compatible = "arm,pl011", "arm,primecell";
 			reg = <0x8b00000 0x1000>;
