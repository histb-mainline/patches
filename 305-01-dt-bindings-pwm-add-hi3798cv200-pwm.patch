From 969101c71e414df5ece66f92d1ed5481dee0a27f Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Thu, 5 Nov 2026 00:11:25 +0800
Subject: [PATCH 1/6] dt-bindings: pwm: add hi3798cv200 pwm

The PMOC block of the HiSilicon Hi3798cv200 STB SoC provides three PWM
outputs which drive an external converter. Document them so the
converters can be described with the generic pwm-regulator binding. The
number of outputs differs between the SoCs carrying the block, so every
SoC takes its own compatible value and this adds the Hi3798cv200 one.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../pwm/hisilicon,hi3798cv200-pwm.yaml        | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pwm/hisilicon,hi3798cv200-pwm.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/hisilicon,hi3798cv200-pwm.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/hisilicon,hi3798cv200-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon STB PMOC PWM
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description:
+  The Power Management Of Chip (PMOC) block of the HiSilicon Hi3798cv200 STB
+  SoC provides three PWM outputs, which on the reference designs drive the
+  feedback node of an external converter such as a pwm-regulator. The number
+  of outputs differs between the SoCs carrying this block, so each SoC has
+  its own compatible value.
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: hisilicon,hi3798cv200-pwm
+
+  reg:
+    description:
+      The registers of the outputs, one 32-bit register per output. The
+      window has to cover every output of the SoC.
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  "#pwm-cells":
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - clocks
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/histb-clock.h>
+
+    pwm@8a23018 {
+        compatible = "hisilicon,hi3798cv200-pwm";
+        reg = <0x8a23018 0xc>;
+        clocks = <&crg HISTB_OSC_CLK>;
+        #pwm-cells = <2>;
+    };
