 	writel_relaxed(val | CRG54_VO_HD_CLK_SEL | CRG54_VO_HD_CKEN, clk->crg54);
 
+	/* board test instrument, not for submission */
+	pr_info("hd_pix: prepare crg54 now %08x applied rate %lu\n",
