diff --git a/drivers/media/platform/hisilicon/histb-vpss.c b/drivers/media/platform/hisilicon/histb-vpss.c
index 5fc381074f7d..ade08293bd5f 100644
--- a/drivers/media/platform/hisilicon/histb-vpss.c
+++ b/drivers/media/platform/hisilicon/histb-vpss.c
@@ -98,6 +98,7 @@ struct histb_vpss_variant {
 	u32	errors;
 	u32	timeout;
 	const char *(*err_name)(u32 st);
+	void	(*fault_dump)(struct histb_vpss *vpss);
 	bool	arm_detector;	/* the generation with an AXI transaction latch */
 	bool	status_from_raw;	/* wait on the unmasked status word, as
 					 * the vendor's own check does
@@ -1093,6 +1094,71 @@ static const char *histb_vpss_v4_err_name(u32 st)
 	return "tunnel overrun";
 }
 
+/*
+ * Which fetch faulted: the masters' latch cells say which of the three read
+ * ports answered the error, the SMMU's pair latches the address of a
+ * translation fault, and the image words say what the job asked for.
+ */
+static void histb_vpss_v4_fault_dump(struct histb_vpss *vpss)
+{
+	const u32 *s = vpss->shadow;
+	void __iomem *r = vpss->regs;
+
+	if (!s)
+		return;
+	dev_err(vpss->dev,
+		"latch: bus_err %#x rd %#x wr %#x src %#x/%#x lat %#x raw %#x pfcnt %#x eof %#x "
+		"det %#x\n",
+		readl(r + VPSS4_MST_BUS_ERR), readl(r + VPSS4_MST0_RD_INFO),
+		readl(r + VPSS4_MST0_WR_INFO), readl(r + VPSS4_MST_SRC0_S0),
+		readl(r + VPSS4_MST_SRC0_S1), readl(r + VPSS4_MST0_LATENCY),
+		readl(r + VPSS4_RAWINT), readl(r + VPSS4_PFCNT),
+		readl(r + VPSS4_EOFCNT), readl(r + VPSS4_MST_DEBUG_CTRL));
+	dev_err(vpss->dev,
+		"smmu: scr %#x rd_ns %#x wr_ns %#x mst_ctrl %#x outstanding %#x misc %#x\n",
+		readl(r + VPSS4_SMMU_SCR), readl(r + VPSS4_SMMU_ERR_RD_NS),
+		readl(r + VPSS4_SMMU_ERR_WR_NS), readl(r + VPSS4_MST_CTRL),
+		readl(r + VPSS4_MST_OUTSTANDING), readl(r + VPSS4_MISCELLANEOUS));
+	dev_err(vpss->dev,
+		"smmu bank: rst %#x dbg0 %#x dbg1 %#x ptwq %#x pref %#x tbu %#x/%#x\n",
+		readl(vpss->regs + VPSS4_SMMU_RESET_STATE),
+		readl(vpss->regs + VPSS4_SMMU_MASTER_DBG0),
+		readl(vpss->regs + VPSS4_SMMU_MASTER_DBG1),
+		readl(vpss->regs + VPSS4_SMMU_PTWQ_IDLE),
+		readl(vpss->regs + VPSS4_SMMU_PREF_BUFFER_EMPTY),
+		readl(vpss->regs + VPSS4_SMMU_FAULT_TBU_INFO),
+		readl(vpss->regs + VPSS4_SMMU_FAULT_TBU_DBG));
+	dev_err(vpss->dev,
+		"image: head %#x/%#x cf %#x %#x %#x/%#x out %#x %#x %#x/%#x\n",
+		s[VPSS4_CTRL / 4], s[VPSS4_CTRL3 / 4], s[VPSS4_CF_CTRL / 4],
+		s[VPSS4_CF_SIZE / 4], s[VPSS4_CF_YADDR_L / 4],
+		s[VPSS4_CF_CADDR_L / 4], s[VPSS4_OUT0_CTRL / 4],
+		s[VPSS4_OUT0_SIZE / 4], s[VPSS4_OUT0_YADDR_L / 4],
+		s[VPSS4_OUT0_CADDR_L / 4]);
+	dev_err(vpss->dev,
+		"chain: head %#x start %#x state %#x node_phys %#x pnext_cell %#x\n",
+		readl(vpss->regs + VPSS4_PNEXT), readl(vpss->regs + VPSS4_START),
+		readl(vpss->regs + VPSS4_INTSTATE),
+		lower_32_bits(vpss->shadow_dma), s[VPSS4_PNEXT / 4]);
+	dev_err(vpss->dev,
+		"image: para %#x %#x %#x %#x zme %#x %#x %#x %#x stride %#x %#x mst %#x\n",
+		s[VPSS4_TNR_ADDR / 4], s[VPSS4_SNR_ADDR / 4],
+		s[VPSS4_ZME_ADDR / 4], s[VPSS4_DEI_ADDR / 4],
+		s[VPSS4_ZME_LHADDR / 4], s[VPSS4_ZME_LVADDR / 4],
+		s[VPSS4_ZME_CHADDR / 4], s[VPSS4_ZME_CVADDR / 4],
+		s[VPSS4_CF_STRIDE / 4], s[VPSS4_OUT0_STRIDE / 4],
+		s[VPSS4_MST_CTRL / 4]);
+	dev_err(vpss->dev,
+		"scale: hsp %#x (%#x) vsp %#x vsr %#x hloff %#x voff %#x\n",
+		s[VPSS4_ZME_HSP / 4],
+		(unsigned int)FIELD_GET(VPSS4_ZME_H_RATIO, s[VPSS4_ZME_HSP / 4]),
+		s[VPSS4_ZME_VSP / 4], s[VPSS4_ZME_VSR / 4],
+		s[VPSS4_ZME_HLOFFSET / 4], s[VPSS4_ZME_VOFFSET / 4]);
+	dev_err(vpss->dev,
+		"oreso: image %#x window %#x\n", s[VPSS4_ZMEORESO / 4],
+		readl(vpss->regs + VPSS4_ZMEORESO));
+}
+
 static void histb_vpss_v4_power_up(struct histb_vpss *vpss)
 {
 	writel(0x7e, vpss->regs + VPSS4_INTMASK);
@@ -1129,6 +1195,7 @@ static const struct histb_vpss_variant histb_vpss_v4 = {
 	.errors = VPSS4_INTSTATE_ERRORS,
 	.timeout = VPSS4_INTSTATE_TIMEOUT,
 	.err_name = histb_vpss_v4_err_name,
+	.fault_dump = histb_vpss_v4_fault_dump,
 	.arm_detector = true,
 	.status_from_raw = true,
 	.pass_run = histb_vpss_v4_pass_run,
@@ -1187,6 +1254,8 @@ static int histb_vpss_kick(struct histb_vpss *vpss, dma_addr_t first)
 				writel(st, vpss->regs + VPSS_INTCLR);
 				dev_err(vpss->dev, "job failed: status %#x (%s)\n",
 					st, vpss->var->err_name(st));
+				if (vpss->var->fault_dump)
+					vpss->var->fault_dump(vpss);
 				if (st & vpss->var->timeout)
 					return -ETIMEDOUT;
 				return -EIO;
@@ -1211,6 +1280,8 @@ static int histb_vpss_kick(struct histb_vpss *vpss, dma_addr_t first)
 	}
 
 	dev_warn(vpss->dev, "job timed out, status %#x\n", st);
+	if (vpss->var->fault_dump)
+		vpss->var->fault_dump(vpss);
 	writel(0xffffffff, vpss->regs + VPSS_INTCLR);
 	if (histb_vpss_reset(vpss))
 		return -EIO;
