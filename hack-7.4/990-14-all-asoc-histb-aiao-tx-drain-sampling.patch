Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Wed, 4 Nov 2026 00:17:21 +0800
Subject: [LOCAL] asoc: histb: aiao TX drain sampling


Kept out of the submitted series on purpose: the per-tick dev_dbg of TX_BUFF_RPTR in histb_aiao_tx_draining() was the channel the board round sampled; the stall detection itself is submitted, the sampling is not.
 1 file changed, 9 insertions(+), 6 deletions(-)


diff --git a/sound/soc/hisilicon/histb-aiao-i2s.c b/sound/soc/hisilicon/histb-aiao-i2s.c
index 9b0f6b2c0f13..8cd656e10f5d 100644
--- a/sound/soc/hisilicon/histb-aiao-i2s.c
+++ b/sound/soc/hisilicon/histb-aiao-i2s.c
@@ -510,6 +510,12 @@ static void histb_aiao_tx_commit(struct histb_aiao_port *port,
 	WRITE_ONCE(port->announced, true);
 }
 
+/*
+ * Stopping must never wait for a running tick: .trigger holds the stream lock
+ * and period_elapsed() takes that same lock, so the flag above ends the timer
+ * and expiry happens in soft context - the pattern sound/drivers/dummy.c uses
+ * for the same reason.
+ */
 /*
  * The tick owns the PCM position, so a transmit port that stops draining its
  * ring would stay silent indefinitely: it keeps TX_ENABLE set -- the check in
@@ -528,12 +534,15 @@ static bool histb_aiao_tx_draining(struct histb_aiao_port *port,
 {
 	struct device *dev = port->substream->pcm->card->dev;
 	unsigned int size = frames_to_bytes(runtime, runtime->buffer_size);
+	unsigned int expect = frames_to_bytes(runtime, runtime->period_size);
 	u32 rptr = readl(port->regs + TX_BUFF_RPTR) & GENMASK(23, 0);
 	u32 delta = (rptr + size - port->watch_rptr) % size;
 
 	if (delta) {
 		port->watch_rptr = rptr;
 		port->stalls = 0;
+		dev_dbg(dev, "tx rptr %u: +%u bytes, period is %u bytes\n",
+			rptr, delta, expect);
 		return true;
 	}
 
@@ -545,12 +554,6 @@ static bool histb_aiao_tx_draining(struct histb_aiao_port *port,
 	return false;
 }
 
-/*
- * Stopping must never wait for a running tick: .trigger holds the stream lock
- * and period_elapsed() takes that same lock, so the flag above ends the timer
- * and expiry happens in soft context - the pattern sound/drivers/dummy.c uses
- * for the same reason.
- */
 static enum hrtimer_restart histb_aiao_period_tick(struct hrtimer *timer)
 {
 	struct histb_aiao_port *port = container_of(timer, struct histb_aiao_port, tick);
