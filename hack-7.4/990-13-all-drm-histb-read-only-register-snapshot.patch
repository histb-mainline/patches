Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Wed, 4 Nov 2026 00:17:21 +0800
Subject: [LOCAL] drm: histb read-only register snapshot


Restore the read-only display-pipeline snapshot tool kept out of the submitted series on purpose.
 2 files changed, 10 insertions(+)


diff --git a/drivers/gpu/drm/histb/Kconfig b/drivers/gpu/drm/histb/Kconfig
index ca5879798727..2f113ef380b7 100644
--- a/drivers/gpu/drm/histb/Kconfig
+++ b/drivers/gpu/drm/histb/Kconfig
@@ -31,3 +31,12 @@ config DRM_HISTB_HDMI
 	  link.
 
 	  If in doubt, say N.
+
+config DRM_HISTB_VODUMP
+	bool "Read-only VDP/HDMI register snapshot"
+	depends on DRM && OF && ARM
+	help
+	  Snapshot the display pipeline exactly as the
+	  vendor fastboot left it while scanning out its
+	  boot logo, without writing any device register.
+	  For diffing against the DRM drivers; say N for normal use.
diff --git a/drivers/gpu/drm/histb/Makefile b/drivers/gpu/drm/histb/Makefile
index 5b89b3ccaf0f..6a922b6f659d 100644
--- a/drivers/gpu/drm/histb/Makefile
+++ b/drivers/gpu/drm/histb/Makefile
@@ -2,3 +2,4 @@
 obj-$(CONFIG_DRM_HISTB_VDP) += histb-vdp.o
 histb-vdp-y := histb-vdp-core.o histb-vdp2.o histb-vdp4.o
 obj-$(CONFIG_DRM_HISTB_HDMI) += histb-hdmi.o
+obj-$(CONFIG_DRM_HISTB_VODUMP) += histb-vodump.o
