diff --git a/drivers/media/rc/ir-hix5hd2.c b/drivers/media/rc/ir-hix5hd2.c
index 2e995cbdea14..87091ae96e43 100644
--- a/drivers/media/rc/ir-hix5hd2.c
+++ b/drivers/media/rc/ir-hix5hd2.c
@@ -244,11 +244,12 @@ static const struct of_device_id hix5hd2_ir_table[] = {
 	{ .compatible = "hisilicon,hix5hd2-ir", &hix5hd2_data, },
 	{ .compatible = "hisilicon,hi3796cv300-ir", &hi3796cv300_data, },
 	/*
-	 * Hi3716CV200 keeps the same register map and the same gate
-	 * (SYS_CTRL + 0x48, bit 4 enable, bit 5 reset), and its boot
-	 * leaves 0x3e80 in the symbol-width field this driver programs,
-	 * so it reuses the hix5hd2 data. It needs no extra power-enable
-	 * bit.
+	 * Hi3716CV200 keeps the same register map -- the value its own boot left in
+	 * IR_CONFIG, 0x3e801f0b, has 0x3e80 in bits 16..31, which is the symbol-width
+	 * field this driver writes IR_CFG_SYMBOL_MAXWIDTH into -- and the gate sits at
+	 * the same place: SYS_CTRL (0xf8000000) + 0x48, bit 4 enable / bit 5 reset,
+	 * which is hix5hd2_data's clk_reg. It does not need the extra enable bit,
+	 * because the vendor's ir_enable() writes 0x1, not 0x101.
 	 */
 	{ .compatible = "hisilicon,hi3716cv200-ir", &hix5hd2_data, },
 	{},
@@ -321,12 +322,11 @@ static int hix5hd2_ir_probe(struct platform_device *pdev)
 	rdev->timeout = IR_CFG_SYMBOL_MAXWIDTH * 10;
 
 	/*
-	 * The handler dereferences priv->rdev, so publish it before the
-	 * request_irq below: on Hi3716CV200 the block raises the RX line within
-	 * milliseconds of the clock gate opening, and on Hi3798MV200H the
-	 * bootloader leaves a decoded edge pending in IR_RAW_STAT, so an
-	 * interrupt that lands while rdev is still NULL oopses in
-	 * ir_raw_event_store() with a NULL argument.
+	 * The handler dereferences priv->rdev, so publish it before the request_irq
+	 * below: on Hi3716CV200 the block raises the RX line within milliseconds of
+	 * the clock gate opening, and on Hi3798MV200H the bootloader leaves a decoded
+	 * edge pending in IR_RAW_STAT, so an interrupt that lands while rdev is still
+	 * NULL oopses in ir_raw_event_store() with a NULL argument.
 	 */
 	priv->rdev = rdev;
 	priv->dev = dev;
