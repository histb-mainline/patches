Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Thu, 22 Oct 2026 05:39:26 +0800
Subject: arm64: dts: hisilicon: describe the Hi3798MV200 display engine

The output path has no description.
The VDP window is sized to the MMU debug block at 0xf530 and takes the
block interrupt the vendor build names (INTID 122, SPI 90), and the
transmitter is the flattened SiI9134 face with a digital half and an
analog PHY window.
Describe the channel and the transmitter, linked through of_graph and
both left disabled.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 1 file changed, 68 insertions(+)


diff --git a/arch/arm64/boot/dts/hisilicon/hi3798mv200.dtsi b/arch/arm64/boot/dts/hisilicon/hi3798mv200.dtsi
index f89dc73e41cb..f58db841097f 100644
--- a/arch/arm64/boot/dts/hisilicon/hi3798mv200.dtsi
+++ b/arch/arm64/boot/dts/hisilicon/hi3798mv200.dtsi
@@ -577,6 +577,39 @@ gpio9: gpio@8b29000 {
 			status = "disabled";
 		};
 
+		vdp: display@8cc0000 {
+			compatible = "hisilicon,hi3798mv200-vdp";
+			/*
+			 * The window the register file spans: the highest offset of
+			 * the VDP unit is its MMU debug block at 0xf530. The vendor
+			 * build takes this block's interrupt as INTID 122, which is
+			 * this SPI 90.
+			 */
+			reg = <0x8cc0000 0x10000>;
+			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3798MV200_VO_HD>,
+				 <&crg HI3798MV200_VO_BUS>,
+				 <&crg HI3798MV200_VO_SDATE>;
+			clock-names = "pix", "bus", "sdate";
+			resets = <&crg 0x34c 29>;
+			reset-names = "vdp";
+			hisilicon,crg = <&crg>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					vdp_out_hdmi: endpoint {
+						remote-endpoint = <&hdmi_in_vdp>;
+					};
+				};
+			};
+		};
+
 		aiao: audio@8cd0000 {
 			compatible = "hisilicon,hi3798mv200-aiao-i2s";
 			reg = <0x8cd0000 0x10000>;
@@ -596,6 +629,41 @@ aiao: audio@8cd0000 {
 			status = "disabled";
 		};
 
+		hdmi: hdmi@8ce0000 {
+			compatible = "hisilicon,hi3798mv200-hdmi";
+			/*
+			 * Two windows: the digital transmitter, whose register file
+			 * reaches past its 8051 block at 0x1c000, and the analog PHY
+			 * at 0x8d30000. The resets named by index below are CRG67's
+			 * controller bus, controller and SSC requests and CRG68's
+			 * TMDS request; CRG68's PHY request is pulsed by the driver
+			 * along with each divider change.
+			 */
+			reg = <0x8ce0000 0x20000>, <0x8d30000 0x1000>;
+			reg-names = "tx", "phy";
+			clocks = <&crg HI3798MV200_VO_HD>,
+				 <&crg HI3798MV200_HDMITX_PHY_TMDS_CLK>;
+			clock-names = "pix", "tmds";
+			#sound-dai-cells = <0>;
+			resets = <&crg 0x10c 6>, <&crg 0x10c 7>, <&crg 0x10c 9>,
+				 <&crg 0x110 5>;
+			hisilicon,crg = <&crg>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					hdmi_in_vdp: endpoint {
+						remote-endpoint = <&vdp_out_hdmi>;
+					};
+				};
+			};
+		};
+
 		gpu: gpu@9200000 {
 			compatible = "hisilicon,hi3798mv200-mali", "arm,mali-450";
 			/*
