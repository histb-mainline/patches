+#define   TX_MUTE_EN			BIT(0)
+#define   TX_MUTE_FADE_EN		BIT(1)
+#define   TX_VOLUME			GENMASK(14, 8)
+#define   TX_FADE_IN_RATE		GENMASK(19, 16)
+#define   TX_FADE_OUT_RATE		GENMASK(23, 20)
