+/* 0x29 is -80 dB and the field steps 1 dB, so unity is 0x79. */
+#define   TX_VOLUME_0DB			0x79
+/* Ramp step of 16 samples: the 80 dB range takes about 27 ms at 48 kHz. */
+#define   TX_FADE_RATE_CODE		4
