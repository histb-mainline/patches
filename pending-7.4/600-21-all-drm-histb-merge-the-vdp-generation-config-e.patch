Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Tue, 3 Nov 2026 14:31:01 +0800
Subject: drm/histb: merge the VDP generation config entries

The two generation drivers build as one module, so their config entries
merge as well.
Replace DRM_HISTB_VDP2 and DRM_HISTB_VDP4 with one DRM_HISTB_VDP that
covers both engines and carries the dependencies either of them needs,
and point the object line at the merged symbol.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 2 files changed, 20 insertions(+), 21 deletions(-)


diff --git a/drivers/gpu/drm/histb/Kconfig b/drivers/gpu/drm/histb/Kconfig
index f7db7fb47af7..ca5879798727 100644
--- a/drivers/gpu/drm/histb/Kconfig
+++ b/drivers/gpu/drm/histb/Kconfig
@@ -1,34 +1,33 @@
 # SPDX-License-Identifier: GPL-2.0-or-later OR MIT
-config DRM_HISTB_VDP2
-	tristate "DRM Support for HiSTB VDP v2 display engine"
-	depends on DRM && OF && ARM
+config DRM_HISTB_VDP
+	tristate "DRM Support for HiSTB VDP display engines"
+	depends on DRM && OF
+	depends on ARCH_HISI || COMPILE_TEST
 	select DRM_GEM_DMA_HELPER
 	select DRM_KMS_HELPER
 	select DRM_DISPLAY_HELPER
 	select DRM_BRIDGE_CONNECTOR
 	select DRM_CLIENT_SELECTION
 	help
-	  Choose this option for DRM support for the VDP v2 display engine found
-	  on HiSilicon HiSTB SoCs such as the hi3798mv100 and the hi3796mv100.
-	  It exposes one CRTC with a primary plane and sends its output to the
-	  HDMI transmitter selected through the device tree of_graph port@0
-	  endpoint.
+	  Choose this option for DRM support for the VDP display engines found
+	  on HiSilicon HiSTB SoCs. It covers the v2 engine of the hi3716cv200 and
+	  hi3798mv100 generation and the v4 engine of the hi3798mv200, each with
+	  its own register programming and clock/reset sequence. The driver
+	  exposes one CRTC with a primary plane and sends its output to the
+	  transmitter selected through the device tree of_graph port@0 endpoint;
+	  the v2 engine also exposes its write-back taps.
 
 	  If in doubt, say N.
 
-config DRM_HISTB_VDP4
-	tristate "DRM Support for HiSTB VDP v4 display engine"
-	depends on DRM && OF && ARM64
+config DRM_HISTB_HDMI
+	tristate "DRM support for the HiSTB on-chip HDMI transmitter"
+	depends on DRM && I2C && OF && ARM64
 	select MFD_SYSCON
-	select DRM_GEM_DMA_HELPER
-	select DRM_KMS_HELPER
-	select DRM_DISPLAY_HELPER
-	select DRM_BRIDGE_CONNECTOR
-	select DRM_CLIENT_SELECTION
+	select SND_SOC_HDMI_CODEC if SND_SOC
 	help
-	  Choose this option for DRM support for the VDP v4 display engine found
-	  on HiSilicon HiSTB SoCs such as the hi3798mv200. It exposes one CRTC with
-	  a primary plane and sends its output to the display interface selected
-	  through the device tree of_graph port@0 endpoint.
+	  Choose this option for the on-chip HDMI 2.0 transmitter of HiSilicon
+	  HiSTB SoCs such as the hi3798mv200. It is the bridge downstream of a
+	  VDP display channel and turns that channel's pixel stream into a TMDS
+	  link.
 
 	  If in doubt, say N.
diff --git a/drivers/gpu/drm/histb/Makefile b/drivers/gpu/drm/histb/Makefile
index 6db73e338d1b..5b89b3ccaf0f 100644
--- a/drivers/gpu/drm/histb/Makefile
+++ b/drivers/gpu/drm/histb/Makefile
@@ -1,4 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-or-later OR MIT
-obj-$(CONFIG_DRM_HISTB_VDP2) += histb-vdp.o
+obj-$(CONFIG_DRM_HISTB_VDP) += histb-vdp.o
 histb-vdp-y := histb-vdp-core.o histb-vdp2.o histb-vdp4.o
 obj-$(CONFIG_DRM_HISTB_HDMI) += histb-hdmi.o
