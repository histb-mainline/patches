index 000000000000..e876c1fa8778
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2.h
@@ -0,0 +1,414 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * HiSilicon VDH v2 stateless video decoder backend, for the Hi3716CV200
+ * (HiVDHV200R004) and Hi3798MV100 (HiVDHV300R001) parts.
+ *
+ * The hardware decoder consumes fully parsed syntax: the userspace submits
+ * per-frame parsing results through V4L2 stateless controls, and the driver
+ * packs them into the hardware's downstream message pool, programs the VDM
+ * registers and rings the doorbell. Frame storage uses a table+index model:
+ * capture buffers are registered by index and referenced by id from the message
+ * pool. The engine writes 16x16-tiled NV21 frames; CAPTURE is linear and
+ * each dpb index keeps such a tile frame internally (see histb_vdec_frame).
+ *
+ * The register layouts, message slot encodings and buffer geometries recorded
+ * below were derived from the vendor decoder firmware and then checked against
+ * the hardware.
+ */
+#ifndef HISTB_VDEC_H
+#define HISTB_VDEC_H
+
+#include <linux/delay.h>
+#include <linux/platform_device.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "histb_vdec_core.h"
+#include "histb_vdec_v2_regs.h"
+
+struct regmap;
+
+#define HISTB_VDEC_NAME			"histb-vdec"
+
+/* One downstream message slot: 5 x 64-word bursts. */
+#define HISTB_VDEC_SLOT_WORDS		320
+#define HISTB_VDEC_SLOT_BYTES		(HISTB_VDEC_SLOT_WORDS * 4)
+#define HISTB_VDEC_MAX_SLICE_SLOTS	140
+#define HISTB_VDEC_UP_MSG_WORDS		4
+#define HISTB_VDEC_MAX_UP_SLICES	200
+
+#define HISTB_VDEC_MAX_DPB_SLOTS	32
+#define HISTB_VDEC_MAX_APC_SLOTS	16
+#define HISTB_VDEC_MAX_PMV_SLOTS	20
+#define HISTB_VDEC_MAX_WIDTH		1920
+#define HISTB_VDEC_MAX_HEIGHT		1920
+
+/* Watchdog, matching the fixed timeout the vendor firmware arms here. */
+#define HISTB_VDEC_TIMEOUT		msecs_to_jiffies(500)
+
+/* Sizes of the fixed per-protocol lookup tables (extracted from the vendor
+ * firmware's constant pools).
+ */
+#define HISTB_VDEC_CABAC_MN_H264_SIZE	5120
+#define HISTB_VDEC_CABAC_MN_HEVC_SIZE	928
+/* The tile/segment info image that picture message D55 points at, sized by the
+ * reservation the vendor firmware makes for its own copy of the same area (64 *
+ * 4 * 128 bytes); growing it from the 2 KB first used here changed no board
+ * reading, so this is fidelity to the vendor layout rather than a fix.
+ */
+#define HISTB_VDEC_TILE_INFO_SIZE	(64 * 4 * 128)
+#define HISTB_VDEC_PPFD_SIZE		(64 * 4 * 800)
+
+/* Band-line scratch buffers, sized by the vendor layout: 64 * 4 * width bytes
+ * each at 1920 columns. Which of these a protocol actually references is fixed
+ * per protocol (see the codec sources).
+ */
+#define HISTB_VDEC_SCRATCH_SIZE		(64 * 4 * HISTB_VDEC_MAX_WIDTH)
+enum histb_vdec_scratch {
+	HISTB_SCRATCH_SED_TOP,
+	HISTB_SCRATCH_PMV_TOP,
+	HISTB_SCRATCH_RCNTOP,
+	HISTB_SCRATCH_DBLK_TOP,
+	HISTB_SCRATCH_SAO_TOP,
+	HISTB_SCRATCH_PMV_LEFT,
+	HISTB_SCRATCH_SAO_LEFT,
+	HISTB_SCRATCH_DBLK_LEFT,
+	HISTB_SCRATCH_ITRANS_TOP,
+	HISTB_VDEC_NUM_SCRATCH,
+};
+
+/*
+ * Single downstream/upstream message pool, allocated once per device: the VDM
+ * decodes one frame at a time, so the pool is owned by the device and borrowed
+ * by whichever job is running. Write-combining mapping: both the CPU (message
+ * producer/consumer) and the VDM DMA master access it, and the vendor firmware
+ * uses uncached mappings for the same purpose.
+ *
+ * Layout:
+ *   [0]                          picture slot
+ *   [slot 1 .. N]                slice slots
+ *   [after slices]               upstream report messages
+ *   [aligned]                    per-protocol tables & scratch
+ */
+struct histb_vdec_msgpool {
+	dma_addr_t	dma;
+	void		*va;
+	size_t		size;
+	/* Fixed offsets inside va, initialised at allocation time. */
+	unsigned int	pic_off;
+	unsigned int	slice_off;
+	unsigned int	up_off;
+	unsigned int	table_off;
+};
+
+/*
+ * Mirror of the luma-stride rule the vendor firmware applies to the tiled write
+ * path: a stride that is already a multiple of 256 is kept, otherwise round up
+ * to the next 256-byte tile column count and skip to an odd one. 320 -> 768,
+ * 640 -> 768, 192 -> 256, 512 -> 512, 1920 -> 2304.
+ */
+static inline unsigned int histb_vdec_tile_stride(unsigned int width)
+{
+	unsigned int cols = width / 256;
+
+	if (!(width % 256))
+		return width;
+	cols += (cols % 2) ? 2 : 1;
+
+	return cols * 256;
+}
+
+/*
+ * HEVC's band pitch is a plain ALIGN(width, 256), not the odd/even column rule
+ * above: 320 -> 512 and 1920 -> 2048. Board-measured line by line - the HEVC
+ * corpus only untiles byte-exactly at this pitch.
+ */
+static inline unsigned int histb_vdec_hevc_stride(unsigned int width)
+{
+	return ALIGN(width, 256);
+}
+
+/*
+ * Frame-buffer geometry of the 1D (tiled) write path, measured on the board
+ * and matched to the geometry the firmware programs for H.264. The VDM writes
+ * tiles of 256 bytes by 16 picture rows: inside a band the line pitch is the
+ * tile width, VDM_YSTRIDE_1D carries the pitch *between* bands, and the chroma
+ * tiles start behind the whole luma band array plus a per-picture 1D area. The
+ * band count rounds up to an even number because field coding reserves a pair.
+ */
+static inline unsigned int histb_vdec_band_bytes(unsigned int tile_stride)
+{
+	return tile_stride * 16;
+}
+
+static inline unsigned int histb_vdec_head_inf_bytes(unsigned int lines)
+{
+	return 16 * ALIGN(lines, 32);
+}
+
+static inline unsigned int histb_vdec_luma_bytes(unsigned int tile_stride,
+						 unsigned int lines)
+{
+	return tile_stride * ALIGN(lines, 32);
+}
+
+/* Luma bands, the 1D area behind them, then the chroma bands at half size. */
+static inline unsigned int histb_vdec_frame_bytes(unsigned int tile_stride,
+						  unsigned int lines)
+{
+	return histb_vdec_luma_bytes(tile_stride, lines) / 2 * 3 +
+	       histb_vdec_head_inf_bytes(lines);
+}
+
+static inline void *histb_vdec_pic_slot(const struct histb_vdec_msgpool *p)
+{
+	return p->va + p->pic_off;
+}
+
+static inline dma_addr_t
+histb_vdec_pic_slot_dma(const struct histb_vdec_msgpool *p)
+{
+	return p->dma + p->pic_off;
+}
+
+static inline void *histb_vdec_slice_slot(const struct histb_vdec_msgpool *p,
+					  unsigned int i)
+{
+	return p->va + p->slice_off + i * HISTB_VDEC_SLOT_BYTES;
+}
+
+static inline dma_addr_t
+histb_vdec_slice_slot_dma(const struct histb_vdec_msgpool *p, unsigned int i)
+{
+	return p->dma + p->slice_off + i * HISTB_VDEC_SLOT_BYTES;
+}
+
+static inline void *histb_vdec_up_msgs(const struct histb_vdec_msgpool *p)
+{
+	return p->va + p->up_off;
+}
+
+static inline dma_addr_t
+histb_vdec_up_msgs_dma(const struct histb_vdec_msgpool *p)
+{
+	return p->dma + p->up_off;
+}
+
+static inline void *histb_vdec_tables_base(const struct histb_vdec_msgpool *p)
+{
+	return p->va + p->table_off;
+}
+
+static inline dma_addr_t
+histb_vdec_tables_dma(const struct histb_vdec_msgpool *p)
+{
+	return p->dma + p->table_off;
+}
+
+struct histb_vdec_dev {
+	struct histb_vdec_common common;
+	struct device		*dev;
+	struct device		*memdev;
+	const struct histb_vdec_chip *chip;
+	void __iomem		*vdm;
+	void __iomem		*scd;
+	struct clk_bulk_data	*clks;
+	int			num_clks;
+	struct reset_control	*rst;
+	int			irq;
+
+	struct delayed_work	watchdog;
+
+	/* VDM state captured by the primary handler for the IRQ thread */
+	u32			irq_state;
+	/* Macroblocks the submitted picture covers, 0 when the front end does
+	 * not report them; the slice reports are checked against it.
+	 */
+	u32			mb_total;
+
+	/* protects the message pool and the VDM against concurrent jobs */
+	struct mutex		hw_lock;
+	struct histb_vdec_msgpool pool;
+	bool			job_running;
+
+	struct regmap		*crg;
+};
+
+/*
+ * One internal frame: the engine only writes 16x16 tiles, while CAPTURE is a
+ * linear format, so every dpb index owns a tile buffer here and the job's
+ * completion detiles it into the client's buffer. References are read from
+ * these buffers too, which is why they have to outlive the job.
+ */
+struct histb_vdec_frame {
+	void		*va;
+	dma_addr_t	dma;
+	size_t		size;
+	unsigned int	stride;
+	unsigned int	lines;
+};
+
+struct histb_vdec_ctx {
+	struct v4l2_fh		fh;
+	struct v4l2_ctrl_handler ctrl_hdl;
+	const struct histb_vdec_fmt *desc;
+	struct v4l2_format	out_fmt;
+	struct v4l2_format	cap_fmt;
+
+	/* dpb (capture buffer) index -> pmv slot id, filled on demand by the
+	 * codec layers; pmv slots are a private 20-entry pool.
+	 */
+	u8			pmv_map[HISTB_VDEC_MAX_DPB_SLOTS];
+	u8			pmv_next;
+
+	struct histb_vdec_frame	frame[HISTB_VDEC_MAX_DPB_SLOTS];
+
+	/* MPEG-2 front end: the submitted stream carries no sequence
+	 * extension, so the block has to be told MPEG-1 syntax.
+	 */
+	bool			mpeg1;
+
+	/* One verbose engine-flag report per stream: the flag is set on frames
+	 * that still traverse every macroblock, so a per-frame report is noise.
+	 */
+	bool			diag_reported;
+
+	void			*priv;
+};
+
+struct histb_vdec_codec_ops {
+	int (*start)(struct histb_vdec_ctx *ctx);
+	void (*stop)(struct histb_vdec_ctx *ctx);
+	/*
+	 * Assemble the message pool and program the VDM for one frame, then
+	 * ring the doorbell via histb_vdec_hw_kick(). Runs with dev->hw_lock
+	 * held and the runtime PM reference taken.
+	 */
+	int (*run)(struct histb_vdec_ctx *ctx, struct vb2_v4l2_buffer *src,
+		   struct vb2_v4l2_buffer *dst);
+	int (*try_ctrl)(struct v4l2_ctrl *ctrl);
+};
+
+/* One protocol's descriptor, shared with the core. */
+typedef struct histb_vdec_fmt histb_vdec_fmt_desc;
+typedef struct histb_vdec_chip histb_vdec_chip_t;
+
+/* Per-protocol descriptors, defined by the codec sources. */
+extern const histb_vdec_fmt_desc histb_vdec_h264_fmt;
+extern const histb_vdec_fmt_desc histb_vdec_hevc_fmt;
+extern const histb_vdec_fmt_desc histb_vdec_mpeg2_fmt;
+extern const histb_vdec_fmt_desc histb_vdec_mpeg4_fmt;
+extern const histb_vdec_fmt_desc histb_vdec_h263_fmt;
+
+/* drv.c */
+int histb_vdec_v2_probe(struct platform_device *pdev,
+			const struct histb_vdec_gen *gen);
+void histb_vdec_v2_remove(struct platform_device *pdev);
+irqreturn_t histb_vdec_irq_handler(int irq, void *priv);
+int histb_vdec_cap_dims(struct histb_vdec_ctx *ctx, unsigned int *w,
+			unsigned int *h);
+void histb_vdec_buf_geom(struct histb_vdec_ctx *ctx, unsigned int *stride,
+			 unsigned int *lines);
+dma_addr_t histb_vdec_frame_dma(struct histb_vdec_ctx *ctx,
+				struct vb2_buffer *vb);
+void histb_vdec_frames_free(struct histb_vdec_ctx *ctx);
+/* Bitstream start, honouring the plane's data_offset. */
+void *histb_vdec_src_va(struct vb2_buffer *vb);
+dma_addr_t histb_vdec_src_dma(struct vb2_buffer *vb);
+
+/* hw.c */
+int histb_vdec_hw_init(struct histb_vdec_dev *dev);
+void histb_vdec_hw_reset(struct histb_vdec_dev *dev);
+void histb_vdec_hw_kick(struct histb_vdec_dev *dev,
+			enum histb_vdec_vidstd std);
+/* Program the constant tables once at probe. */
+void histb_vdec_hw_init_tables(struct histb_vdec_dev *dev);
+
+static inline void vdm_write(struct histb_vdec_dev *dev, unsigned int reg,
+			     u32 val)
+{
+	writel(val, dev->vdm + reg);
+}
+
+static inline u32 vdm_read(struct histb_vdec_dev *dev, unsigned int reg)
+{
+	return readl(dev->vdm + reg);
+}
+
+/* Convert an OUTPUT plane into the vendor's bitstream segment descriptor: a
+ * (byte offset from the aligned stream base, bit offset, bit length) triple.
+ * The hardware fetches on 16-byte granularity, so the bits inside the granule
+ * join the bit offset, which is what the vendor firmware programs for every
+ * segment it hands over. data_addr must be the address of the segment's first
+ * bit, not of the plane start.
+ */
+static inline void histb_vdec_seg_pack(u32 *words, dma_addr_t stream_base,
+				       dma_addr_t data_addr,
+				       unsigned int bit_offset,
+				       unsigned int bit_len)
+{
+	unsigned int bytes = (unsigned int)(data_addr - (stream_base & ~15u));
+
+	words[0] = bytes & ~15u;
+	words[1] = bit_offset + ((bytes & 15u) * 8u);
+	words[2] = bit_len;
+}
+
+/*
+ * Zero bits at the tail of a segment, counted from the end of the byte range
+ * backwards: whole zero bytes, then the zeros below the lowest set bit of the
+ * last non-zero byte (the stream is MSB-first, so the tail of the last byte is
+ * the last thing written). This is the same scan the vendor firmware runs over
+ * a segment before handing it to the engine; the '1' stop bit above those zeros
+ * belongs to the rbsp trailing too, so callers add one. The VDM counts every
+ * bit of a segment as macroblock layer, so a length that still covers the
+ * padding makes it report surplus bits at the end of the segment (measured on
+ * the board: one bit of padding in an interior slice is enough to set the error
+ * flag).
+ */
+static inline u32 histb_vdec_trail_zero_bits(const u8 *va, u32 end_bit)
+{
+	u32 bits = 0;
+	u32 byte = end_bit / 8;
+
+	if (!va)
+		return 0;
+	while (byte--) {
+		u8 value = va[byte];
+
+		if (value)
+			return bits + __ffs(value);
+		bits += 8;
+	}
+	return bits;
+}
+
+/* The VDM's tile geometry, kept internal; CAPTURE itself is linear. */
+
+/* Nominal OUTPUT (bitstream) plane size. */
+#define HISTB_VDEC_OUTPUT_SIZE_DEFAULT	(3 * 1024 * 1024)
+
+/* Message pool allocation size. */
+#define HISTB_VDEC_POOL_SIZE		(6 * 1024 * 1024)
+
+/*
+ * Layout of the per-protocol table area, as offsets from
+ * histb_vdec_msgpool::table_off. The CABAC M/N tables are constant and are
+ * programmed once at probe, the tile info image is zeroed there because no
+ * accepted picture uses it, and the remaining areas are filled per frame by the
+ * message assembly code. The scratch blocks follow in enum histb_vdec_scratch
+ * order, HISTB_VDEC_SCRATCH_SIZE bytes each.
+ */
+#define HISTB_TABLE_OFF_CABAC_MN_H264	0
+#define HISTB_TABLE_OFF_CABAC_MN_HEVC	5120
+#define HISTB_TABLE_OFF_TILE_INFO	6048
+#define HISTB_TABLE_OFF_PPFD		(HISTB_TABLE_OFF_TILE_INFO + \
+					 HISTB_VDEC_TILE_INFO_SIZE)
+#define HISTB_TABLE_OFF_SCRATCH_BASE	286720
+#define HISTB_TABLE_OFF_SCRATCH(i)	(HISTB_TABLE_OFF_SCRATCH_BASE + \
+					 (i) * HISTB_VDEC_SCRATCH_SIZE)
+
+#endif /* HISTB_VDEC_H */
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_h264.c b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_h264.c
new file mode 100644
index 000000000000..fb1d156975f5
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_h264.c
@@ -0,0 +1,1607 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon VDH v2 stateless H.264 decoder (Hi3716CV200, Hi3798MV100).
+ *
+ * One job decodes one frame: the picture slot of the message pool carries the
+ * frame-level state (POC, DPB address table, CABAC table pointer, quantisation
+ * matrix), followed by one chained slice slot per slice. Every slot word layout
+ * implemented here reproduces what the vendor firmware programs for the same
+ * syntax; where only a measurement on the board settles a choice, the numbers
+ * are in that comment. The frame storage model (APC/PMV tables, tile frame
+ * slots) comes from the same message assembly.
+ *
+ * Hardware facts worth keeping next to the code:
+ *
+ *  - The decoder consumes fully parsed syntax. It never reads slice
+ *    headers from the bitstream; the only bitstream it fetches is
+ *    slice_data(), addressed through a per-slice stream segment (byte
+ *    offset from the stream base on a 16-byte granule, bit offset within
+ *    the granule, valid bit length).
+ *  - That fetch is byte-literal: the VDM does not undo NAL emulation
+ *    prevention, so a span containing 00 00 03 decodes wrong from the first
+ *    escaped macroblock on. The uAPI delivers the escaped form, hence
+ *    histb_h264_pack_rbsp() copies the slice span with the prevention bytes
+ *    removed and re-bases the segment offsets onto the copy.
+ *  - Frame storage is table based: the picture message carries 16 frame
+ *    addresses (the APC table) plus two POC tables, and slice slots
+ *    reference frames by table index. This driver uses the capture
+ *    buffer index as the APC slot, so up to 16 capture buffers are
+ *    addressable.
+ *  - Motion vectors of reference frames persist in a private pool of 20
+ *    PMV slots, addressed independently of the frame table.
+ */
+
+#include <linux/bitops.h>
+#include <linux/dma-mapping.h>
+#include <media/v4l2-h264.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "histb_vdec_v2.h"
+
+/*
+ * Motion-vector slot size for the largest supported frame: 120 x 68
+ * macroblocks, 32 bytes per macroblock, 128-byte aligned. The top half of a
+ * slot holds one field's worth of motion vectors, the bottom half the other;
+ * field pictures reach the second half at an offset of half the slot size.
+ */
+/*
+ * The collocated bottom-field half of a PMV slot is deliberately not
+ * programmed: writing base + half the slot size there was measured on the board
+ * and changed nothing (10 of 50 pictures correct either way), so the engine
+ * does not take that slot for an MBAFF reference; see the slice-side comment
+ * for what is refused instead.
+ */
+#define HISTB_H264_PMV_SLOT_MIN		261120u
+
+/*
+ * The vendor firmware's per-macroblock PMV size: it picks 64 bytes per
+ * macroblock when the picture is at most 45 columns by 36 rows, or whenever the
+ * SPS clears direct_8x8_inference_flag, and 32 otherwise, then aligns the plane
+ * up to 128. Half of that plane is the offset the firmware adds to reach the
+ * second field's vectors. A picture larger than 45 x 36 macroblocks with
+ * direct_8x8_inference_flag clear needs twice what a 32-byte-per-macroblock
+ * calculation gives, so the pool has to be sized from this formula and not from
+ * the 32-byte one: the floor alone only covers it up to 720x576.
+ */
+static unsigned int histb_h264_pmv_per_mb(unsigned int width_mbs,
+					  unsigned int height_mbs,
+					  bool direct_8x8)
+{
+	if ((width_mbs <= 45 && height_mbs <= 36) || !direct_8x8)
+		return 64;
+
+	return 32;
+}
+
+/*
+ * The picture message carries a 16-entry frame address table, so capture buffer
+ * indexes double as APC slots up to this limit. dpb2apc[] uses
+ * HISTB_H264_APC_NONE for DPB entries that map to no slot.
+ *
+ * Both vendor fill loops stop at entry 15 -- each tests its index against 15
+ * before the tail of the address loop and of the POC pair loop -- and the words
+ * in between are spoken for: D10..D25 frame addresses, D26 the CABAC MN table,
+ * D27..D56 the paired POC table. Sizing this by the uAPI DPB (32) instead makes
+ * the address fill overlap D26 and the POC entries of every slot below 8, so
+ * the reference POCs a picture is given end up holding the current frame
+ * address.
+ */
+#define HISTB_H264_NUM_APC_SLOTS		16u
+#define HISTB_H264_APC_NONE			0xffu
+
+/*
+ * Hardware slice-type codes, indexed by slice_type % 5: P=1, B=2, I=0. This is
+ * the ordering the firmware's per-slice-type PMV table uses for H.264; the HEVC
+ * path orders it differently, so the table is not shared between the two. SP/SI
+ * have no entry of their own and fold onto the P and I codes.
+ */
+static u8 histb_h264_slice_type_code(u8 slice_type)
+{
+	static const u8 code[5] = { 1, 2, 0, 1, 0 };
+
+	return code[slice_type];
+}
+
+/*
+ * Picture-structure code for picture-message word D0 bits [15:14], indexed 2 *
+ * pic_structure + mbaff exactly as the firmware's own table is: 0 = frame, 1 =
+ * top field, 2 = bottom field, 3 = paired fields.
+ */
+static const u8 histb_h264_struct_trans[8] = { 0, 3, 1, 1, 2, 2, 3, 3 };
+
+/*
+ * Reference entry structure code for the slice declist nibble: the firmware
+ * table indexed 2 * struct + mbaff, of which only the frame-coded even indices
+ * are used here, masked to 2 bits.
+ */
+static const u8 histb_h264_list_struct_frame[8] = { 0, 1, 3, 3, 3, 3, 2, 2 };
+
+/* Per-frame assembly state shared by the picture and slice packers. */
+struct histb_h264_run {
+	const struct v4l2_ctrl_h264_sps *sps;
+	const struct v4l2_ctrl_h264_pps *pps;
+	const struct v4l2_ctrl_h264_decode_params *dec;
+	const struct v4l2_ctrl_h264_pred_weights *weights;
+	const struct v4l2_ctrl_h264_scaling_matrix *scaling;
+	const struct v4l2_ctrl_h264_slice_params *slices;
+	unsigned int		num_slices;
+	unsigned int		num_valid;
+	unsigned int		width_mbs;
+	unsigned int		height_mbs;
+	unsigned int		mbamt;
+	u32			tile_stride;
+	u32			buf_lines;
+	const u8		*src_va;
+	dma_addr_t		src_dma;
+	dma_addr_t		dst_dma;
+	u8			dpb2apc[V4L2_H264_NUM_DPB_ENTRIES];
+	u32			img_addr[HISTB_H264_NUM_APC_SLOTS];
+	s32			apc_poc[2][HISTB_H264_NUM_APC_SLOTS];
+	struct v4l2_h264_reference reflist_p[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference reflist_b0[V4L2_H264_REF_LIST_LEN];
+	struct v4l2_h264_reference reflist_b1[V4L2_H264_REF_LIST_LEN];
+	u32			slice_starts[HISTB_VDEC_MAX_SLICE_SLOTS];
+};
+
+struct histb_vdec_h264_ctx {
+	void		*pmv_va[HISTB_VDEC_MAX_PMV_SLOTS];
+	dma_addr_t	pmv_dma[HISTB_VDEC_MAX_PMV_SLOTS];
+	unsigned int	pmv_slot_size;
+	unsigned int	pmv_width_mbs;
+	unsigned int	pmv_height_mbs;
+	unsigned int	pmv_per_mb;
+	/*
+	 * Sticky for the lifetime of the reference chain: a picture has been
+	 * refused because its collocated motion vectors live in a PMV half this
+	 * driver cannot name, so every picture that still references it would
+	 * be delivered wrong. Cleared by an IDR.
+	 */
+	bool			col_half_lost;
+	void		*rbsp_va;
+	dma_addr_t	rbsp_dma;
+	unsigned int	rbsp_size;
+	/* per-job assembly state, kept out of the kernel stack */
+	struct histb_h264_run run;
+};
+
+static struct histb_vdec_dev *histb_vdec_h264_dev(struct histb_vdec_ctx *ctx)
+{
+	return video_get_drvdata(ctx->fh.vdev);
+}
+
+/*
+ * Tile frame geometry, taken from the firmware's frame-storage setup and
+ * confirmed on I_PCM pictures: the VDM writes 256-byte by 16-row tiles, so
+ * stride it is handed is a whole band and the chroma plane starts behind the
+ * luma bands plus the per-picture 1D area. histb_vdec_tile_stride() gives the
+ * tile-column count in bytes.
+ */
+static u32 histb_h264_tile_stride(unsigned int width)
+{
+	return histb_vdec_tile_stride(width);
+}
+
+static unsigned int histb_h264_ref_struct_code(u8 fields)
+{
+	switch (fields) {
+	case V4L2_H264_TOP_FIELD_REF:
+		return 1;
+	case V4L2_H264_BOTTOM_FIELD_REF:
+		return 2;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * Only B slices read collocated motion vectors: the firmware looks the slice
+ * type up in its per-slice-type PMV table and zeroes slot[8] and slot[9] for
+ * anything else.
+ */
+static bool histb_h264_has_b_slice(const struct histb_h264_run *run)
+{
+	unsigned int i;
+
+	for (i = 0; i < run->num_slices; i++)
+		if (run->slices[i].slice_type % 5 == V4L2_H264_SLICE_TYPE_B)
+			return true;
+
+	return false;
+}
+
+/*
+ * PMV slot allocator: capture buffer index -> PMV slot id. Slot ids are stored
+ * +1 so that a zeroed pmv_map[] means "unallocated"; ids wrap around the
+ * 20-slot pool.
+ */
+static u8 histb_h264_pmv_alloc(struct histb_vdec_ctx *ctx, unsigned int index)
+{
+	u8 id = ctx->pmv_map[index];
+
+	if (!id) {
+		id = ctx->pmv_next++ % HISTB_VDEC_MAX_PMV_SLOTS + 1;
+		ctx->pmv_map[index] = id;
+	}
+
+	return id - 1;
+}
+
+/*
+ * Start-code scan over the OUTPUT plane. Returns the bit position of every
+ * slice NAL unit (nal_unit_type 1 or 5, the only slice NALs the message ABI can
+ * describe; data partitions 2..4 are not supported). A 4-byte start code
+ * matches once: the extra leading zero byte never forms a 00 00 01 triple with
+ * the prefix. Returns the total number of slice NALs found (may exceed @max).
+ */
+static unsigned int histb_h264_find_slice_nals(const u8 *buf, u32 size,
+					       u32 *starts, unsigned int max)
+{
+	unsigned int n = 0;
+	u32 i;
+
+	for (i = 0; i + 3 < size; i++) {
+		u8 nal_type;
+
+		if (buf[i] || buf[i + 1] || buf[i + 2] != 0x01)
+			continue;
+
+		nal_type = buf[i + 3] & 0x1f;
+		if (nal_type != 1 && nal_type != 5)
+			continue;
+
+		if (n < max)
+			starts[n] = (i + 3) * 8;
+		n++;
+	}
+
+	return n;
+}
+
+/*
+ * Stream segment descriptor of a slice (slice slot words D0..D2). The VDM
+ * fetches the bitstream on 16-byte granules: word0 is the granule start as a
+ * byte offset from the programmed stream base (the OUTPUT plane address), word1
+ * the bit offset within that granule, word2 the number of valid bits. This is
+ * the vendor arithmetic: reduce the first data bit to a byte position, round
+ * that down to a granule for word0, and put in word1 the bit offset inside the
+ * granule the granule base already moved past.
+ */
+static void histb_h264_pack_segment(u32 *w, u32 data_bit, u32 valid_bits)
+{
+	w[0] = (data_bit / 8) & ~15u;
+	w[1] = data_bit & 127u;
+	w[2] = valid_bits;
+}
+
+static u32 histb_h264_scaling_word(const u8 *coeffs)
+{
+	return coeffs[0] | coeffs[1] << 8 | coeffs[2] << 16 | coeffs[3] << 24;
+}
+
+/*
+ * Quantisation matrix, picture slot words D63..D118. Vendor packing order: each
+ * scaling list in raster order, four coefficients per word, least significant
+ * byte first; six 4x4 lists followed by the two 8x8 luma lists the H.264
+ * protocol defines (V4L2 indices 0 and 1). Without a picture matrix the spec
+ * default of 16 per coefficient applies.
+ */
+static void histb_h264_pack_scaling(u32 *dst,
+				    const struct v4l2_ctrl_h264_scaling_matrix *m,
+				    bool present)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < 6; i++) {
+		for (j = 0; j < 4; j++)
+			*dst++ = present ?
+				 histb_h264_scaling_word(m->scaling_list_4x4[i] + 4 * j) :
+				 0x10101010u;
+	}
+
+	for (i = 0; i < 2; i++) {
+		for (j = 0; j < 16; j++)
+			*dst++ = present ?
+				 histb_h264_scaling_word(m->scaling_list_8x8[i] + 4 * j) :
+				 0x10101010u;
+	}
+}
+
+/*
+ * Prediction weight factors of one list (slice slot words W64.. for
+ * list 0, W96.. for list 1): luma and first chroma component pack as
+ * offset<<12 | weight<<3 | log2_denom, the second chroma component as
+ * weight<<9 | offset. Offsets are truncated to 8 bits and weights to 9
+ * bits exactly like the vendor packing loop, which places luma 0 and 64
+ * words later the two chroma components.
+ */
+static void histb_h264_pack_weights(u32 *slot,
+				    const struct v4l2_ctrl_h264_pred_weights *pw,
+				    unsigned int count, bool list1)
+{
+	const struct v4l2_h264_weight_factors *f = &pw->weight_factors[list1];
+	unsigned int base = list1 ? 96u : 64u;
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		slot[base + i] = ((u32)(u8)f->luma_offset[i] << 12) |
+				 ((u32)f->luma_weight[i] & 0x1ff) << 3 |
+				 (pw->luma_log2_weight_denom & 7);
+		slot[base + 64 + i] = ((u32)(u8)f->chroma_offset[i][0] << 12) |
+				      ((u32)f->chroma_weight[i][0] & 0x1ff) << 3 |
+				      (pw->chroma_log2_weight_denom & 7);
+		slot[base + 128 + i] = ((u32)f->chroma_weight[i][1] & 0x1ff) |
+				       ((u32)(u8)f->chroma_offset[i][1] << 9);
+	}
+}
+
+/*
+ * Reference list of one slice into the slice declist: 4 structure bits per
+ * entry (8 entries per word, words D12.. for list 0, D16.. for list 1) and a
+ * 5-bit APC slot id per entry (4 entries per word, D20.. and D28..), stored
+ * shifted by one like the vendor packer. Bit 0 carries no list identity:
+ * setting it on every list 1 entry leaves the output byte-identical.
+ */
+static void histb_h264_pack_declist(u32 *slot,
+				    const struct v4l2_h264_reference *list,
+				    unsigned int count, unsigned int distinct,
+				    const u8 *dpb2apc,
+				    const struct v4l2_ctrl_h264_decode_params *dec,
+				    bool list1)
+{
+	/*
+	 * List 0 takes the 4-bit structure nibbles at D12..D15 and the 5-bit
+	 * APC slot ids at D20..D27, list 1 the nibbles at D16..D19 and the ids
+	 * at D28..D35: the vendor fill loops start at D12/D20 for list 0 and at
+	 * D16/D28 for list 1. 32 entries at 4 bits are 4 words, at 5 bits with
+	 * four per word they are 8 words, so the two lists really are disjoint.
+	 */
+	unsigned int nib_word = list1 ? 16 : 12;
+	unsigned int apc_word = list1 ? 28 : 20;
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		/*
+		 * A slice may declare more entries than the list carries
+		 * pictures. The padded positions repeat the last picture the
+		 * list really carries: that is what the encoders that declare
+		 * the extra slot assume, measured by decoding the same content
+		 * with and without it (a weightp=2 x264 stream codes every
+		 * macroblock at its padded index and the software decode is
+		 * byte-identical to the same stream coded one index shorter).
+		 * Only the in-kernel list reaches this: an application's list
+		 * is used when no position of it is empty.
+		 */
+		const struct v4l2_h264_reference *ref =
+			&list[distinct ? min_t(unsigned int, i, distinct - 1) : 0];
+		unsigned int code = histb_h264_ref_struct_code(ref->fields);
+		const struct v4l2_h264_dpb_entry *dpb = &dec->dpb[ref->index];
+		u32 nib = histb_h264_list_struct_frame[2 * code] & 3;
+
+		if (code == 1)
+			nib |= 4;
+		/* declist entry field frame_is_long_term -> nibble bit 3 */
+		if (dpb->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)
+			nib |= 8;
+
+		slot[nib_word + (i >> 3)] |= nib << ((i & 7) * 4);
+		slot[apc_word + (i >> 2)] |=
+			((u32)dpb2apc[ref->index] << 1 & 0x1f) << ((i & 3) * 5);
+	}
+}
+
+/*
+ * Reverse map APC slot -> first reference list position (slice slot words
+ * D36..D43, 5 bits per entry); every field holds a list position.
+ *
+ * The firmware keys this map by 2 * apc + field parity and writes *both* halves
+ * with the same list position: its reference-index search walks all 16 slots
+ * unconditionally and stores the result at both 2i and 2i+1, the message then
+ * ships all 32 entries, and they are packed five bits at a time into D36..D43.
+ * A slot no list entry names keeps the memset zero, which is exactly the
+ * firmware default of "list position 0".
+ *
+ * Board-measured, and the reason this stays shaped like the firmware's rather
+ * than like the uAPI: with the key switched between bare apc (word D36 reads
+ * 0x00000020 for tx_m2) and 2 * apc + field (0x00008400) - both forms read
+ * back from the live message - the decoded pixels do not move at all, four
+ * frames each. The engine indexes references through the 5-bit list slots the
+ * macroblock layer carries, not through this map.
+ */
+static void histb_h264_pack_apc_ref_idx(u32 *slot,
+					const struct v4l2_h264_reference *list,
+					unsigned int count, const u8 *dpb2apc,
+					u32 *seen)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		unsigned int apc = dpb2apc[list[i].index];
+		unsigned int key;
+
+		if (*seen & BIT(apc))
+			continue;
+		*seen |= BIT(apc);
+		for (key = 2 * apc; key < 2 * apc + 2; key++)
+			slot[36 + (key >> 2)] |= (u32)i << ((key & 3) * 5);
+	}
+}
+
+static void histb_h264_assemble_pic(struct histb_vdec_dev *dev,
+				    const struct histb_vdec_h264_ctx *h264,
+				    const struct histb_h264_run *run,
+				    u8 cur_pmv_slot, u32 *pic)
+{
+	const struct v4l2_ctrl_h264_sps *sps = run->sps;
+	const struct v4l2_ctrl_h264_pps *pps = run->pps;
+	const struct v4l2_ctrl_h264_decode_params *dec = run->dec;
+	dma_addr_t tables = histb_vdec_tables_dma(&dev->pool);
+	bool mbaff = sps->flags & V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD;
+	bool field_pic = dec->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC;
+	u32 pic_struct = 0;
+	u32 chroma = 1;
+	u32 i;
+
+	memset(pic, 0, HISTB_VDEC_SLOT_BYTES);
+
+	if (field_pic)
+		pic_struct = (dec->flags &
+			      V4L2_H264_DECODE_PARAM_FLAG_BOTTOM_FIELD) ? 2 : 1;
+	if (V4L2_H264_SPS_HAS_CHROMA_FORMAT(sps))
+		chroma = sps->chroma_format_idc;
+
+	pic[0] = (run->width_mbs - 1) |
+		 ((u32)histb_h264_struct_trans[2 * pic_struct + mbaff] << 14) |
+		 ((run->height_mbs - 1) << 16) |
+		 ((chroma == 1 ? BIT(25) : 0)) |
+		 ((pps->flags & V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED) ? BIT(26) : 0) |
+		 ((pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) ? BIT(27) : 0) |
+		 ((pps->flags & V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE) ? BIT(28) : 0) |
+		 (dec->nal_ref_idc ? BIT(31) : 0);
+	/* current frame, 2D tile output */
+	pic[1] = lower_32_bits(run->dst_dma);
+	/*
+	 * Picture order count of the coded picture: a field uses its own count,
+	 * a PAFF frame picture uses the earlier of the two fields.
+	 */
+	if (field_pic && (dec->flags & V4L2_H264_DECODE_PARAM_FLAG_BOTTOM_FIELD))
+		pic[2] = (u32)dec->bottom_field_order_cnt;
+	else if (field_pic)
+		pic[2] = (u32)dec->top_field_order_cnt;
+	else
+		pic[2] = min_t(s32, dec->top_field_order_cnt,
+			       dec->bottom_field_order_cnt);
+	/* field POCs, MBAFF only */
+	pic[3] = mbaff ? (u32)dec->top_field_order_cnt : 0;
+	pic[4] = mbaff ? (u32)dec->bottom_field_order_cnt : 0;
+	/* band-line scratch buffers and the CABAC context table */
+	pic[5] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_SED_TOP));
+	pic[6] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_PMV_TOP));
+	pic[7] = lower_32_bits(h264->pmv_dma[cur_pmv_slot]);
+	pic[8] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_RCNTOP));
+	/* head of the slice chain */
+	pic[9] = lower_32_bits(histb_vdec_slice_slot_dma(&dev->pool, 0));
+	/* APC frame address table, then the paired top/bottom POC tables */
+	for (i = 0; i < HISTB_H264_NUM_APC_SLOTS; i++) {
+		pic[10 + i] = run->img_addr[i];
+		pic[27 + 2 * i] = (u32)run->apc_poc[0][i];
+		pic[28 + 2 * i] = (u32)run->apc_poc[1][i];
+	}
+	pic[26] = lower_32_bits(tables + HISTB_TABLE_OFF_CABAC_MN_H264);
+	pic[59] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_DBLK_TOP));
+
+	/*
+	 * The quantiser matrix burst starts at D64: the firmware copy loop
+	 * bases itself 252 bytes into the slot and stores through pointers that
+	 * step four bytes at a time, so the first word lands at byte 256 and
+	 * the 56th at byte 476.
+	 */
+	histb_h264_pack_scaling(&pic[64], run->scaling,
+				pps->flags & V4L2_H264_PPS_FLAG_SCALING_MATRIX_PRESENT);
+}
+
+/*
+ * End of the coded slice data inside the span handed to the hardware.
+ *
+ * Slice NAL units are separated by annex-b start codes in the OUTPUT buffer,
+ * and the last slice of an access unit runs into the start code of whichever
+ * NAL follows it in the stream, so a segment delimited by the next slice (or by
+ * bytesused) ends on bytes that are not slice data. Drop them: the pattern 00
+ * 00 01 cannot occur inside a NAL unit (emulation prevention rewrites any 00 00
+ * followed by 00 or 01), and it cannot be the tail of rbsp_trailing_bits
+ * either, because the last coded bit of a slice is end_of_slice_flag, a one.
+ */
+static u32 histb_h264_data_end_bit(const u8 *va, u32 end_bit)
+{
+	if (!va || end_bit < 24)
+		return end_bit;
+	if (!va[end_bit / 8 - 3] && !va[end_bit / 8 - 2] &&
+	    va[end_bit / 8 - 1] == 1)
+		return end_bit - 24;
+	return end_bit;
+}
+
+/*
+ * A reference list is only usable when every entry the slice actually reads
+ * names an active DPB entry: an application that leaves the arrays zeroed would
+ * otherwise be taken as "DPB entry 0, no fields".
+ */
+static bool histb_h264_ref_list_ok(const struct v4l2_h264_reference *list,
+				   unsigned int count,
+				   const struct v4l2_ctrl_h264_decode_params *dec)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		if (!(list[i].fields & V4L2_H264_FRAME_REF))
+			return false;
+		if (list[i].index >= V4L2_H264_NUM_DPB_ENTRIES)
+			return false;
+		if (!(dec->dpb[list[i].index].flags &
+		      V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			return false;
+	}
+
+	return true;
+}
+
+/*
+ * The reference lists a slice uses: the application's submitted lists when they
+ * name active DPB entries (only they can carry 8.2.4.3 reordering), otherwise
+ * the 8.2.4.2 initial construction prepared during run assembly. Returns true
+ * when the application's lists were taken.
+ */
+static bool histb_h264_slice_lists(const struct histb_h264_run *run,
+				   unsigned int index, unsigned int count0,
+				   unsigned int count1, bool is_b,
+				   const struct v4l2_h264_reference **pl0,
+				   const struct v4l2_h264_reference **pl1)
+{
+	const struct v4l2_ctrl_h264_slice_params *slice = &run->slices[index];
+
+	*pl0 = is_b ? run->reflist_b0 : run->reflist_p;
+	*pl1 = run->reflist_b1;
+	if (histb_h264_ref_list_ok(slice->ref_pic_list0, count0, run->dec) &&
+	    (!is_b || histb_h264_ref_list_ok(slice->ref_pic_list1, count1,
+					    run->dec))) {
+		*pl0 = slice->ref_pic_list0;
+		*pl1 = slice->ref_pic_list1;
+		return true;
+	}
+
+	return false;
+}
+
+static void histb_h264_assemble_slice(struct histb_vdec_dev *dev,
+				      struct histb_vdec_ctx *ctx,
+				      const struct histb_h264_run *run,
+				      const struct histb_vdec_h264_ctx *h264,
+				      unsigned int index,
+				      u32 nal_bit, u32 next_bit)
+{
+	const struct v4l2_ctrl_h264_slice_params *slice = &run->slices[index];
+	const struct v4l2_ctrl_h264_pps *pps = run->pps;
+	const struct v4l2_h264_reference *l0;
+	const struct v4l2_h264_reference *l1;
+	const struct v4l2_h264_reference *col;
+	u32 *slot = histb_vdec_slice_slot(&dev->pool, index);
+	unsigned int type = slice->slice_type % 5;
+	unsigned int last = run->num_slices - 1;
+	unsigned int count0 = 0, count1 = 0;
+	unsigned int distinct0 = 0, distinct1 = 0;
+	u32 seen = 0;
+	u32 data_bit = nal_bit + slice->header_bit_size;
+	bool is_b = type == V4L2_H264_SLICE_TYPE_B;
+	bool from_app;
+	bool weighted;
+	unsigned int wmode;
+	bool cabac;
+	u32 trail, valid;
+	u32 qp;
+
+	memset(slot, 0, HISTB_VDEC_SLOT_BYTES);
+
+	if (type != V4L2_H264_SLICE_TYPE_I && type != V4L2_H264_SLICE_TYPE_SI)
+		count0 = min_t(unsigned int,
+			       slice->num_ref_idx_l0_active_minus1 + 1,
+			       V4L2_H264_REF_LIST_LEN);
+	if (is_b)
+		count1 = min_t(unsigned int,
+			       slice->num_ref_idx_l1_active_minus1 + 1,
+			       V4L2_H264_REF_LIST_LEN);
+
+	/*
+	 * The uAPI hands the reference lists "after applying the per-slice
+	 * modifications" (include/uapi/linux/v4l2-controls.h), which no
+	 * in-kernel helper can know: 8.2.4.3 reordering is syntax, and x264
+	 * uses it in every B-pyramid encode.
+	 */
+	from_app = histb_h264_slice_lists(run, index, count0, count1, is_b,
+					 &l0, &l1);
+	/*
+	 * How many positions of the list carry a picture: the declist repeats
+	 * the last one over the rest. An application's list only gets used when
+	 * every position names an active DPB entry, so all of its positions
+	 * carry one - including a position that names the same picture as its
+	 * neighbour does, which 8.2.4.3 allows (a long-term and a short-term
+	 * entry can hold the same picture, and x264's weighted lists do exactly
+	 * that). Taking num_valid for the count here would clamp such a list
+	 * and hand every padded macroblock the picture after the one the slice
+	 * asked for. The in-kernel 8.2.4.2 list has no such marker: it fills
+	 * its tail with DPB entry 0, and only its first num_valid positions
+	 * carry a picture.
+	 */
+	if (count0) {
+		distinct0 = from_app ? count0 :
+			min_t(unsigned int, count0, run->num_valid);
+		if (!distinct0)
+			count0 = 0;
+	}
+	if (count1) {
+		distinct1 = from_app ? count1 :
+			min_t(unsigned int, count1, run->num_valid);
+		if (!distinct1)
+			count1 = 0;
+	}
+
+	/*
+	 * Collocated picture for direct prediction. 8.8.2 picks it by
+	 * ColFromL0Flag (List0[0] for a P slice or a spatial-direct B slice,
+	 * List1[1] - falling back to List1[0] - for a temporal-direct B slice),
+	 * but the vendor's live path addresses the collocated motion vectors
+	 * from `declist[1][0]` for every B slice whatever the direct type is,
+	 * and the board follows the vendor, not the spec: switching the choice
+	 * to `declist[1][0]` took the regression from 38 to 46 of 48 cases with
+	 * all frames byte-exact (the eight that turned were the spatial-direct
+	 * ones). On the one stream where the two readings differ by syntax
+	 * alone (a temporal-direct B slice declaring two list1 entries, corpus
+	 * arm bx_b3t), 8.8.2's refIdx=1 scored 7/12 where list1[0] scored 9/12,
+	 * and both of those leave the sibling arm bx_b3 (same lists, spatial
+	 * direct) at 2/12 until the spatial case moves to list1[0] too.
+	 */
+	col = l1;
+
+	/*
+	 * Slice data segment. The hardware never reads slice headers, so the
+	 * segment points behind the header bits. The second segment (words
+	 * D3..D5) stays clear: the frame arrives as one contiguous OUTPUT
+	 * buffer.
+	 *
+	 * CABAC decodes whole bytes, so its start moves up to the next byte
+	 * boundary, which is what the firmware does when it computes the slice
+	 * bit offset. Measured: an OpenH264 CABAC slice whose header ends at
+	 * bit 51 gives zero correct lines without the rounding and a byte-exact
+	 * frame with it, while that same 51-bit header under CAVLC is
+	 * byte-exact unrounded. CAVLC therefore keeps the exact bit position.
+	 *
+	 * The rbsp_trailing_bits padding at the end of a CAVLC slice is not
+	 * slice data: the firmware takes the length down to the last non-zero
+	 * bit and drops the stop bit with it. Leaving the padding in makes
+	 * every CAVLC picture come back with the up-message error flag and the
+	 * hardware status register's non-syntax error bit (bit18) set, and
+	 * moving the length one byte either way brings the flag straight back,
+	 * so the length must be exact, not merely long enough. Under CABAC that
+	 * subtraction is wrong on this hardware: it cost the 1920x1088 frame
+	 * its last macroblock row, so the padding stays in the length there.
+	 */
+	cabac = pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE;
+	if (cabac)
+		data_bit = (data_bit + 7) & ~7U;
+	/*
+	 * Neither the annex-b start code in front of the next slice (or of the
+	 * NAL that follows the access unit) nor the rbsp_trailing_bits padding
+	 * behind the last coded bit is slice data, and the length has to be
+	 * exact rather than merely long enough: measured by adding slack to the
+	 * declared end, one bit of padding in an interior slice segment is
+	 * enough to bring the error flag back, while a four-slice CAVLC picture
+	 * written with both removed is byte-exact and reports none. Under CABAC
+	 * the padding subtraction is wrong on this hardware: it cost the
+	 * 1920x1088 frame its last macroblock row, so the padding stays in the
+	 * length there.
+	 */
+	next_bit = histb_h264_data_end_bit(run->src_va, next_bit);
+	valid = next_bit - data_bit;
+	if (!cabac) {
+		trail = histb_vdec_trail_zero_bits(run->src_va, next_bit) + 1;
+		if (valid > trail)
+			valid -= trail;
+	}
+	histb_h264_pack_segment(&slot[0], data_bit, valid);
+
+	/* D6 carries the absolute slice QP, the spec's SliceQPy value. */
+	qp = clamp_t(int, 26 + pps->pic_init_qp_minus26 + slice->slice_qp_delta,
+		     0, 51);
+	slot[6] = (slice->first_mb_in_slice & 0xfffff) |
+		  ((qp & 63) << 26) |
+		  ((slice->cabac_init_idc & 3) << 24);
+	slot[7] = histb_h264_slice_type_code(type) |
+		  (count0 << 2) | (count1 << 8) |
+		  ((run->sps->flags & V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE) ?
+		   BIT(14) : 0) |
+		  ((slice->flags & V4L2_H264_SLICE_FLAG_DIRECT_SPATIAL_MV_PRED) ?
+		   BIT(15) : 0) |
+		  ((slice->num_ref_idx_l0_active_minus1 & 31) << 16) |
+		  ((slice->num_ref_idx_l1_active_minus1 & 31) << 21);
+
+	/*
+	 * Collocated motion-vector base address: the PMV slot of the collocated
+	 * picture chosen above. The firmware splits that slot between the two
+	 * fields and names both halves for a reference that is a field pair -
+	 * slot[8] = base, slot[9] = base + half the slot size - where its
+	 * frame-structure code 3 means a field pair, and MBAFF is a separate
+	 * flag that plays no part in PMV addressing. Measured here: naming the
+	 * second half for an MBAFF reference changes nothing (10 of 50 pictures
+	 * correct with slot[9] written and the same 10 without), so no engine
+	 * path reads it for that case, and the pictures that need a half this
+	 * driver cannot name are refused by run() instead of delivered.
+	 */
+	if (is_b && count0 + count1 > 0 &&
+	    run->dpb2apc[col[0].index] != HISTB_H264_APC_NONE)
+		slot[8] = lower_32_bits(h264->pmv_dma[histb_h264_pmv_alloc(ctx,
+					run->dpb2apc[col[0].index])]);
+
+	/*
+	 * Weighting mode: the firmware moves its per-slice weighting-mode byte
+	 * into D10 bits [17:16] unmasked, and that byte holds the PPS
+	 * weighted_bipred_idc for a B slice and the PPS weighted_pred_flag for
+	 * any other inter slice. The field is therefore a mode, and mode 2 --
+	 * implicit weighted prediction, 8.4.2.3 -- is one the hardware carries
+	 * out itself; only mode 1 has a pred_weight_table to hand down.
+	 *
+	 * V4L2_H264_CTRL_PRED_WEIGHTS_REQUIRED() compares slice_type against
+	 * the V4L2_H264_SLICE_TYPE_* enum, so it has to see the normalised
+	 * type: a bitstream may code a P slice as 5, and that still carries a
+	 * pred_weight_table().
+	 */
+	if (is_b)
+		wmode = pps->weighted_bipred_idc & 3;
+	else
+		wmode = ((pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) &&
+			 (type == V4L2_H264_SLICE_TYPE_P ||
+			  type == V4L2_H264_SLICE_TYPE_SP)) ? 1 : 0;
+	weighted = wmode == 1;
+	slot[10] = (((u32)pps->chroma_qp_index_offset & 31) << 5) |
+		   ((u32)pps->second_chroma_qp_index_offset & 31) |
+		   (wmode << 16);
+	slot[11] = (((u32)slice->slice_alpha_c0_offset_div2 & 15) << 16) |
+		   (((u32)slice->slice_beta_offset_div2 & 15) << 8) |
+		   (slice->disable_deblocking_filter_idc & 0xff);
+
+	histb_h264_pack_declist(slot, l0, count0, distinct0, run->dpb2apc,
+				run->dec, false);
+	histb_h264_pack_declist(slot, l1, count1, distinct1, run->dpb2apc,
+				run->dec, true);
+	histb_h264_pack_apc_ref_idx(slot, l0, distinct0, run->dpb2apc, &seen);
+	histb_h264_pack_apc_ref_idx(slot, l1, distinct1, run->dpb2apc, &seen);
+
+	/*
+	 * Slice chain words. D44 is a macroblock index: the firmware's caller
+	 * passes the next slice's first_mb_in_slice minus one, or the picture's
+	 * MB count minus one on the last slice. D63 takes the successor slot
+	 * address on every slice -- the store sits in a tail reached by both
+	 * branches of the slice loop, so no slot ever leaves a null link. No
+	 * counter bounds the chain, so a run ends when the chain reaches a slot
+	 * with an empty segment; run() therefore clears the slot after the last
+	 * one.
+	 */
+	slot[44] = index < last ? run->slices[index + 1].first_mb_in_slice - 1 :
+				  run->mbamt - 1;
+	slot[63] = lower_32_bits(histb_vdec_slice_slot_dma(&dev->pool,
+							   index + 1));
+
+	if (weighted) {
+		histb_h264_pack_weights(slot, run->weights, count0, false);
+		if (is_b)
+			histb_h264_pack_weights(slot, run->weights, count1, true);
+	}
+}
+
+static void histb_h264_program_regs(struct histb_vdec_dev *dev,
+				    const struct histb_h264_run *run)
+{
+	unsigned int lines = run->buf_lines;
+	unsigned int i;
+
+	/* decoded macroblock budget: the field counts MBs minus one */
+	/*
+	 * The firmware's CFG0 build ends by setting bit 30 (the
+	 * quantiser-matrix load) and bit 24 (the coefficient-index detect) on
+	 * byte 3 of the word, and by clearing bit 23 and bit 25. Without bit 24
+	 * the VDM reconstructs intra prediction but drops every coefficient.
+	 */
+	vdm_write(dev, VDM_CFG0, ((run->mbamt - 1) & VDM_CFG0_MBAMT) |
+				  VDM_CFG0_COEFIDX_DETECT | VDM_CFG0_LD_QMATRIX);
+	/*
+	 * The firmware's CFG1 build also sets VDM_CFG1_MAX_SLCGRP_NUM to 1,
+	 * keeps a single slice group for every picture (VDM_CFG1_FST_SLC_GRP
+	 * carries the picture's "new picture" byte, which is true for each
+	 * frame a stateless decoder is handed) and leaves the deblocker in 1D
+	 * mode.
+	 */
+	vdm_write(dev, VDM_CFG1, FIELD_PREP(VDM_CFG1_VID_STD, HISTB_VIDSTD_H264) |
+		  FIELD_PREP(VDM_CFG1_DDR_STRIDE, run->tile_stride >> 6) |
+		  FIELD_PREP(VDM_CFG1_MAX_SLCGRP_NUM, 1) |
+		  VDM_CFG1_FST_SLC_GRP | VDM_CFG1_DBLK_1D_EN);
+	vdm_write(dev, VDM_AVM_ADDR,
+		  lower_32_bits(histb_vdec_pic_slot_dma(&dev->pool)));
+	vdm_write(dev, VDM_VAM_ADDR,
+		  lower_32_bits(histb_vdec_up_msgs_dma(&dev->pool)));
+	vdm_write(dev, VDM_STREAM_BASE, lower_32_bits(run->src_dma));
+
+	/* one timeout per pipeline stage, windows 0x3c..0x54 only */
+	for (i = 1; i <= 7; i++)
+		vdm_write(dev, VDM_TO(i), VDM_TIMEOUT_MOD);
+	vdm_write(dev, VDM_PPFD_BUF_ADDR,
+		  (histb_vdec_tables_dma(&dev->pool) +
+		   HISTB_TABLE_OFF_PPFD) & ~15u);
+	vdm_write(dev, VDM_PPFD_BUF_LEN, HISTB_VDEC_PPFD_SIZE / 64 - 1);
+	/*
+	 * FF_APT_EN takes histb_h264_struct_trans[2 * pic_structure + mb_aff];
+	 * the firmware maps that table entry to 2 only for the frame structure
+	 * code, and to 0 for every other one. Field and MBAFF pictures stay at
+	 * 0 until they are supported.
+	 */
+	vdm_write(dev, VDM_FF_APT_EN,
+		  !(run->dec->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC) &&
+		  !(run->sps->flags & V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD) ?
+		  2 : 0);
+
+	vdm_write(dev, VDM_YSTADDR_1D, lower_32_bits(run->dst_dma));
+	/*
+	 * The 1D path writes 256x16-byte tiles, so the stride it is given is
+	 * the pitch of a whole 16-row band, not of a picture line: the firmware
+	 * puts its decoded-picture stride there and computes the chroma offset
+	 * as two bands' worth of that stride plus the 1D area. Measured on the
+	 * board: with the picture-line stride here, band b+1 landed exactly on
+	 * band b's rows 3..15, so only the first three lines of every 16-row
+	 * band survived and the frame looked "truncated at 8-20%".
+	 */
+	vdm_write(dev, VDM_YSTRIDE_1D, histb_vdec_band_bytes(run->tile_stride));
+	vdm_write(dev, VDM_UVOFFSET_1D,
+		  histb_vdec_luma_bytes(run->tile_stride, lines) +
+		  histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_HEAD_INF_OFFSET, histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_INT_STATE, 0xffffffffu);
+	vdm_write(dev, VDM_INT_MASK, 0xfffffffeu);
+	/*
+	 * Per-slot picture-type flags; frame pictures need none and field
+	 * coding is not modelled yet. TODO: field coding needs per-reference
+	 * field flags that no control carries.
+	 */
+	vdm_write(dev, VDM_REF_PIC_TYPE, 0);
+}
+
+static int histb_vdec_h264_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	const struct v4l2_ctrl_h264_sps *sps;
+
+	if (ctrl->id != V4L2_CID_STATELESS_H264_SPS)
+		return 0;
+
+	sps = ctrl->p_new.p_h264_sps;
+
+	/*
+	 * The VDM reconstructs NV21 16x16 tiles: 8-bit 4:2:0 only. The chroma
+	 * format and bit depth fields only exist for the high profiles
+	 * (V4L2_H264_SPS_HAS_CHROMA_FORMAT); baseline and main streams are
+	 * 4:2:0 8-bit by definition.
+	 *
+	 * The geometry is not checked here: the control handler holds an
+	 * all-zero default, which TRY_EXT_CTRLS (v4l2-compliance) reads back as
+	 * if a client had set it, and a picture size cannot be judged before
+	 * one is actually submitted. histb_vdec_h264_run() refuses the job
+	 * instead.
+	 */
+	if (V4L2_H264_SPS_HAS_CHROMA_FORMAT(sps) &&
+	    (sps->chroma_format_idc != 1 ||
+	     (sps->flags & V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE) ||
+	     sps->bit_depth_luma_minus8 || sps->bit_depth_chroma_minus8))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int histb_vdec_h264_start(struct histb_vdec_ctx *ctx)
+{
+	struct histb_vdec_h264_ctx *h264;
+
+	h264 = kzalloc_obj(*h264);
+	if (!h264)
+		return -ENOMEM;
+
+	/*
+	 * The CABAC table is resident in the device-wide message pool; the PMV
+	 * pool grows on demand in run(), once the SPS fixes the frame geometry.
+	 */
+	ctx->priv = h264;
+
+	return 0;
+}
+
+/*
+ * Make sure the PMV pool slots hold the active frame. The vendor slot is 32
+ * bytes per macroblock, at least one 1080p-frame slot; growing drops the slot
+ * map, which is harmless at a resolution change.
+ *
+ * The pool is one dma_alloc_wc() per slot: 20 slots at the 1080p floor is a 5.0
+ * MB (order-11, 8 MB aligned) request, and the board refuses that against its
+ * 16 MB CMA region even with 9.9 MB free, which came back as -ENOMEM on every
+ * job.
+ */
+static void histb_h264_pmv_free(struct histb_vdec_dev *dev,
+				struct histb_vdec_h264_ctx *h264)
+{
+	int i;
+
+	for (i = 0; i < HISTB_VDEC_MAX_PMV_SLOTS; i++) {
+		if (!h264->pmv_va[i])
+			continue;
+		dma_free_wc(dev->memdev, h264->pmv_slot_size, h264->pmv_va[i],
+			    h264->pmv_dma[i]);
+		h264->pmv_va[i] = NULL;
+	}
+	h264->pmv_slot_size = 0;
+	h264->pmv_width_mbs = 0;
+	h264->pmv_height_mbs = 0;
+	h264->pmv_per_mb = 0;
+}
+
+/*
+ * Whether this submission discards every stored picture, which is what makes
+ * rebuilding the pool here lose nothing: an IDR starts a new reference chain
+ * and the uAPI hands it with no DPB entry still flagged VALID or ACTIVE. HEVC
+ * has no such per-entry flag (only V4L2_HEVC_DPB_ENTRY_LONG_TERM_REFERENCE),
+ * which is why the same relax is not available there.
+ */
+static bool histb_h264_pmv_flush(const struct v4l2_ctrl_h264_decode_params *dec)
+{
+	unsigned int i;
+
+	if (!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_IDR_PIC))
+		return false;
+
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++)
+		if (dec->dpb[i].flags & (V4L2_H264_DPB_ENTRY_FLAG_VALID |
+					 V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			return false;
+
+	return true;
+}
+
+static int histb_h264_pmv_grow(struct histb_vdec_ctx *ctx,
+			       unsigned int width_mbs,
+			       unsigned int height_mbs,
+			       bool direct_8x8,
+			       bool flush)
+{
+	struct histb_vdec_dev *dev = histb_vdec_h264_dev(ctx);
+	struct histb_vdec_h264_ctx *h264 = ctx->priv;
+	unsigned int per_mb = histb_h264_pmv_per_mb(width_mbs, height_mbs,
+						    direct_8x8);
+	unsigned int len = ALIGN(width_mbs * height_mbs * per_mb, 128);
+	unsigned int slot = ALIGN(width_mbs * height_mbs * 32, 128);
+	int i;
+
+	slot = max3(slot, len, HISTB_H264_PMV_SLOT_MIN);
+	if (h264->pmv_slot_size) {
+		/*
+		 * The allocation size alone cannot say the pool still fits: two
+		 * geometries reach the same number wherever the
+		 * HISTB_H264_PMV_SLOT_MIN floor flattens them, so the grid and
+		 * the bytes per macroblock the engine strides by have to match
+		 * as well before the pool is kept.
+		 */
+		if (h264->pmv_slot_size == slot &&
+		    h264->pmv_width_mbs == width_mbs &&
+		    h264->pmv_height_mbs == height_mbs &&
+		    h264->pmv_per_mb == per_mb)
+			return 0;
+		/*
+		 * Reaching here with a pool already built means the SPS changed
+		 * mid-session. Rebuild it only where this submission flushes
+		 * the reference chain: freeing the pool wipes the motion
+		 * vectors of every picture a later job can still name, so the
+		 * grid and the bytes per macroblock may both move together with
+		 * it, but only at that point. A change inside a live chain
+		 * stays refused - the pool, its slot map and the collocated
+		 * read target would then follow two different geometries, and
+		 * no source-change event tells the client. Restarting the
+		 * queues runs ->stop() and zeroes pmv_slot_size. Where the
+		 * payload lands is not the reason: with the tile geometry
+		 * programmed from the negotiated rectangle a smaller picture
+		 * still fills that rectangle exactly (measured: pictures on a
+		 * smaller grid inside a larger session)
+		 */
+		if (!flush)
+			return -EINVAL;
+	}
+
+	histb_h264_pmv_free(dev, h264);
+
+	for (i = 0; i < HISTB_VDEC_MAX_PMV_SLOTS; i++) {
+		h264->pmv_va[i] = dma_alloc_wc(dev->memdev, slot,
+					       &h264->pmv_dma[i], GFP_KERNEL);
+		if (!h264->pmv_va[i])
+			break;
+	}
+	if (i < HISTB_VDEC_MAX_PMV_SLOTS) {
+		histb_h264_pmv_free(dev, h264);
+		return -ENOMEM;
+	}
+	h264->pmv_slot_size = slot;
+	h264->pmv_width_mbs = width_mbs;
+	h264->pmv_height_mbs = height_mbs;
+	h264->pmv_per_mb = per_mb;
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+
+	return 0;
+}
+
+static void histb_vdec_h264_stop(struct histb_vdec_ctx *ctx)
+{
+	struct histb_vdec_dev *dev = histb_vdec_h264_dev(ctx);
+	struct histb_vdec_h264_ctx *h264 = ctx->priv;
+
+	if (!h264)
+		return;
+
+	histb_h264_pmv_free(dev, h264);
+	if (h264->rbsp_va)
+		dma_free_wc(dev->memdev, h264->rbsp_size, h264->rbsp_va,
+			    h264->rbsp_dma);
+	kfree(h264);
+	ctx->priv = NULL;
+
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+}
+
+/*
+ * Hand the engine the slice span without its emulation-prevention bytes.
+ *
+ * The VDM decodes the bytes it is given literally: measured with a picture
+ * whose samples contain 00 00 00, the conformant Annex-B form
+ * (four 03 bytes inserted in the slice data) lands 31 of 4096 luma lines, while
+ * the same RBSP written without prevention bytes is byte-exact and reports no
+ * error. The uAPI delivers the escaped form for both start-code modes
+ * (ext-ctrls-codec-stateless.rst: V4L2_STATELESS_H264_START_CODE_*), so
+ * removing them is the driver's job, not the encoder's.
+ *
+ * The copy starts at the first slice's NAL header byte and the slice offsets
+ * are rewritten into its own domain; the OUTPUT plane is left untouched. When
+ * the span holds no prevention byte the plane is used as is, so the common case
+ * pays no copy.
+ */
+static int histb_h264_pack_rbsp(struct histb_vdec_ctx *ctx,
+				struct histb_h264_run *run,
+				unsigned int *payload_bits)
+{
+	struct histb_vdec_dev *dev = histb_vdec_h264_dev(ctx);
+	struct histb_vdec_h264_ctx *h264 = ctx->priv;
+	unsigned int first = run->slice_starts[0] / 8;
+	unsigned int end = *payload_bits / 8;
+	unsigned int esc_next = first;
+	unsigned int out = 0, idx = 0, zeros = 0;
+	unsigned int i;
+	u8 *dst;
+
+	if (!run->src_va || first >= end)
+		return 0;
+
+	for (i = first; i + 2 < end; i++) {
+		if (!run->src_va[i] && !run->src_va[i + 1] &&
+		    run->src_va[i + 2] == 0x03)
+			break;
+	}
+	if (i + 2 >= end)
+		return 0;
+
+	if (h264->rbsp_size < end - first) {
+		if (h264->rbsp_va)
+			dma_free_wc(dev->memdev, h264->rbsp_size, h264->rbsp_va,
+				    h264->rbsp_dma);
+		h264->rbsp_size = 0;
+		h264->rbsp_va = dma_alloc_wc(dev->memdev,
+					     round_up(end - first, 64 * 1024),
+					     &h264->rbsp_dma, GFP_KERNEL);
+		if (!h264->rbsp_va)
+			return -ENOMEM;
+		h264->rbsp_size = round_up(end - first, 64 * 1024);
+	}
+	dst = h264->rbsp_va;
+
+	for (i = first; i < end; i++) {
+		u8 byte = run->src_va[i];
+
+		if (i == esc_next) {
+			esc_next = idx + 1 < run->num_slices ?
+				run->slice_starts[idx + 1] / 8 : end;
+			run->slice_starts[idx++] = out * 8;
+			zeros = 0;
+		}
+		if (zeros >= 2 && byte == 0x03) {
+			zeros = 0;
+			continue;
+		}
+		dst[out++] = byte;
+		zeros = byte ? 0 : zeros + 1;
+	}
+
+	*payload_bits = out * 8;
+	run->src_va = dst;
+	run->src_dma = h264->rbsp_dma;
+	return 0;
+}
+
+/*
+ * True when every coefficient the picture message carries is one repeated value
+ * per list (the six 4x4 lists plus the two luma 8x8 lists the 4:2:0 path uses;
+ * the remaining rows of scaling_list_8x8 are never packed) and the three intra
+ * 4x4 lists share that value. Only this shape has been measured to decode
+ * byte-exactly: with the intra lists equal to each other, an inter 4x4 or 8x8
+ * list carrying a different value still matched the reference, while any stream
+ * whose intra lists differed from each other did not.
+ */
+static bool histb_h264_scaling_supported(const struct v4l2_ctrl_h264_scaling_matrix *m)
+{
+	u8 v = m->scaling_list_4x4[0][0];
+	unsigned int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(m->scaling_list_4x4); i++)
+		for (j = 0; j < ARRAY_SIZE(m->scaling_list_4x4[i]); j++) {
+			if (m->scaling_list_4x4[i][j] != m->scaling_list_4x4[i][0])
+				return false;
+			if (i < 3 && m->scaling_list_4x4[i][0] != v)
+				return false;
+		}
+
+	for (i = 0; i < 2; i++)
+		for (j = 1; j < ARRAY_SIZE(m->scaling_list_8x8[i]); j++)
+			if (m->scaling_list_8x8[i][j] != m->scaling_list_8x8[i][0])
+				return false;
+
+	return true;
+}
+
+static int histb_vdec_h264_run(struct histb_vdec_ctx *ctx,
+			       struct vb2_v4l2_buffer *src,
+			       struct vb2_v4l2_buffer *dst)
+{
+	struct histb_vdec_dev *dev = histb_vdec_h264_dev(ctx);
+	struct histb_vdec_h264_ctx *h264 = ctx->priv;
+	struct v4l2_h264_reflist_builder builder;
+	struct histb_h264_run *run = &h264->run;
+	struct v4l2_ctrl *ctrl;
+	unsigned int cap_w, cap_h;
+	int ret;
+
+	memset(run, 0, sizeof(*run));
+	struct vb2_queue *cap_q;
+	u32 *pic;
+	u32 payload_bits;
+	unsigned int n_slices, found;
+	unsigned long start_code;
+	unsigned int i;
+
+	/*
+	 * The driver core has applied the request to the control handler before
+	 * scheduling this job, so p_cur carries this frame's values.
+	 */
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_H264_SPS);
+	run->sps = ctrl ? ctrl->p_cur.p_h264_sps : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_H264_PPS);
+	run->pps = ctrl ? ctrl->p_cur.p_h264_pps : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_H264_DECODE_PARAMS);
+	run->dec = ctrl ? ctrl->p_cur.p_h264_decode_params : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_H264_PRED_WEIGHTS);
+	run->weights = ctrl ? ctrl->p_cur.p_h264_pred_weights : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_H264_SCALING_MATRIX);
+	run->scaling = ctrl ? ctrl->p_cur.p_h264_scaling_matrix : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_H264_SLICE_PARAMS);
+	run->slices = ctrl ? ctrl->p_cur.p_h264_slice_params : NULL;
+	n_slices = ctrl ? ctrl->new_elems : 0;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_H264_START_CODE);
+	start_code = ctrl ? ctrl->cur.val : V4L2_STATELESS_H264_START_CODE_ANNEX_B;
+
+	/*
+	 * Every word of the picture message comes from these controls: the
+	 * frame-level state (size, POC, DPB addresses, CABAC table) has no
+	 * other source, and the slice chain is built from the slice-parameter
+	 * array. A missing or empty control therefore leaves words unwritable
+	 * rather than guessed at, so the job is refused before anything is
+	 * programmed.
+	 */
+	if (!run->sps || !run->pps || !run->dec || !run->slices || !n_slices)
+		return -EINVAL;
+
+	/*
+	 * One hardware run consumes one chained slice slot per slice and the
+	 * chain is capped by the message pool layout; longer frames would need
+	 * the vendor multi-start split, which does not fit the
+	 * one-frame-per-job stateless model. One slot is left over because the
+	 * chain has to end on a zeroed slot, not on the last real one.
+	 */
+	if (n_slices >= HISTB_VDEC_MAX_SLICE_SLOTS)
+		return -EINVAL;
+
+	payload_bits = vb2_get_plane_payload(&src->vb2_buf, 0) * 8;
+	/*
+	 * A zero-length submission carries no slice data at all. Each slice is
+	 * addressed through a segment descriptor whose bit length is part of
+	 * the word, so there is nothing for those words to point at and the job
+	 * cannot be programmed in this state.
+	 */
+	if (!payload_bits)
+		return -EINVAL;
+	run->src_dma = histb_vdec_src_dma(&src->vb2_buf);
+	run->dst_dma = histb_vdec_frame_dma(ctx, &dst->vb2_buf);
+	if (!run->dst_dma)
+		return -ENOMEM;
+	run->num_slices = n_slices;
+
+	run->src_va = histb_vdec_src_va(&src->vb2_buf);
+	if (start_code == V4L2_STATELESS_H264_START_CODE_ANNEX_B) {
+		/*
+		 * Locating slices in Annex-B mode reads the OUTPUT plane
+		 * through the kernel mapping: histb_h264_find_slice_nals()
+		 * walks it byte by byte and the slice segments are taken from
+		 * where it finds each NAL. The source queue carries a kernel
+		 * mapping for this reason (its dma_attrs omit
+		 * DMA_ATTR_NO_KERNEL_MAPPING, see histb_vdec_queue_init()), so
+		 * a NULL here means the mapping came back unavailable and no
+		 * slice boundary is known; the job is refused rather than
+		 * programmed from offsets nothing verified.
+		 */
+		if (!run->src_va) {
+			dev_warn_once(dev->dev,
+				      "OUTPUT queue has no kernel mapping, cannot delimit "
+				      "slices\n");
+			return -EINVAL;
+		}
+		found = histb_h264_find_slice_nals(run->src_va,
+						   payload_bits / 8,
+						   run->slice_starts,
+						   ARRAY_SIZE(run->slice_starts));
+		/*
+		 * The scan must find exactly one NAL per slice the control
+		 * declares. Each declared slice gets one chained slice slot,
+		 * addressed by the start found here, so a different count would
+		 * mean programming slots from spans the control does not
+		 * describe.
+		 */
+		if (found != n_slices)
+			return -EINVAL;
+	} else {
+		/*
+		 * Without start codes the slices in the OUTPUT buffer cannot be
+		 * delimited, so a single-slice submission is the only layout
+		 * the driver can consume. Start codes are never part of the
+		 * hardware ABI either way: every slice segment is computed from
+		 * the slice's data bit offset, which for frame-based
+		 * submissions already includes the NAL unit header bits.
+		 */
+		if (n_slices != 1)
+			return -EINVAL;
+		run->slice_starts[0] = 0;
+	}
+
+	ret = histb_h264_pack_rbsp(ctx, run, &payload_bits);
+	if (ret)
+		return ret;
+
+	/*
+	 * Slice-group partitioning (FMO/ASO) and redundant coded pictures both
+	 * move where a slice's data starts, and neither survives this API: the
+	 * PPS has a slice-group count but no map, and the per-slice
+	 * redundant_pic_cnt is read by nothing here - the VDM is programmed one
+	 * raster-slice per submission and would present a secondary copy as a
+	 * picture of its own. The vendor parser rejects both shapes, a baseline
+	 * stream with FMO and a redundant picture, so this costs nothing the
+	 * hardware could deliver. No stream in the scored corpus declares
+	 * either field. Which neighbouring parameter-set features the API can
+	 * even see are named where they are consumed: the SPS and PPS flag
+	 * words above, and the scaling-matrix control.
+	 */
+	if (run->pps->num_slice_groups_minus1 ||
+	    (run->pps->flags & V4L2_H264_PPS_FLAG_REDUNDANT_PIC_CNT_PRESENT))
+		return -EINVAL;
+
+	/*
+	 * Quantisation matrices do arrive here, and the VDM consumes the words:
+	 * submitting them zeroed instead of decoded changes the picture in a
+	 * different way. But the engine does not apply the intra 4x4 lists as
+	 * the protocol says. Measured on the board, a stream whose three intra
+	 * 4x4 lists differ from each other delivers 68487 of 115200 samples off
+	 * by up to 58, spread over every macroblock row, while one whose intra
+	 * lists agree decodes byte-exactly even when an inter 4x4 or 8x8 list
+	 * carries a different value - and no reordering of the eight lists, nor
+	 * reading the 8x8 slots, nor a scan-order submission explains where the
+	 * intra ones go (all three measured on the board). Finding that out
+	 * needs the vendor's intra inverse-quantiser arithmetic, which is not a
+	 * lightweight bypass, so until it is known only the shapes measured
+	 * correct are accepted, and a present flag with no list control behind
+	 * it carries no values to check either way. No stream in the scored
+	 * corpus declares matrices - the parameter-set walk and the reference
+	 * decoder's own header trace agree on that - so this costs no frame
+	 * that decodes byte-exactly today.
+	 */
+	if (run->pps->flags & V4L2_H264_PPS_FLAG_SCALING_MATRIX_PRESENT) {
+		if (!run->scaling ||
+		    !histb_h264_scaling_supported(run->scaling))
+			return -EINVAL;
+	}
+
+	/*
+	 * Lossless streams are visible here - the SPS control carries
+	 * V4L2_H264_SPS_FLAG_QPPRIME_Y_ZERO_TRANSFORM_BYPASS - but the VDM has
+	 * no bypass path: measured on the board, a stream with the flag set
+	 * (x264 -qp 0, which picks profile 244) delivers 0 of 115200 samples
+	 * right in every frame, while the same clip at qp 4 without the flag
+	 * decodes byte-exactly, so the deviation is the bypass itself and not
+	 * the profile or the encoder. The vendor firmware's own H.264 syntax
+	 * parser reports that same SPS bit as unsupported. No stream in the
+	 * scored corpus sets it, and nothing in this driver can implement it:
+	 * the inverse transform would have to be skipped per macroblock.
+	 */
+	if (run->sps->flags & V4L2_H264_SPS_FLAG_QPPRIME_Y_ZERO_TRANSFORM_BYPASS)
+		return -EINVAL;
+
+	run->width_mbs = run->sps->pic_width_in_mbs_minus1 + 1;
+	run->height_mbs = (run->sps->pic_height_in_map_units_minus1 + 1) *
+			 ((run->sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) ?
+			  1u : 2u);
+
+	/*
+	 * The luma write path needs two macroblock columns per row: a picture
+	 * declared one MB wide delivers wrong luma whatever its slice data is
+	 * (a 32-wide stream declared as one column reproduces the 16x16 failure
+	 * down to the write counters, and that same 16x16 stream declared as
+	 * two columns decodes byte-exactly), so 16-column pictures cannot be
+	 * delivered at all. Cropping does not help - the coded count is what
+	 * the engine writes by. The picture message D0 budgets 9 bits of MB
+	 * width and 10 of MB height.
+	 */
+	if (run->width_mbs < 2 ||
+	    run->width_mbs * 16 > HISTB_VDEC_MAX_WIDTH ||
+	    run->height_mbs * 16 > HISTB_VDEC_MAX_HEIGHT)
+		return -EINVAL;
+	run->mbamt = run->width_mbs * run->height_mbs;
+
+	/* The VDM writes full frames into the queued CAPTURE slots; a stream
+	 * larger than the negotiated geometry could not be held.
+	 */
+	ret = histb_vdec_cap_dims(ctx, &cap_w, &cap_h);
+	if (ret)
+		return ret;
+	if (run->width_mbs * 16 > cap_w || run->height_mbs * 16 > cap_h)
+		return -EINVAL;
+
+	/*
+	 * The band layout the engine is told to use is the one the CAPTURE
+	 * format reported, not the coded picture's own: the negotiated
+	 * rectangle may be larger, and a client addressing the buffer per
+	 * bytesperline has to find the payload there.
+	 */
+	histb_vdec_buf_geom(ctx, &run->tile_stride, &run->buf_lines);
+
+	/*
+	 * Collocated motion vectors live in the two halves of a PMV slot, and
+	 * the firmware names those halves per *frame store* (one address
+	 * selection per stored picture) while this API hands each field
+	 * picture its own DPB entry and capture buffer. So the half a B slice
+	 * needs cannot be named here, and a picture whose direct
+	 * prediction depends on it is refused rather than delivered:
+	 *  - a field picture with B slices;
+	 * - an MBAFF frame with B slices. Writing slot[9] = base + half for
+	 *   such a
+	 *    reference changed nothing on the board (10 of 50 pictures correct with
+	 *    and without it), so that is not the missing piece either.
+	 * Nothing else reads the collocated vectors - the firmware zeroes
+	 * slot[8]/slot[9] for every other slice type, by the same slice-type
+	 * table as histb_h264_slice_type_code() - so progressive pictures and
+	 * MBAFF without B slices keep decoding byte-exactly (both 50 of 50 on
+	 * the corpus).
+	 *
+	 * One known residual is deliberately left un-gated. On a spatial-direct
+	 * B slice whose collocated picture is a single-direction (P) picture,
+	 * the engine averages both lists where 8.4.1.1 asks for the co-located
+	 * macroblock's own motion: measured on the board, the 384 samples of
+	 * macroblock (0,0) of one B frame are all off, up to 76, with the
+	 * deblocking across that macroblock's edge spreading it to its
+	 * neighbours, while every other frame of the same stream is byte-exact.
+	 * No cheap predicate separates that frame from the ones that are right:
+	 * direct_8x8_inference_flag is set in every B-bearing case in the
+	 * corpus (so it has no discriminating power), and all 791 B pictures
+	 * scored are B-skip pictures, so refusing "B-skip only" costs exactly
+	 * what refusing every B picture costs - 731 of 1928 byte-exact frames
+	 * (37.9%), since the only refusal this interface can express is per
+	 * job. Deciding it correctly would mean decoding the co-located
+	 * macroblock layer for one macroblock (its entropy state and
+	 * partitioning) before programming the job, which is software decoding;
+	 * the one fact that could make a narrow gate possible is how the motion
+	 * plane encodes "collocated motion unavailable", and that encoding is
+	 * undocumented. A known gap is recorded here rather than traded for a
+	 * third of the frame rate.
+	 *
+	 * Once one picture has been refused, every later picture of the chain
+	 * still references it, so those are refused too until an IDR restarts
+	 * the chain: per-slice-type refusal alone delivered 17 frames that were
+	 * written but wrong. With this stickiness the same stream delivers 10
+	 * byte-exact frames (the two leading pictures of each GOP) and the
+	 * other 40 come back with a zeroed payload, so none is wrong.
+	 */
+	if (run->dec->flags & V4L2_H264_DECODE_PARAM_FLAG_IDR_PIC)
+		h264->col_half_lost = false;
+	if (h264->col_half_lost)
+		return -EINVAL;
+	if (histb_h264_has_b_slice(run)) {
+		bool field_pic = run->dec->flags &
+			V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC;
+
+		if (field_pic ||
+		    (run->sps->flags &
+		     V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD)) {
+			h264->col_half_lost = true;
+			return -EINVAL;
+		}
+	}
+
+	ret = histb_h264_pmv_grow(ctx, run->width_mbs, run->height_mbs,
+				  run->sps->flags &
+				  V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE,
+				  histb_h264_pmv_flush(run->dec));
+	if (ret)
+		return ret;
+
+	/*
+	 * Map the DPB onto the APC frame table. Capture buffer indexes are the
+	 * APC slots; the POC tail is zeroed like the vendor's and the address
+	 * tail points at the output frame. The vendor repeats the picture at
+	 * list position 0 through the unused tail entries past the slots it
+	 * counts as present - filling the same slots that way was measured here
+	 * and left every case of the corpus byte-identical (QDC81 over the
+	 * tx/cy/i12/pb/cb/cl/sc families), and renumbering the slots in
+	 * reference-list order changed nothing either, so no engine path reads
+	 * an APC slot that no declist id names.
+	 */
+	if (dst->vb2_buf.index >= HISTB_VDEC_MAX_DPB_SLOTS)
+		return -EINVAL;
+
+	cap_q = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	for (i = 0; i < HISTB_H264_NUM_APC_SLOTS; i++) {
+		run->img_addr[i] = lower_32_bits(run->dst_dma);
+		run->apc_poc[0][i] = 0;
+		run->apc_poc[1][i] = 0;
+	}
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+		const struct v4l2_h264_dpb_entry *entry = &run->dec->dpb[i];
+		struct vb2_buffer *vb;
+
+		run->dpb2apc[i] = HISTB_H264_APC_NONE;
+		if (!(entry->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			continue;
+
+		vb = vb2_find_buffer(cap_q, entry->reference_ts);
+		if (!vb || vb->index >= HISTB_H264_NUM_APC_SLOTS)
+			return -EINVAL;
+
+		run->dpb2apc[i] = vb->index;
+		run->img_addr[vb->index] =
+			lower_32_bits(histb_vdec_frame_dma(ctx, vb));
+		if (!run->img_addr[vb->index])
+			return -ENOMEM;
+		run->apc_poc[0][vb->index] = entry->top_field_order_cnt;
+		run->apc_poc[1][vb->index] = entry->bottom_field_order_cnt;
+	}
+
+	v4l2_h264_init_reflist_builder(&builder, run->dec, run->sps,
+				       run->dec->dpb);
+	run->num_valid = builder.num_valid;
+	v4l2_h264_build_p_ref_list(&builder, run->reflist_p);
+	v4l2_h264_build_b_ref_lists(&builder, run->reflist_b0, run->reflist_b1);
+
+	pic = histb_vdec_pic_slot(&dev->pool);
+	histb_h264_assemble_pic(dev, h264, run,
+				histb_h264_pmv_alloc(ctx, dst->vb2_buf.index),
+				pic);
+
+	for (i = 0; i < n_slices; i++) {
+		u32 nal_bit = run->slice_starts[i];
+		u32 next_bit = i + 1 < n_slices ? run->slice_starts[i + 1] :
+						  payload_bits;
+
+		if (nal_bit + run->slices[i].header_bit_size >= next_bit)
+			return -EINVAL;
+		/*
+		 * CABAC starts the segment at the next byte boundary (see
+		 * histb_h264_assemble_slice()), so a header ending inside the last
+		 * seven bits of the segment leaves nothing behind that rounding and
+		 * the u32 length wraps. Refuse it, as the HEVC path does for the
+		 * same shape.
+		 */
+		if (run->pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE &&
+		    ALIGN(nal_bit + run->slices[i].header_bit_size, 8) >= next_bit)
+			return -EINVAL;
+
+		histb_h264_assemble_slice(dev, ctx, run, h264, i, nal_bit,
+					  next_bit);
+	}
+
+	/*
+	 * The last real slot links to this one, so it has to present as an
+	 * empty segment even when an earlier job left a longer chain here.
+	 */
+	memset(histb_vdec_slice_slot(&dev->pool, n_slices), 0,
+	       HISTB_VDEC_SLOT_BYTES);
+
+	histb_h264_program_regs(dev, run);
+	dev->mb_total = run->width_mbs * run->height_mbs;
+	histb_vdec_hw_kick(dev, HISTB_VIDSTD_H264);
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_config histb_vdec_h264_ctrls[] = {
+	{
+		.id = V4L2_CID_STATELESS_H264_SPS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_PPS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_SCALING_MATRIX,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_PRED_WEIGHTS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_DECODE_PARAMS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_SLICE_PARAMS,
+		/*
+		 * v4l2_ctrl_new_custom() only preserves cfg->flags when the
+		 * config carries an explicit name: otherwise it runs
+		 * v4l2_ctrl_fill(), which zeroes the flags and would drop the
+		 * dynamic-array property.
+		 */
+		.name = "H264 Slice Parameters",
+		.type = V4L2_CTRL_TYPE_H264_SLICE_PARAMS,
+		.dims = { 8 },
+		.flags = V4L2_CTRL_FLAG_DYNAMIC_ARRAY,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_DECODE_MODE,
+		.min = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.max = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.def = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+	},
+	{
+		.id = V4L2_CID_STATELESS_H264_START_CODE,
+		.min = V4L2_STATELESS_H264_START_CODE_NONE,
+		.max = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.def = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+	},
+};
+
+static const struct histb_vdec_codec_ops histb_vdec_h264_codec_ops = {
+	.start = histb_vdec_h264_start,
+	.stop = histb_vdec_h264_stop,
+	.run = histb_vdec_h264_run,
+	.try_ctrl = histb_vdec_h264_try_ctrl,
+};
+
+const histb_vdec_fmt_desc histb_vdec_h264_fmt = {
+	.fourcc = V4L2_PIX_FMT_H264_SLICE,
+	.stride = histb_h264_tile_stride,
+	.grid_align = 16,
+	.num_ctrls = ARRAY_SIZE(histb_vdec_h264_ctrls),
+	.ctrls = histb_vdec_h264_ctrls,
+	.ops = &histb_vdec_h264_codec_ops,
+	.vidstd = HISTB_VIDSTD_H264,
+};
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_hevc.c b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_hevc.c
new file mode 100644
index 000000000000..ec30c6a8fac4
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_hevc.c
@@ -0,0 +1,1497 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Hi3798MV100 (VDH HiVDHV300R001) stateless HEVC decoder.
+ *
+ * HEVC is a V3 addition: the Hi3716CV200 part (HiVDHV200R004) has no HEVC
+ * path, so this front end is registered for Hi3798MV100 only.
+ *
+ * One job decodes one frame: the picture slot of the message pool carries the
+ * frame-level state (POC, DPB address and POC tables, CABAC context table
+ * pointer, tile info image, scaling lists), followed by one chained slice slot
+ * per slice. Every slot word layout implemented here is derived from the vendor
+ * firmware's message-assembly routines; the behaviour behind each word, and the
+ * frame storage model (APC/PMV tables, tile frame slots), are described next to
+ * the code that writes them.
+ *
+ * Hardware facts worth keeping next to the code:
+ *
+ *  - The decoder consumes fully parsed syntax and never reads slice
+ *    headers; the only bitstream it fetches is slice_data(), addressed
+ *    through a per-slice stream segment, exactly like H.264.
+ *  - Frame storage is table based like H.264 (16 APC slots addressed by
+ *    capture buffer index, 20 private PMV slots), but the CABAC context
+ *    table is a fixed per-slice-type (m, n) image and the picture message
+ *    additionally carries the tile info image and a 256-word scaling
+ *    list copy.
+ *  - The slice chain is anchored in picture word D63 (not D9 like H.264)
+ *    and each slice slot carries its CTB range end in D43/D44.
+ */
+
+#include <linux/dma-mapping.h>
+#include <media/v4l2-hevc.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "histb_vdec_v2.h"
+
+/*
+ * PMV slot geometry: 32 bytes per 16x16 macroblock row-column, 128-byte
+ * aligned, floored at the 1080p image the vendor reserves even for small
+ * streams. Unlike the H.264 layer the pool is not fixed at the largest
+ * supported frame; the geometry is grown to the stream resolution on the first
+ * frame that needs it (see histb_vdec_hevc_run).
+ */
+#define HISTB_HEVC_PMV_SLOT_SIZE_MIN		261120u
+#define HISTB_HEVC_PMV_SLOT_SIZE(w_mb, h_mb)	\
+	ALIGN((w_mb) * 32u * (h_mb), 128u)
+
+/*
+ * The picture message carries a 16-entry frame address table, so capture buffer
+ * indexes double as APC slots up to this limit. dpb2apc[] uses
+ * HISTB_HEVC_APC_NONE for DPB entries that map to no slot.
+ */
+#define HISTB_HEVC_NUM_APC_SLOTS		V4L2_HEVC_DPB_ENTRIES_NUM_MAX
+#define HISTB_HEVC_APC_NONE			0xffu
+
+/*
+ * Protocol code the VDM_CFG1 VID_STD field carries for HEVC on this decoder
+ * generation. It is not the 17 of the firmware dispatch table the start path
+ * uses; the vendor start program writes 13.
+ */
+#define HISTB_HEVC_VIDSTD_CODE			13
+
+/*
+ * Post-filter scratch row count of the PPFD image this pool area is sized for
+ * (HISTB_VDEC_PPFD_SIZE = 64 words x 800 rows); the register takes the row
+ * count minus one.
+ */
+#define HISTB_HEVC_PPFD_ROWS			800
+
+/*
+ * Hardware slice-type codes, indexed by the V4L2 slice_type (B=0, P=1, I=2):
+ * the hardware codes B as 2, P as 1 and I as 0, the same coding the H.264 HAL's
+ * slice-type table produces and the h264 layer implements.
+ */
+static u8 histb_hevc_slice_type_code(u8 slice_type)
+{
+	static const u8 code[3] = { 2, 1, 0 };
+
+	return code[slice_type % 3];
+}
+
+struct histb_vdec_hevc_ctx {
+	void		*pmv_va[HISTB_VDEC_MAX_PMV_SLOTS];
+	dma_addr_t	pmv_dma[HISTB_VDEC_MAX_PMV_SLOTS];
+	unsigned int	pmv_slot_size;
+	void		*rbsp_va;
+	dma_addr_t	rbsp_dma;
+	unsigned int	rbsp_size;
+};
+
+/* Per-frame assembly state shared by the picture and slice packers. */
+struct histb_hevc_run {
+	const struct v4l2_ctrl_hevc_sps *sps;
+	const struct v4l2_ctrl_hevc_pps *pps;
+	const struct v4l2_ctrl_hevc_decode_params *dec;
+	const struct v4l2_ctrl_hevc_slice_params *slices;
+	const struct v4l2_ctrl_hevc_scaling_matrix *scaling;
+	unsigned int		num_slices;
+	unsigned int		width;
+	unsigned int		height;
+	unsigned int		width_ctbs;
+	unsigned int		height_ctbs;
+	unsigned int		ctb_log2;
+	unsigned int		ctu_count;
+	u32			tile_stride;
+	u32			buf_lines;
+	const u8		*stream_va;
+	dma_addr_t		src_dma;
+	dma_addr_t		dst_dma;
+	u8			dpb2apc[V4L2_HEVC_DPB_ENTRIES_NUM_MAX];
+	u32			img_addr[HISTB_HEVC_NUM_APC_SLOTS];
+	s32			apc_poc[HISTB_HEVC_NUM_APC_SLOTS];
+};
+
+static struct histb_vdec_dev *histb_vdec_hevc_dev(struct histb_vdec_ctx *ctx)
+{
+	return video_get_drvdata(ctx->fh.vdev);
+}
+
+/*
+ * PMV slot allocator: capture buffer index -> PMV slot id. Slot ids are stored
+ * +1 so that a zeroed pmv_map[] means "unallocated"; ids wrap around the
+ * 20-slot pool.
+ */
+static u8 histb_hevc_pmv_alloc(struct histb_vdec_ctx *ctx, unsigned int index)
+{
+	u8 id = ctx->pmv_map[index];
+
+	if (!id) {
+		id = ctx->pmv_next++ % HISTB_VDEC_MAX_PMV_SLOTS + 1;
+		ctx->pmv_map[index] = id;
+	}
+
+	return id - 1;
+}
+
+/*
+ * Grow the PMV pool to @slot_size per slot. The private slots are addressed
+ * independently of the frame table, so a new geometry invalidates every
+ * allocated slot id and resets the map.
+ *
+ * One chunk per slot, never one slot_size * HISTB_VDEC_MAX_PMV_SLOTS block: the
+ * 20-slot pool at the 1080p floor is 5.0 MB, an order-11 request (8 MB, 8 MB
+ * aligned), and on the board that request alone failed - `cma:
+ * __cma_alloc_frozen: reserved: alloc failed, req-size: 1275 pages, ret: -16`,
+ * with 9.9 MB free in the 16 MB region - so every HEVC job was refused with
+ * -ENOMEM before the doorbell.
+ */
+static void histb_hevc_pmv_pool_free(struct histb_vdec_dev *dev,
+				     struct histb_vdec_hevc_ctx *hevc)
+{
+	unsigned int i;
+
+	for (i = 0; i < HISTB_VDEC_MAX_PMV_SLOTS; i++) {
+		if (!hevc->pmv_va[i])
+			continue;
+		dma_free_wc(dev->memdev, hevc->pmv_slot_size, hevc->pmv_va[i],
+			    hevc->pmv_dma[i]);
+		hevc->pmv_va[i] = NULL;
+	}
+	hevc->pmv_slot_size = 0;
+}
+
+static int histb_hevc_pmv_pool_grow(struct histb_vdec_ctx *ctx,
+				    struct histb_vdec_hevc_ctx *hevc,
+				    unsigned int slot_size)
+{
+	struct histb_vdec_dev *dev = histb_vdec_hevc_dev(ctx);
+	unsigned int i;
+
+	/*
+	 * One PMV geometry per session, as on the H.264 side: a mid-session SPS
+	 * change would free the pool while a later DPB can still name those
+	 * pictures. Restarting the queues runs ->stop() and zeroes the size, so
+	 * that is the only supported way here to move to a new geometry and the
+	 * job with a different size is refused with -EINVAL.
+	 */
+	if (hevc->pmv_slot_size) {
+		/*
+		 * A second geometry inside one session is refused rather than
+		 * rebuilt: the rebuild clears pmv_map, so a picture that a
+		 * later job still names in its DPB is handed a slot that was
+		 * never written, and the engine reads its collocated motion
+		 * vectors straight out of that memory (D23 is addressed through
+		 * the same dpb2apc[] map that histb_hevc_assemble_slice()
+		 * validates). The H.264 side can rebuild at a flush boundary
+		 * because every entry of its DPB array carries a validity flag;
+		 * a HEVC entry carries exactly one flag,
+		 * V4L2_HEVC_DPB_ENTRY_LONG_TERM_REFERENCE
+		 * (include/uapi/linux/v4l2-controls.h), so that predicate
+		 * cannot be formed here. The slot size is a function of the SPS
+		 * picture alone, so a conformant client reaches a new geometry
+		 * only by restarting the queues, which runs ->stop(); measured
+		 * over the scored corpus, 111 streams each carry one distinct
+		 * SPS payload, so this refuses nothing that decodes today.
+		 * Accepting a mid-chain change would need a per-picture slot
+		 * table that survives the rebuild.
+		 */
+		if (hevc->pmv_slot_size != slot_size)
+			return -EINVAL;
+		return 0;
+	}
+
+	histb_hevc_pmv_pool_free(dev, hevc);
+
+	for (i = 0; i < HISTB_VDEC_MAX_PMV_SLOTS; i++) {
+		hevc->pmv_va[i] = dma_alloc_wc(dev->memdev, slot_size,
+					       &hevc->pmv_dma[i], GFP_KERNEL);
+		if (!hevc->pmv_va[i])
+			break;
+	}
+	if (i < HISTB_VDEC_MAX_PMV_SLOTS) {
+		histb_hevc_pmv_pool_free(dev, hevc);
+		return -ENOMEM;
+	}
+	hevc->pmv_slot_size = slot_size;
+
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+
+	return 0;
+}
+
+/*
+ * Start-code scan over the OUTPUT plane. Returns the bit position of every VCL
+ * slice NAL unit (nal_unit_type 0..9 and 16..23, the slice NALs the message ABI
+ * can describe). A 4-byte start code matches once: the extra leading zero byte
+ * never forms a 00 00 01 triple with the prefix. Returns the total number of
+ * slice NALs found (may exceed @max).
+ */
+static unsigned int histb_hevc_find_slice_nals(const u8 *buf, u32 size,
+					       u32 *starts, unsigned int max)
+{
+	unsigned int n = 0;
+	u32 i;
+
+	for (i = 0; i + 3 < size; i++) {
+		u8 nal_type = (buf[i + 3] >> 1) & 0x3f;
+
+		if (buf[i] || buf[i + 1] || buf[i + 2] != 0x01)
+			continue;
+
+		if (nal_type > 9 && (nal_type < 16 || nal_type > 23))
+			continue;
+
+		if (n < max)
+			starts[n] = (i + 3) * 8;
+		n++;
+	}
+
+	return n;
+}
+
+/*
+ * Scaling lists, picture words D64..D319. The vendor copies a 256-word image
+ * word for word; the layout this driver assumes is the linear image of the V4L2
+ * control (4x4, 8x8, 16x16, 32x32 lists and the DC coefficients in struct
+ * order, zero padded). That packing is unverified against the hardware: on the
+ * board the submitted matrices are not consulted at all for a picture that
+ * claims them, so captures cannot confirm or correct this layout; see the
+ * scaling-list refusal in histb_vdec_hevc_run for the measurement.
+ */
+static void histb_hevc_pack_scaling(u32 *dst,
+				    const struct v4l2_ctrl_hevc_scaling_matrix *m)
+{
+	memcpy(dst, m, sizeof(*m));
+}
+
+static void histb_hevc_assemble_pic(struct histb_vdec_dev *dev,
+				    struct histb_vdec_ctx *ctx,
+				    struct histb_vdec_hevc_ctx *hevc,
+				    const struct histb_hevc_run *run,
+				    u8 cur_pmv_slot, u32 *pic)
+{
+	const struct v4l2_ctrl_hevc_sps *sps = run->sps;
+	const struct v4l2_ctrl_hevc_pps *pps = run->pps;
+	const struct v4l2_ctrl_hevc_decode_params *dec = run->dec;
+	dma_addr_t tables = histb_vdec_tables_dma(&dev->pool);
+	unsigned int log2_min_cb = sps->log2_min_luma_coding_block_size_minus3 + 3;
+	unsigned int log2_min_tb = sps->log2_min_luma_transform_block_size_minus2 + 2;
+	unsigned int log2_min_pcm = sps->log2_min_pcm_luma_coding_block_size_minus3 + 3;
+	unsigned int log2_max_pcm = log2_min_pcm +
+			sps->log2_diff_max_min_pcm_luma_coding_block_size;
+	unsigned int i;
+
+	memset(pic, 0, HISTB_VDEC_SLOT_BYTES);
+
+	pic[0] = (run->width_ctbs - 1) |
+		 ((run->height_ctbs - 1) << 9) |
+		 ((sps->flags & V4L2_HEVC_SPS_FLAG_PCM_ENABLED) ? BIT(18) : 0) |
+		 ((u32)sps->chroma_format_idc << 19) |
+		 ((sps->flags & V4L2_HEVC_SPS_FLAG_AMP_ENABLED) ? BIT(21) : 0) |
+		 ((sps->flags & V4L2_HEVC_SPS_FLAG_SAMPLE_ADAPTIVE_OFFSET) ?
+		  BIT(22) : 0) |
+		 ((sps->flags & V4L2_HEVC_SPS_FLAG_PCM_LOOP_FILTER_DISABLED) ?
+		  BIT(23) : 0) |
+		 ((sps->flags & V4L2_HEVC_SPS_FLAG_SCALING_LIST_ENABLED) ?
+		  BIT(24) : 0) |
+		 ((sps->flags & V4L2_HEVC_SPS_FLAG_STRONG_INTRA_SMOOTHING_ENABLED) ?
+		  BIT(25) : 0);
+	/* picture order count of the current frame */
+	pic[1] = (u32)dec->pic_order_cnt_val;
+	pic[2] = run->ctb_log2 |
+		 (log2_min_cb << 3) |
+		 ((u32)sps->log2_diff_max_min_luma_coding_block_size << 6) |
+		 ((u32)(log2_min_tb +
+			sps->log2_diff_max_min_luma_transform_block_size) << 9) |
+		 ((u32)log2_min_tb << 12) |
+		 ((u32)log2_max_pcm << 15) |
+		 ((u32)log2_min_pcm << 18) |
+		 ((u32)sps->max_transform_hierarchy_depth_intra << 21) |
+		 ((u32)sps->max_transform_hierarchy_depth_inter << 24) |
+		 ((pps->flags & V4L2_HEVC_PPS_FLAG_WEIGHTED_PRED) ? BIT(27) : 0) |
+		 ((pps->flags & V4L2_HEVC_PPS_FLAG_WEIGHTED_BIPRED) ? BIT(28) : 0) |
+		 ((u32)pps->log2_parallel_merge_level_minus2 << 29);
+	pic[3] = ((sps->bit_depth_luma_minus8 + 8) & 0xf) |
+		 (((sps->bit_depth_chroma_minus8 + 8) & 0xf) << 4) |
+		 (((sps->pcm_sample_bit_depth_luma_minus1 + 1) & 0xf) << 8) |
+		 (((sps->pcm_sample_bit_depth_chroma_minus1 + 1) & 0xf) << 12) |
+		 ((6u * sps->bit_depth_chroma_minus8 & 0x3f) << 16) |
+		 ((6u * sps->bit_depth_luma_minus8 & 0x3f) << 22);
+	/*
+	 * Band-line scratch addresses. The engine writes four areas here (the
+	 * top PMV row, the reconstructed band, the left PMV column and the top
+	 * deblocking row) and the vendor repeats HISTB_SCRATCH_SED_TOP in
+	 * D5/D43. Sharing one region lets the reconstructed band run through
+	 * the table area mid-decode, so each word gets its own scratch block
+	 * the way the byte-exact H.264 path does (histb_vdec_h264.c); measured
+	 * on the board on a 320x240 intra frame, 1238 of 4800 luma lines land
+	 * where the model puts them while the areas are shared, all 4800 once
+	 * each word has its own block. D57 and D59 likewise split into
+	 * dblk_left and dblk_top.
+	 */
+	pic[4] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_SED_TOP));
+	pic[5] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_PMV_TOP));
+	/* current frame PMV slot */
+	pic[6] = lower_32_bits(hevc->pmv_dma[cur_pmv_slot]);
+	pic[7] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_RCNTOP));
+	/* APC frame address table, then the POC table in APC slot order */
+	for (i = 0; i < HISTB_HEVC_NUM_APC_SLOTS; i++) {
+		pic[8 + i] = run->img_addr[i];
+		pic[26 + i] = (u32)run->apc_poc[i];
+	}
+	/* HEVC CABAC (m, n) context table */
+	pic[25] = lower_32_bits(tables + HISTB_TABLE_OFF_CABAC_MN_HEVC);
+	pic[43] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_PMV_LEFT));
+	pic[54] = (run->width & 0xffff) | (run->height & 0xffff) << 16;
+	/* D55 is the tile segment info image the vendor fills, not an alias of
+	 * the reconstructed band in D7.
+	 */
+	pic[55] = lower_32_bits(tables + HISTB_TABLE_OFF_TILE_INFO);
+	pic[56] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_SAO_LEFT));
+	pic[57] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_DBLK_LEFT));
+	pic[58] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_SAO_TOP));
+	pic[59] = lower_32_bits(tables + HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_DBLK_TOP));
+	pic[60] = (((u32)pps->pps_cb_qp_offset & 31) << 5) |
+		  ((u32)pps->pps_cr_qp_offset & 31) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_CONSTRAINED_INTRA_PRED) ?
+		   BIT(10) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_TRANSQUANT_BYPASS_ENABLED) ?
+		   BIT(11) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_CU_QP_DELTA_ENABLED) ?
+		   BIT(12) : 0) |
+		  ((u32)pps->diff_cu_qp_delta_depth & 0xf) << 13 |
+		  /* bits21:16 are Log2MinCuQpDeltaSize = Log2CtbSizeY minus
+		   * diff_cu_qp_delta_depth (H.265 7.4.3.2, which is also the
+		   * shape the vendor programs); measured on the board, a
+		   * min-CB-based sum here derails the CABAC parse of every
+		   * picture with cu_qp_delta_enabled.
+		   */
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_CU_QP_DELTA_ENABLED) ?
+		   ((run->ctb_log2 - pps->diff_cu_qp_delta_depth) & 7) << 16 : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_TILES_ENABLED) ? BIT(19) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_UNIFORM_SPACING) ? BIT(20) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_ENTROPY_CODING_SYNC_ENABLED) ?
+		   BIT(21) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_SIGN_DATA_HIDING_ENABLED) ?
+		   BIT(22) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_TRANSFORM_SKIP_ENABLED) ?
+		   BIT(23) : 0) |
+		  ((pps->flags & V4L2_HEVC_PPS_FLAG_LOOP_FILTER_ACROSS_TILES_ENABLED) ?
+		   BIT(24) : 0);
+	pic[61] = (pps->num_tile_columns_minus1 & 0xffff) |
+		  (u32)pps->num_tile_rows_minus1 << 16;
+	/* head of the slice chain */
+	pic[63] = lower_32_bits(histb_vdec_slice_slot_dma(&dev->pool, 0));
+
+	/*
+	 * The scaling image is copied every job: with SPS scaling_list_enabled
+	 * clear the hardware ignores it, and skipping the copy would leave the
+	 * previous frame's lists in the pool slot. A client that enables the
+	 * flag and does not fill the control gets its zeroed default, which is
+	 * what the uAPI prescribes (the control always exists in the handler).
+	 */
+	histb_hevc_pack_scaling(&pic[64], run->scaling);
+}
+
+static int histb_hevc_pack_weights(u32 *slot,
+				   const struct v4l2_ctrl_hevc_slice_params *slice,
+				   bool list1)
+{
+	const struct v4l2_hevc_pred_weight_table *w = &slice->pred_weight_table;
+	const s8 *lofs = list1 ? w->luma_offset_l1 : w->luma_offset_l0;
+	const s8 *lwt = list1 ? w->delta_luma_weight_l1 : w->delta_luma_weight_l0;
+	const s8 (*cofs)[2] = list1 ? w->chroma_offset_l1 : w->chroma_offset_l0;
+	const s8 (*cwt)[2] = list1 ? w->delta_chroma_weight_l1 :
+				     w->delta_chroma_weight_l0;
+	unsigned int count = list1 ? slice->num_ref_idx_l1_active_minus1 + 1 :
+			    slice->num_ref_idx_l0_active_minus1 + 1;
+	unsigned int lden = w->luma_log2_weight_denom & 7;
+	unsigned int cden = (w->luma_log2_weight_denom +
+			     w->delta_chroma_log2_weight_denom) & 7;
+	/*
+	 * Weight image of one list: luma at W64 (L0) / W80 (L1), the first
+	 * chroma component at W128 / W144 and the second at W160 / W176,
+	 * 16 entries each, packed as offset<<12 | weight<<3 | den for luma
+	 * and the first chroma component, weight | offset<<9 for the second.
+	 */
+	unsigned int base = list1 ? 80u : 64u;
+	unsigned int i;
+
+	/*
+	 * A seventeenth reference cannot be packed. The weight image the slice
+	 * slot carries is 16 words per component and per list - luma at
+	 * W64..W79 (L0) and W80..W95 (L1), the first chroma component at
+	 * W128..W143 and W144..W159, the second at W160..W175 and W176..W191,
+	 * the layout the vendor's slice-message writer produces - and the uAPI
+	 * arrays the loop reads are the same length
+	 * (V4L2_HEVC_DPB_ENTRIES_NUM_MAX = 16, v4l2-controls.h). Because the
+	 * two chroma rows are written at base + 64 and base + 96, index 16
+	 * would land in the other list's luma block, so the count is checked
+	 * instead of clamped. H.265 keeps the active list length inside the DPB
+	 * and this driver's frame table is that same 16 slots, so a conformant
+	 * stream is never refused. TODO: the weight values themselves are
+	 * unmeasured - the two weighted B pictures scored on the board came out
+	 * 6/6 byte-exact from an encoder that submits unit weights, so only a
+	 * stream with non-default coefficients confirms the packing.
+	 */
+	if ((list1 ? slice->num_ref_idx_l1_active_minus1 :
+		     slice->num_ref_idx_l0_active_minus1) >
+	    V4L2_HEVC_DPB_ENTRIES_NUM_MAX - 1)
+		return -EINVAL;
+
+	for (i = 0; i < count; i++) {
+		int lw = lwt[i] + (1 << lden);
+		int cw = cwt[i][0] + (1 << cden);
+		int cw2 = cwt[i][1] + (1 << cden);
+
+		slot[base + i] = ((u32)(u8)lofs[i] << 12) |
+				 ((u32)lw & 0x1ff) << 3 | lden;
+		slot[base + 64 + i] = ((u32)(u8)cofs[i][0] << 12) |
+				      ((u32)cw & 0x1ff) << 3 | cden;
+		slot[base + 96 + i] = ((u32)cw2 & 0x1ff) |
+				      ((u32)(u8)cofs[i][1] << 9);
+	}
+
+	return 0;
+}
+
+static int histb_hevc_assemble_slice(struct histb_vdec_dev *dev,
+				     struct histb_vdec_ctx *ctx,
+				     struct histb_vdec_hevc_ctx *hevc,
+				     const struct histb_hevc_run *run,
+				     unsigned int index,
+				     u32 nal_bit, u32 next_bit,
+				     u32 payload_bits)
+{
+	const struct v4l2_ctrl_hevc_slice_params *slice = &run->slices[index];
+	const struct v4l2_ctrl_hevc_pps *pps = run->pps;
+	const struct v4l2_ctrl_hevc_decode_params *dec = run->dec;
+	const struct v4l2_ctrl_hevc_sps *sps = run->sps;
+	u32 *slot = histb_vdec_slice_slot(&dev->pool, index);
+	unsigned int last = run->num_slices - 1;
+	unsigned int count0 = 0, count1 = 0;
+	unsigned int end_ctb, i;
+	/*
+	 * Tiles are refused in histb_vdec_hevc_run, so every picture reaching
+	 * here is untiled and the tile-scan and raster-scan CTB orders coincide.
+	 */
+	unsigned int tile_addr = slice->slice_segment_addr;
+	bool is_low_delay;
+	bool is_b = slice->slice_type == V4L2_HEVC_SLICE_TYPE_B;
+	bool is_p = slice->slice_type == V4L2_HEVC_SLICE_TYPE_P;
+	bool lf_across = (slice->flags &
+		V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_LOOP_FILTER_ACROSS_SLICES_ENABLED) ||
+		(pps->flags &
+		V4L2_HEVC_PPS_FLAG_PPS_LOOP_FILTER_ACROSS_SLICES_ENABLED);
+	bool dbf_off = (slice->flags &
+		V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_DEBLOCKING_FILTER_DISABLED) ||
+		(pps->flags &
+		V4L2_HEVC_PPS_FLAG_PPS_DISABLE_DEBLOCKING_FILTER);
+	bool weighted;
+	s32 col_dpb = -1;
+	u32 data_bit, valid_bits, qp;
+
+	memset(slot, 0, HISTB_VDEC_SLOT_BYTES);
+
+	/*
+	 * slice_type indexes the hardware's two-bit slice code, and that code
+	 * has three values: the vendor's per-slice-type table is { 2, 1, 0 }
+	 * for B, P, I, and histb_hevc_slice_type_code() above folds anything
+	 * larger back onto those three with "% 3". H.265 7.4.3 gives
+	 * slice_segment_type no fourth value, so a larger one is a client
+	 * error, and passing it through would describe the slice to the
+	 * engine as some other type while the list lengths in D7 and the
+	 * weighted-prediction test at the bottom of this function still
+	 * follow the value the client gave. The same confusion between the
+	 * coded value and the enum, not the coefficients, is what made H.264
+	 * weighted prediction fail on the board, which is why the domain is
+	 * checked before anything is packed.
+	 */
+	if (slice->slice_type > V4L2_HEVC_SLICE_TYPE_I)
+		return -EINVAL;
+
+	if (is_p || is_b)
+		count0 = min_t(unsigned int,
+			       slice->num_ref_idx_l0_active_minus1 + 1,
+			       V4L2_HEVC_DPB_ENTRIES_NUM_MAX);
+	if (is_b)
+		count1 = min_t(unsigned int,
+			       slice->num_ref_idx_l1_active_minus1 + 1,
+			       V4L2_HEVC_DPB_ENTRIES_NUM_MAX);
+
+	for (i = 0; i < count0; i++)
+		/*
+		 * Every active reference must name a DPB entry this job mapped
+		 * onto a frame slot. The engine is handed the list as 4-bit APC
+		 * slot ids (D15/D16) and reads the picture behind each id from
+		 * the 16-entry frame table in D8..D23, so an index outside the
+		 * DPB array or an entry with no capture buffer has nothing that
+		 * can be packed: the slot id would be truncated, and the
+		 * address that selects is the one the caller prefills with the
+		 * destination of this very frame, which turns inter prediction
+		 * into self prediction. Refusal is the deliverable
+		 * disposition - the capture buffer comes back with bytesused 0.
+		 * Measured on the board: this is what fires when a client's
+		 * reference indices do not resolve - it refused two frames of a
+		 * 12-frame P chain while the submitting side held a DPB that
+		 * did not match the array it handed over - and the same chain
+		 * has been decoded 12/12 byte-exact ever since the indices
+		 * resolve, so nothing that names its references correctly is
+		 * lost here.
+		 */
+		if (slice->ref_idx_l0[i] >= V4L2_HEVC_DPB_ENTRIES_NUM_MAX ||
+		    run->dpb2apc[slice->ref_idx_l0[i]] == HISTB_HEVC_APC_NONE)
+			return -EINVAL;
+	for (i = 0; i < count1; i++)
+		/*
+		 * The same bound on list 1, which the engine reads from D17/D18
+		 * against the same frame table: a B slice's backward reference
+		 * that resolves to no capture buffer would carry the un-mapped
+		 * marker into a four-bit slot id and point prediction at the
+		 * picture being written. H.265 7.4.3 keeps both lists inside
+		 * the DPB, and the 12-frame B chains scored on the board
+		 * resolve both lists and decode 12/12 byte-exact, so this
+		 * refuses nothing that a conformant submission produces.
+		 */
+		if (slice->ref_idx_l1[i] >= V4L2_HEVC_DPB_ENTRIES_NUM_MAX ||
+		    run->dpb2apc[slice->ref_idx_l1[i]] == HISTB_HEVC_APC_NONE)
+			return -EINVAL;
+
+	/*
+	 * Collocated picture for temporal motion vector prediction: the
+	 * hardware needs its APC slot (D7) and the PMV slot address (D23). I
+	 * slices carry no reference lists, so temporal MVP has no source
+	 * picture there and the words stay clear.
+	 */
+	if ((is_p || is_b) &&
+	    (slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_TEMPORAL_MVP_ENABLED)) {
+		bool from_l1 = is_b &&
+			!(slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0);
+		const u8 *refs = from_l1 ? slice->ref_idx_l1 :
+					   slice->ref_idx_l0;
+		unsigned int bound = from_l1 ? count1 : count0;
+
+		/*
+		 * collocated_ref_idx is an index into the list that
+		 * collocated_from_l0_flag selects (H.265 7.4.3), and @bound is
+		 * the active count the loops above just validated. So this is
+		 * the check that makes the two writes below safe without a
+		 * further test: refs[] stays inside its 16 entries, and
+		 * dpb2apc[refs[i]] cannot be HISTB_HEVC_APC_NONE, which is what
+		 * D7 bits31:28 (ColPicApc) and D23 (the PMV address of that
+		 * slot) are built from. An index at or beyond the active count
+		 * would put the un-mapped marker into a four-bit field - the
+		 * engine would take temporal motion vectors from another
+		 * picture's slot. Temporal MVP is not a rejected shape: the
+		 * 12-frame chains with it on decode 12/12 byte-exact, and the
+		 * same chain with it off gives frame-for-frame identical
+		 * readings, so the refusal here only catches a client whose
+		 * index is outside its own list.
+		 */
+		if (slice->collocated_ref_idx >= bound)
+			return -EINVAL;
+		col_dpb = refs[slice->collocated_ref_idx];
+	}
+
+	/*
+	 * Slice data segment. The hardware never reads slice headers, so the
+	 * segment points behind the header bits; the vendor carries the header
+	 * size as the byte offset to the slice data. The second segment (words
+	 * D3..D5) stays clear: the frame arrives as one contiguous OUTPUT
+	 * buffer.
+	 */
+	if (slice->data_byte_offset * 8 > slice->bit_size ||
+	    nal_bit >= next_bit)
+		return -EINVAL;
+	data_bit = nal_bit + slice->data_byte_offset * 8;
+	/*
+	 * The computed start of slice_data() must still be inside this slice's
+	 * span. D0..D2 of the segment word are a DMA offset, a bit offset and a
+	 * bit length that the engine consumes literally, and every subtraction
+	 * below (next_bit - data_bit, payload_bits - data_bit) only works if
+	 * this ordering holds; with data_bit past the next slice's first bit
+	 * the declared length would wrap to nearly 4 GiB and the span would run
+	 * past the end of the buffer. Overshoot is not benign even without the
+	 * wrap: when the declared span ends past the last coded bit the engine
+	 * still reports completion and takes a few CTB columns from stale band
+	 * state, measured as 5 of 12, 10 of 12 and 0 of 12 byte-exact frames on
+	 * three chains, which is why this is a refusal and not a clamp. The
+	 * offset is applied in the de-escaped domain the staging produced; over
+	 * 104 streams (the scored corpus plus eight purpose-built wide WPP
+	 * pictures) no slice header contained an emulation-prevention byte, so
+	 * the two possible readings of the client's value coincide on
+	 * everything measured so far.
+	 */
+	if (data_bit >= next_bit || data_bit >= payload_bits)
+		return -EINVAL;
+	valid_bits = slice->bit_size - slice->data_byte_offset * 8;
+	valid_bits = min_t(u32, valid_bits, next_bit - data_bit);
+	if (data_bit + valid_bits > payload_bits)
+		valid_bits = payload_bits - data_bit;
+	/*
+	 * The declared length stops at the last coded bit: rbsp_trailing_bits
+	 * is byte alignment, not slice data (histb_vdec_trail_zero_bits(), same
+	 * as the other codecs). Leaving it in does not only set the error flag
+	 * -- the engine also decodes a few CTB columns from stale band state:
+	 * with the untrimmed length r2 reaches 5/12 byte-exact frames, bs1
+	 * 10/12 and 512x240 0/12, all 12/12 once the trailing bits are
+	 * trimmed.
+	 */
+	{
+		u32 trail = histb_vdec_trail_zero_bits(run->stream_va,
+						       data_bit + valid_bits) + 1;
+
+		if (valid_bits > trail)
+			valid_bits -= trail;
+	}
+	/*
+	 * Nothing is left to decode once the trailing byte-alignment bits are
+	 * trimmed, which means the client's span held rbsp_trailing_bits and no
+	 * slice_data(). A declared length of zero in D2 has not been measured
+	 * on this engine, so the driver does not hand one out: the per-slice
+	 * up-message counts decoded CTBs against the declared length, and the
+	 * chain only advances through D63, so a slot with no syntax is the
+	 * shape that would plausibly run to the watchdog. The vendor's only
+	 * construct for "this slot carries no data" is the one-bit dummy slice
+	 * it inserts in front of a chain whose first slice starts mid-picture -
+	 * an explicit length of one bit - and that is explicit padding, not an
+	 * emptied real slice.
+	 */
+	if (!valid_bits)
+		return -EINVAL;
+	/* histb_vdec_seg_pack() adds the granule's own bits, so only the bit
+	 * position inside the byte is passed; the vendor masks the field to
+	 * seven bits.
+	 */
+	histb_vdec_seg_pack(&slot[0], run->src_dma,
+			    run->src_dma + (data_bit >> 3), data_bit & 7,
+			    valid_bits);
+
+	/* SliceQpY of the coded slice, wrapped to the hardware 6-bit field */
+	qp = (26 + pps->init_qp_minus26 + slice->slice_qp_delta) & 63;
+
+	/* IsLowDelay (D6[27]): every reference POC earlier than this picture's,
+	 * the vendor derivation of the flag.
+	 */
+	is_low_delay = true;
+	for (i = 0; i < count0 + count1; i++) {
+		int idx = i < count0 ? slice->ref_idx_l0[i] :
+			  slice->ref_idx_l1[i - count0];
+
+		if (dec->dpb[idx].pic_order_cnt_val >
+		    dec->pic_order_cnt_val) {
+			is_low_delay = false;
+			break;
+		}
+	}
+
+	slot[6] = (qp << 19) |
+		  ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT) ?
+		   BIT(18) : 0) |
+		  (is_low_delay ? BIT(27) : 0) |
+		  ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_DEPENDENT_SLICE_SEGMENT) ?
+		   BIT(26) : 0);
+	slot[7] = histb_hevc_slice_type_code(slice->slice_type) |
+		  (count0 << 2) | (count1 << 8) |
+		  ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_MVD_L1_ZERO) ?
+		   BIT(14) : 0) |
+		  ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_TEMPORAL_MVP_ENABLED) ?
+		   BIT(15) : 0) |
+		  ((u32)(slice->num_ref_idx_l0_active_minus1 & 31) << 16) |
+		  ((u32)(slice->num_ref_idx_l1_active_minus1 & 31) << 20) |
+		  ((u32)(5 - slice->five_minus_max_num_merge_cand) & 7) << 24 |
+		  ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0) ?
+		   BIT(27) : 0);
+	if (col_dpb >= 0) {
+		/*
+		 * The PMV pool is keyed by capture buffer index, which is also
+		 * the APC slot the current frame's own motion vectors went to
+		 * (histb_hevc_pmv_alloc(ctx, dst->vb2_buf.index) in the run
+		 * path, and the same indirection through dpb2apc in
+		 * histb_vdec_h264.c's collocated word). A raw dpb index here
+		 * hands the engine another picture's motion vectors.
+		 */
+		u8 col_pmv = histb_hevc_pmv_alloc(ctx, run->dpb2apc[col_dpb]);
+
+		slot[7] |= (u32)run->dpb2apc[col_dpb] << 28;
+		slot[23] = lower_32_bits(hevc->pmv_dma[col_pmv]);
+	}
+
+	/* D8/D9 carry the slice's start CTB in raster order and the
+	 * coordinates derived from it; D10 carries the same value in tile
+	 * order. For the untiled pictures this driver accepts the two orders
+	 * are equal.
+	 */
+	slot[8] = tile_addr;
+	slot[9] = ((tile_addr / run->width_ctbs) << 16) |
+		  (tile_addr % run->width_ctbs);
+	slot[10] = tile_addr;
+	slot[11] = (((u32)slice->slice_cb_qp_offset & 31) << 8) |
+		   ((u32)slice->slice_cr_qp_offset & 31);
+	slot[12] = (lf_across ? BIT(0) : 0) |
+		   (dbf_off ? BIT(1) : 0) |
+		   ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA) ?
+		    BIT(2) : 0) |
+		   ((slice->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_LUMA) ?
+		    BIT(3) : 0) |
+		   (((u32)slice->slice_beta_offset_div2 & 15) << 8) |
+		   (((u32)slice->slice_tc_offset_div2 & 15) << 16);
+
+	/* long-term reference bitmaps of both lists */
+	for (i = 0; i < count0; i++)
+		if (dec->dpb[slice->ref_idx_l0[i]].flags &
+		    V4L2_HEVC_DPB_ENTRY_LONG_TERM_REFERENCE)
+			slot[13] |= BIT(i);
+	for (i = 0; i < count1; i++)
+		if (dec->dpb[slice->ref_idx_l1[i]].flags &
+		    V4L2_HEVC_DPB_ENTRY_LONG_TERM_REFERENCE)
+			slot[14] |= BIT(i);
+
+	/*
+	 * Reference lists as 4-bit APC slot ids, eight entries per word: list 0
+	 * at D15/D16, list 1 at D17/D18.
+	 */
+	for (i = 0; i < count0; i++)
+		slot[15 + (i >> 3)] |= (u32)run->dpb2apc[slice->ref_idx_l0[i]] <<
+				       ((i & 7) * 4);
+	for (i = 0; i < count1; i++)
+		slot[17 + (i >> 3)] |= (u32)run->dpb2apc[slice->ref_idx_l1[i]] <<
+				       ((i & 7) * 4);
+
+	/* CABAC context initialisation word of this decoder generation */
+	slot[24] = 0x400a | ((6u * sps->bit_depth_luma_minus8) >> 1) << 8;
+
+	/*
+	 * Slice chain words. The CTB range of the slice ends where the next
+	 * slice begins (minus one, vendor arithmetic); the last slice ends at
+	 * the last CTB of the picture. D63 links to the next slot, the tail
+	 * terminates at zero, and a stateless driver refuses chains longer than
+	 * the message pool holds.
+	 */
+	end_ctb = index < last ? run->slices[index + 1].slice_segment_addr - 1 :
+		  run->ctu_count - 1;
+	slot[43] = end_ctb;
+	/* D44 is the tile-scan version of the same end; the vendor converts
+	 * only the raster word.
+	 */
+	slot[44] = end_ctb;
+	if (index < last)
+		slot[63] = lower_32_bits(histb_vdec_slice_slot_dma(&dev->pool,
+								   index + 1));
+
+	weighted = (is_b && (pps->flags & V4L2_HEVC_PPS_FLAG_WEIGHTED_BIPRED)) ||
+		   (is_p && (pps->flags & V4L2_HEVC_PPS_FLAG_WEIGHTED_PRED));
+	if (weighted) {
+		int ret = histb_hevc_pack_weights(slot, slice, false);
+
+		if (ret)
+			return ret;
+		if (is_b) {
+			ret = histb_hevc_pack_weights(slot, slice, true);
+			if (ret)
+				return ret;
+		}
+	}
+
+	return 0;
+}
+
+static void histb_hevc_program_regs(struct histb_vdec_dev *dev,
+				    const struct histb_hevc_run *run)
+{
+	unsigned int lines = run->buf_lines;
+	unsigned int i;
+	u32 cfg0 = (run->ctu_count - 1) & VDM_CFG0_MBAMT;
+	u32 cfg1 = FIELD_PREP(VDM_CFG1_VID_STD, HISTB_HEVC_VIDSTD_CODE) |
+		   FIELD_PREP(VDM_CFG1_DDR_STRIDE, run->tile_stride >> 6);
+
+	/* decoded CTU budget: the field counts CTUs minus one */
+	vdm_write(dev, VDM_CFG0, cfg0);
+	vdm_write(dev, VDM_CFG1, cfg1);
+	vdm_write(dev, VDM_AVM_ADDR,
+		  lower_32_bits(histb_vdec_pic_slot_dma(&dev->pool)));
+	vdm_write(dev, VDM_VAM_ADDR,
+		  lower_32_bits(histb_vdec_up_msgs_dma(&dev->pool)));
+	vdm_write(dev, VDM_STREAM_BASE, lower_32_bits(run->src_dma & ~15u));
+
+	/* one timeout per pipeline stage, windows 0x3c..0x54 only */
+	for (i = 1; i <= 7; i++)
+		vdm_write(dev, VDM_TO(i), VDM_TIMEOUT_MOD);
+
+	vdm_write(dev, VDM_YSTADDR_1D, lower_32_bits(run->dst_dma));
+	/*
+	 * The engine writes the band geometry documented in histb_vdec.h here
+	 * too: YSTRIDE_1D is the 16-row band pitch, the chroma plane sits
+	 * behind the whole luma band array plus the head-inf area. Measured on
+	 * a 320x240 intra frame: with the head-inf offset left clear and a line
+	 * pitch in YSTRIDE_1D, 73 of 4800 luma lines land where the model puts
+	 * them; with this shape and the picture message's scratch split,
+	 * all 4800.
+	 */
+	vdm_write(dev, VDM_YSTRIDE_1D,
+		  histb_vdec_band_bytes(run->tile_stride));
+	vdm_write(dev, VDM_UVOFFSET_1D,
+		  histb_vdec_luma_bytes(run->tile_stride, lines) +
+		  histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_HEAD_INF_OFFSET,
+		  histb_vdec_head_inf_bytes(lines));
+	/* post-filter scratch of this generation */
+	vdm_write(dev, VDM_PPFD_BUF_ADDR,
+		  lower_32_bits(histb_vdec_tables_dma(&dev->pool) +
+				HISTB_TABLE_OFF_PPFD));
+	vdm_write(dev, VDM_PPFD_BUF_LEN, HISTB_HEVC_PPFD_ROWS - 1);
+
+	vdm_write(dev, VDM_INT_STATE, 0xffffffffu);
+	vdm_write(dev, VDM_INT_MASK, 0xfffffffeu);
+}
+
+static int histb_vdec_hevc_start(struct histb_vdec_ctx *ctx)
+{
+	struct histb_vdec_hevc_ctx *hevc;
+
+	hevc = kzalloc_obj(*hevc);
+	if (!hevc)
+		return -ENOMEM;
+
+	/*
+	 * The PMV pool is allocated on the first frame that needs it, when the
+	 * SPS fixes the slot geometry; nothing else is per-context.
+	 */
+	ctx->priv = hevc;
+
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+
+	return 0;
+}
+
+static void histb_vdec_hevc_stop(struct histb_vdec_ctx *ctx)
+{
+	struct histb_vdec_dev *dev = histb_vdec_hevc_dev(ctx);
+	struct histb_vdec_hevc_ctx *hevc = ctx->priv;
+
+	if (!hevc)
+		return;
+
+	histb_hevc_pmv_pool_free(dev, hevc);
+	if (hevc->rbsp_va)
+		dma_free_wc(dev->memdev, hevc->rbsp_size, hevc->rbsp_va,
+			    hevc->rbsp_dma);
+	kfree(hevc);
+	ctx->priv = NULL;
+
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+}
+
+/*
+ * Hand the engine the slice span without its emulation-prevention bytes, the
+ * staging the byte-exact H.264 layer also performs: the VDM decodes the bytes
+ * it is given literally (histb_h264_pack_rbsp() records the measurement that
+ * shows it), and the uAPI delivers the escaped form.
+ *
+ * A 0x03 is dropped only when the two preceding raw bytes are zero, which is
+ * the decoder's own rule and so keeps a coded 0x03 that directly follows a
+ * removed one. The copy spans the first slice's NAL header byte to the end of
+ * the payload and rewrites the slice offsets into that domain; a span without
+ * any prevention byte keeps using the OUTPUT plane.
+ */
+static int histb_hevc_pack_rbsp(struct histb_vdec_ctx *ctx,
+				struct histb_hevc_run *run, u32 *slice_starts,
+				unsigned int n_slices, u32 *payload_bits)
+{
+	struct histb_vdec_dev *dev = histb_vdec_hevc_dev(ctx);
+	struct histb_vdec_hevc_ctx *hevc = ctx->priv;
+	unsigned int first = slice_starts[0] / 8;
+	unsigned int end = *payload_bits / 8;
+	unsigned int out = 0, idx = 0;
+	unsigned int i;
+	u8 *dst;
+
+	if (!run->stream_va || first >= end)
+		return 0;
+
+	for (i = first; i + 2 < end; i++) {
+		if (!run->stream_va[i] && !run->stream_va[i + 1] &&
+		    run->stream_va[i + 2] == 0x03)
+			break;
+	}
+	if (i + 2 >= end)
+		return 0;
+
+	if (hevc->rbsp_size < end - first) {
+		if (hevc->rbsp_va)
+			dma_free_wc(dev->memdev, hevc->rbsp_size, hevc->rbsp_va,
+				    hevc->rbsp_dma);
+		hevc->rbsp_size = 0;
+		hevc->rbsp_va = dma_alloc_wc(dev->memdev,
+					     round_up(end - first, 64 * 1024),
+					     &hevc->rbsp_dma, GFP_KERNEL);
+		if (!hevc->rbsp_va)
+			return -ENOMEM;
+		hevc->rbsp_size = round_up(end - first, 64 * 1024);
+	}
+	dst = hevc->rbsp_va;
+
+	slice_starts[0] = 0;
+	for (i = first; i < end; i++) {
+		while (idx + 1 < n_slices && slice_starts[idx + 1] / 8 == i) {
+			idx++;
+			slice_starts[idx] = out * 8;
+		}
+		if (i >= first + 2 && run->stream_va[i] == 0x03 &&
+		    !run->stream_va[i - 1] && !run->stream_va[i - 2])
+			continue;
+		dst[out++] = run->stream_va[i];
+	}
+
+	*payload_bits = out * 8;
+	run->stream_va = dst;
+	run->src_dma = hevc->rbsp_dma;
+	return 0;
+}
+
+static int histb_vdec_hevc_run(struct histb_vdec_ctx *ctx,
+			       struct vb2_v4l2_buffer *src,
+			       struct vb2_v4l2_buffer *dst)
+{
+	struct histb_vdec_dev *dev = histb_vdec_hevc_dev(ctx);
+	struct histb_vdec_hevc_ctx *hevc = ctx->priv;
+	struct histb_hevc_run run = { };
+	unsigned int cap_w, cap_h;
+	struct v4l2_ctrl *ctrl;
+	u32 slice_starts[HISTB_VDEC_MAX_SLICE_SLOTS];
+	struct vb2_queue *cap_q;
+	const u8 *stream_va;
+	u32 *pic, payload_bits;
+	unsigned int n_slices, found, w_mb, h_mb, needed;
+	unsigned long start_code;
+	unsigned int i;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct v4l2_ctrl_hevc_scaling_matrix) >
+		     (HISTB_VDEC_SLOT_WORDS - 64) * 4);
+
+	/*
+	 * The driver core has applied the request to the control handler before
+	 * scheduling this job, so p_cur carries this frame's values.
+	 */
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_HEVC_SPS);
+	run.sps = ctrl ? ctrl->p_cur.p_hevc_sps : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_HEVC_PPS);
+	run.pps = ctrl ? ctrl->p_cur.p_hevc_pps : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_HEVC_DECODE_PARAMS);
+	/* decode_params and scaling_matrix have no typed pointer member */
+	run.dec = ctrl ? (const void *)ctrl->p_cur.p : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_HEVC_SCALING_MATRIX);
+	run.scaling = ctrl ? (const void *)ctrl->p_cur.p : NULL;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_HEVC_SLICE_PARAMS);
+	run.slices = ctrl ? ctrl->p_cur.p_hevc_slice_params : NULL;
+	n_slices = ctrl ? ctrl->new_elems : 0;
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_HEVC_START_CODE);
+	start_code = ctrl ? ctrl->cur.val : V4L2_STATELESS_HEVC_START_CODE_ANNEX_B;
+
+	/*
+	 * The message this function builds needs all five descriptors and at
+	 * least one slice: the picture words read SPS, PPS and decode_params,
+	 * D64..D319 always copy the scaling matrix, and the slice chain
+	 * anchored in D63 has to have a first slot.
+	 *
+	 * What is worth saying is which half of it is reachable. Every control
+	 * named above is registered by histb_vdec_hevc_ctrls[] at the bottom of
+	 * this file, a compound control has storage from registration onward,
+	 * and the control core clamps a write to a dynamic array to the
+	 * registered dimensions (v4l2-ctrls-api.c: an oversized request is cut
+	 * to .dims[0] elements and answers ENOSPC, a zero-sized one answers
+	 * EFAULT), so no pointer here can be NULL and n_slices can be neither 0
+	 * nor larger than the 8 entries the slice control declares. That makes
+	 * this line and the pool-count check below assertions of the uAPI
+	 * contract rather than gates with an observed trigger; a refusal would
+	 * still reach the client as a capture buffer with bytesused 0, which is
+	 * the only signal a refusal gives on this engine. TODO: one host-side
+	 * run of VIDIOC_S_EXT_CTRLS on V4L2_CID_STATELESS_HEVC_SLICE_PARAMS at
+	 * size 0 and at 9 elements, reading the ioctl return, is what would let
+	 * both tests be dropped instead of documented.
+	 */
+	if (!run.sps || !run.pps || !run.dec || !run.scaling || !run.slices ||
+	    !n_slices)
+		return -EINVAL;
+
+	/*
+	 * The VDM reconstructs NV21 16x16 tiles: 8-bit 4:2:0 only, because CFG1
+	 * of this decoder generation has no 10-bit enable field. These are
+	 * judged per job, not in a control .try_ctrl(): the handler holds an
+	 * all-zero default which TRY_EXT_CTRLS reads back as if a client had
+	 * set it, and chroma_format_idc 0 is such a default.
+	 */
+	if (run.sps->bit_depth_luma_minus8 || run.sps->bit_depth_chroma_minus8 ||
+	    run.sps->chroma_format_idc != 1 ||
+	    (run.sps->flags & V4L2_HEVC_SPS_FLAG_SEPARATE_COLOUR_PLANE))
+		return -EINVAL;
+	/*
+	 * Tiled pictures are refused: with V4L2_HEVC_PPS_FLAG_TILES_ENABLED the
+	 * engine stops after a partial first frame for every grid shape tried
+	 * on the board, whether or not the tile info image is written. Accepting
+	 * them would need the raster/tile address split the vendor applies, but
+	 * both local encoders emit a single slice per tiled picture, where the
+	 * two orders coincide, so the corpus cannot exercise the split and the
+	 * refusal is the delivered disposition.
+	 */
+	if (run.pps->flags & V4L2_HEVC_PPS_FLAG_TILES_ENABLED)
+		return -EINVAL;
+	/*
+	 * A picture whose SPS declares scaling lists is not decodable here.
+	 * Measured with the flag claimed on an otherwise byte-exact picture:
+	 * the delivered frame differs from the software reference in 147379 of
+	 * the 147456 bytes the picture occupies, and the top-left luma comes
+	 * back zeroed. The submitted matrices are not consulted at all -
+	 * filling every list with 8, 16, 32, or the DC field with 8, or sending
+	 * nothing, all produce byte-identical captures (md5 4264762e... on
+	 * 384x256, 0d8eb4ff... on 1536x128) while the same job without the flag
+	 * is exact. So no re-packing of D64 onwards can fix it, and identity
+	 * lists - which must be a no-op - are already wrong: refusing is the
+	 * only disposition that does not deliver bad pixels. Every stream
+	 * measured on the board so far declares scaling_list_enabled clear, so
+	 * this refuses nothing that decodes correctly today.
+	 */
+	if (run.sps->flags & V4L2_HEVC_SPS_FLAG_SCALING_LIST_ENABLED)
+		return -EINVAL;
+
+	/*
+	 * One slice slot per slice, chained through D63, and the message pool
+	 * holds HISTB_VDEC_MAX_SLICE_SLOTS of them (140 slots of 320 words,
+	 * histb_vdec.h) - which is also the vendor's own limit for one start:
+	 * its slice chain is counted against 140 and the remainder is handed to
+	 * the engine by chain cutting, which clears the link word and starts
+	 * the VDM again. This job path programs once and kicks once per frame,
+	 * so a longer chain has neither storage nor a second doorbell, and the
+	 * whole picture would be described by the first 140 slots while the CTU
+	 * budget in pic[0] and CFG0 still promises every CTB in the grid.
+	 * Accepting one needs that multi-start state machine, with the budget
+	 * and the per-slice up-message area (4 words per slice, histb_vdec.h)
+	 * accounted per segment. The slice control this driver registers
+	 * declares 8 entries and the control core cuts a longer submission to
+	 * that (v4l2-ctrls-api.c), so the bound that a client can actually hit
+	 * is 8; this line states the pool limit in code, which is the one that
+	 * would have to be raised along with a multi-start path.
+	 */
+	if (n_slices > HISTB_VDEC_MAX_SLICE_SLOTS)
+		return -EINVAL;
+
+	payload_bits = vb2_get_plane_payload(&src->vb2_buf, 0) * 8;
+	/*
+	 * An OUTPUT buffer with no payload declares no access unit. Every
+	 * stream address in the message is an offset inside this plane - the
+	 * segment words D0 of each slice and VDM_STREAM_BASE are computed from
+	 * its DMA address and bounded by payload_bits - so with zero bytes
+	 * there is no span to hand the engine and no end to bound any slice's
+	 * declared length by. Padding the declaration is not an option: the VDM
+	 * decodes the bytes it is given and does not re-synchronise on its own
+	 * (histb_h264_pack_rbsp carries the measurement that shows
+	 * it), so an empty span cannot be stretched into a decodable slice. A
+	 * truncated access unit reaches this line only if it carries no slice
+	 * NAL at all; the slice scan below otherwise refuses it on the count.
+	 */
+	if (!payload_bits)
+		return -EINVAL;
+	run.src_dma = histb_vdec_src_dma(&src->vb2_buf);
+	run.stream_va = histb_vdec_src_va(&src->vb2_buf);
+	run.dst_dma = histb_vdec_frame_dma(ctx, &dst->vb2_buf);
+	if (!run.dst_dma)
+		return -ENOMEM;
+	run.num_slices = n_slices;
+
+	if (start_code == V4L2_STATELESS_HEVC_START_CODE_ANNEX_B) {
+		stream_va = histb_vdec_src_va(&src->vb2_buf);
+		/*
+		 * Delimiting slices in the Annex-B form needs the bytes: the
+		 * message ABI carries no field that names where a NAL starts -
+		 * each slice slot only gets its own header-relative offset, and
+		 * the chain anchor in pic D63 points at message slots, not at
+		 * stream positions - so slice_starts[] can only come from a
+		 * scan of the plane. The OUTPUT queue keeps a kernel mapping
+		 * for exactly this reason - histb_vdec_drv.c deliberately
+		 * leaves DMA_ATTR_NO_KERNEL_MAPPING off that queue - so landing
+		 * on this exit means that promise was broken rather than that
+		 * the client did something wrong, which is why the
+		 * once-per-boot warning is the client-visible part. Accepting a
+		 * buffer without a mapping would need per-NAL offsets from the
+		 * client, which the stateless HEVC control set has no field
+		 * for, or the start-code-detection up-message the vendor
+		 * firmware uses, which this port does not implement (it kicks
+		 * the VDM directly).
+		 */
+		if (!stream_va) {
+			dev_warn_once(dev->dev,
+				      "OUTPUT queue has no kernel mapping, cannot delimit "
+				      "slices\n");
+			return -EINVAL;
+		}
+		found = histb_hevc_find_slice_nals(stream_va, payload_bits / 8,
+						   slice_starts,
+						   ARRAY_SIZE(slice_starts));
+		/*
+		 * The number of slice NALs found must be the number of
+		 * slice-parameter entries submitted: each entry is handed its
+		 * own stream span, so a count mismatch means the two lists
+		 * cannot be paired and some slice would address the wrong NAL
+		 * while another NAL is described by no slot at all. This is
+		 * also the implicit rejection of slice carriers the message ABI
+		 * cannot describe - the scan counts nal_unit_type 0..9 and
+		 * 16..23 only, so a picture carried by the temporal-sub-layer
+		 * or random-access types 10..13, or a buffer whose slice NALs
+		 * are interleaved with something the scan skipped, is refused
+		 * on the count rather than decoded from a span that starts in a
+		 * NAL the engine cannot parse (the H.264 path rejects data
+		 * partitioning the same way, counting only types 1 and 5).
+		 * Measured on the board: declaring two slice entries for an
+		 * access unit that carries one IDR slice NAL is refused before
+		 * the doorbell - no "job programmed" line appears and the
+		 * picture slot keeps the previous legal job's bytes - while an
+		 * AU of VPS, SPS, PPS, prefix SEI and one IDR NAL counts
+		 * exactly 1, which is what every scored stream submits.
+		 */
+		if (found != n_slices)
+			return -EINVAL;
+	} else {
+		/*
+		 * Without start codes the slices in the OUTPUT buffer cannot be
+		 * delimited, so a single-slice submission is the only layout
+		 * the driver can consume.
+		 *
+		 * The reason it can be no wider is that this route has neither
+		 * half of the delimiting input: there is no start code to scan
+		 * (that is what the control value declares), and the port has
+		 * no start-code-detection up-message to take boundaries from,
+		 * since the driver kicks the VDM directly. With one slice the
+		 * whole buffer is the span, so nothing has to be delimited.
+		 * Measured on the board, a single-slice submission with
+		 * START_CODE_NONE is accepted and the engine is kicked for it,
+		 * so this is the shape the route serves, not a missed gate.
+		 * Accepting more than one slice needs per-slice NAL offsets
+		 * from the client, which the stateless HEVC controls cannot
+		 * express; the scored corpus all arrives through the Annex-B
+		 * route, so this path is covered by direct submissions only.
+		 */
+		if (n_slices != 1)
+			return -EINVAL;
+		slice_starts[0] = 0;
+	}
+
+	ret = histb_hevc_pack_rbsp(ctx, &run, slice_starts, n_slices,
+				   &payload_bits);
+	if (ret)
+		return ret;
+
+	/*
+	 * A picture with no columns or no rows is refused because everything
+	 * downstream divides by or subtracts from the grid it makes: width_ctbs
+	 * and height_ctbs become 0, so pic[0]'s (width_ctbs - 1) and
+	 * (height_ctbs - 1) fields and the CTU budget in CFG0 wrap to their
+	 * maximum, ctu_count - 1 underflows in histb_hevc_program_regs(), the
+	 * raster coordinates in slot[9] divide by zero, and the last slice's
+	 * range end becomes 0 - 1. These two SPS fields are the luma size of
+	 * every decoded picture in H.265 7.4.3.2 and have no zero reading
+	 * there, so a conformant client never hits this. Measured on the board:
+	 * a SPS with pic_width_in_luma_samples 0 is refused before the
+	 * doorbell - no "job programmed" line and the picture slot keeps the
+	 * previous legal job's bytes - and with the rest of the descriptor
+	 * legal this is the gate that sees it.
+	 */
+	if (!run.sps->pic_width_in_luma_samples ||
+	    !run.sps->pic_height_in_luma_samples)
+		return -EINVAL;
+	run.width = run.sps->pic_width_in_luma_samples;
+	run.height = run.sps->pic_height_in_luma_samples;
+	run.ctb_log2 = run.sps->log2_min_luma_coding_block_size_minus3 + 3 +
+		       run.sps->log2_diff_max_min_luma_coding_block_size;
+	/*
+	 * CtbLog2SizeY is the unit the whole geometry is counted in: it sizes
+	 * pic[0]'s CTB grid and reaches pic[2] bits 2:0 verbatim, it is the CTU
+	 * budget in CFG0, the per-slice range words D43/D44, the 64-row grid
+	 * alignment the capture geometry reserves
+	 * (histb_vdec_hevc_fmt.grid_align), and the row count the chroma plane
+	 * sits behind. The two SPS fields it is summed from arrive as
+	 * independent client values, and the CTB range H.265 wants is a
+	 * conformance rule (7.4.3.2 with the Annex A profile limits) that the
+	 * control layer cannot enforce, so the range this engine is known to
+	 * work in has to be asserted here. Measured on the board: a descriptor
+	 * whose derived CTB size is 128 (log2 7) is refused before the
+	 * doorbell, while CTB 32 and CTB 64 are both decoded byte-exact across
+	 * the scored corpus, including the single-CTB-row and height-scan
+	 * families at those two sizes. TODO: no picture with a 16-sample CTB
+	 * (log2 4) has been decoded on the board; one would show whether the
+	 * lower bound is 4 or the engine's own minimum is 5, and whether an
+	 * 8-sample CTB merely wastes grid rows or is refused by the hardware.
+	 */
+	if (run.ctb_log2 < 4 || run.ctb_log2 > 6)
+		return -EINVAL;
+	run.width_ctbs = (run.width + (1u << run.ctb_log2) - 1) >> run.ctb_log2;
+	run.height_ctbs = (run.height + (1u << run.ctb_log2) - 1) >> run.ctb_log2;
+	/*
+	 * The last CTB row's tail only comes out when another row boundary
+	 * follows it, so a picture one CTB row tall is delivered missing a
+	 * constant 1280 bytes per 256-byte luma tile column - 11 of its 16 rows
+	 * written - plus 3 of every chroma tile's 8 rows, and those bytes are
+	 * not present anywhere else in the capture buffer, so a limited parse
+	 * plus a copy cannot rebuild the tail either. Two CTB rows, or a coded
+	 * height that lands mid-row, are byte-exact, so this is not a general
+	 * bottom-edge defect and there is nothing to work around at one row.
+	 * Refuse the job instead of delivering a frame short by a band: the
+	 * caller falls back to software.
+	 */
+	if (run.height_ctbs < 2)
+		return -EINVAL;
+	run.ctu_count = run.width_ctbs * run.height_ctbs;
+
+	/*
+	 * PMV slot geometry follows the stream resolution with a 1080p floor;
+	 * the pool grows on demand, which invalidates the slot ids of earlier
+	 * frames.
+	 */
+	w_mb = (run.width + 15) / 16;
+	h_mb = (run.height + 15) / 16;
+	needed = max_t(unsigned int, HISTB_HEVC_PMV_SLOT_SIZE(w_mb, h_mb),
+		       HISTB_HEVC_PMV_SLOT_SIZE_MIN);
+	ret = histb_vdec_cap_dims(ctx, &cap_w, &cap_h);
+	if (ret)
+		return ret;
+	/*
+	 * The coded picture has to fit the negotiated CAPTURE rectangle,
+	 * because the buffer it lands in was sized from that rectangle
+	 * (histb_vdec_buf_geom() takes bytesperline and the luma row count from
+	 * it) while the engine writes its own coded grid: measured on the
+	 * board, two jobs on the same 1920x256 geometry wrote exactly the same
+	 * range, 737280 bytes = 1920 * 256 * 3 / 2, whether the stream carried
+	 * 2472 or 29774 bytes of code, so the extent follows the declared
+	 * picture and not the payload size. A larger coded picture than the
+	 * negotiation would therefore put tiles outside the buffer the client
+	 * was told about, which is why this is refused instead of clamped (and
+	 * the same disposition the rkvdec driver uses).
+	 * histb_vdec_try_fmt_cap() raises the CAPTURE rectangle to whatever the
+	 * client declared on OUTPUT (see histb_vdec_drv.c), so the only way to
+	 * reach this line is an OUTPUT declaration smaller than the SPS
+	 * actually submitted. Measured on the board: a SPS declaring 4000
+	 * columns is refused before the doorbell, and a refusal is visible as
+	 * bytesused 0 on the capture buffer.
+	 */
+	if (run.sps->pic_width_in_luma_samples > cap_w ||
+	    run.sps->pic_height_in_luma_samples > cap_h)
+		return -EINVAL;
+
+	/*
+	 * Band layout comes from the CAPTURE format, so a picture smaller than
+	 * the negotiated rectangle still lands where bytesperline says it does
+	 * (the CTB-derived picture dimensions above keep the coded size: the
+	 * engine decodes no further than the stream).
+	 */
+	histb_vdec_buf_geom(ctx, &run.tile_stride, &run.buf_lines);
+
+	ret = histb_hevc_pmv_pool_grow(ctx, hevc, needed);
+	if (ret)
+		return ret;
+
+	/*
+	 * Map the DPB onto the APC frame table. Capture buffer indexes are the
+	 * APC slots; unreferenced slots point at the output frame like an empty
+	 * vendor APC tail.
+	 */
+	if (dst->vb2_buf.index >= HISTB_HEVC_NUM_APC_SLOTS)
+		return -EINVAL;
+
+	cap_q = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	for (i = 0; i < HISTB_HEVC_NUM_APC_SLOTS; i++) {
+		run.img_addr[i] = lower_32_bits(run.dst_dma);
+		run.apc_poc[i] = 0;
+		run.dpb2apc[i] = HISTB_HEVC_APC_NONE;
+	}
+	/*
+	 * The bound is read before the loop that uses it as an index count, so
+	 * its first job is to keep that loop inside dec->dpb[], which is
+	 * exactly V4L2_HEVC_DPB_ENTRIES_NUM_MAX entries long and is not clamped
+	 * by the control layer against this one-byte count. It is also what the
+	 * message can address: the picture slot carries a 16-word frame table
+	 * (D8..D23) and a 16-word POC table (D26..D41), and the lists in each
+	 * slice slot name those slots as 4-bit ids, so an entry past the
+	 * sixteenth has neither an address nor a slot id even if it could be
+	 * read. The capture queue is held to the same 16 buffers by
+	 * histb_vdec_queue_setup(), so no part of the pipeline can widen past
+	 * it; accepting more would need a slot indirection table outside the
+	 * picture message.
+	 */
+	if (run.dec->num_active_dpb_entries > V4L2_HEVC_DPB_ENTRIES_NUM_MAX)
+		return -EINVAL;
+	for (i = 0; i < run.dec->num_active_dpb_entries; i++) {
+		const struct v4l2_hevc_dpb_entry *entry = &run.dec->dpb[i];
+		struct vb2_buffer *vb;
+
+		vb = vb2_find_buffer(cap_q, entry->timestamp);
+		/*
+		 * A reference has to be a buffer that is actually held out of
+		 * the capture queue: the uAPI names a DPB picture only by the
+		 * timestamp of its capture buffer, and this driver's frame
+		 * storage model makes that buffer index the APC slot - the same
+		 * index writes the frame address into D8..D23, the POC into
+		 * D26..D41, and the 4-bit ids the slice lists and the
+		 * collocated picture use. An index at or above the 16 slots
+		 * cannot be encoded there. Passing it through is not a no-op:
+		 * the unused slots are prefilled above with the destination
+		 * address of this very frame, so an entry that resolves to
+		 * nothing silently makes the engine inter-predict from the
+		 * picture it is writing. The refusal is logged with the
+		 * offending entry because the client's only other signal is
+		 * bytesused 0 on the capture buffer, which does not say which
+		 * timestamp it named wrongly.
+		 */
+		if (!vb || vb->index >= HISTB_HEVC_NUM_APC_SLOTS) {
+			dev_dbg(dev->dev, "hevc refuse: dpb %u ts=%llu not queued (active=%u "
+				"dst=%u)\n",
+				i, entry->timestamp,
+				run.dec->num_active_dpb_entries,
+				dst->vb2_buf.index);
+			return -EINVAL;
+		}
+
+		run.dpb2apc[i] = vb->index;
+		run.img_addr[vb->index] =
+			lower_32_bits(histb_vdec_frame_dma(ctx, vb));
+		if (!run.img_addr[vb->index])
+			return -ENOMEM;
+		run.apc_poc[vb->index] = entry->pic_order_cnt_val;
+	}
+	run.apc_poc[dst->vb2_buf.index] = run.dec->pic_order_cnt_val;
+
+	pic = histb_vdec_pic_slot(&dev->pool);
+	histb_hevc_assemble_pic(dev, ctx, hevc, &run,
+				histb_hevc_pmv_alloc(ctx, dst->vb2_buf.index),
+				pic);
+
+	for (i = 0; i < n_slices; i++) {
+		u32 nal_bit = slice_starts[i];
+		u32 next_bit = i + 1 < n_slices ? slice_starts[i + 1] :
+						  payload_bits;
+
+		/*
+		 * A slice that starts at or past the end of the CTB grid has no
+		 * CTB to write. The range words are built from these addresses:
+		 * D43/D44 of a slice carry its CTB range end, computed as the
+		 * next slice's start minus one and, for the last slice, as
+		 * ctu_count - 1 (the vendor's arithmetic for the last CTB of
+		 * the slice, which it writes in raster order to D43 and tile
+		 * order to D44), so an address outside the grid makes the
+		 * previous slice's range overshoot the picture while the raster
+		 * coordinates in D9 (address / width_ctbs, address %
+		 * width_ctbs) name a CTB row that does not exist. H.265 7.4.3
+		 * requires a slice's segment address to map inside
+		 * PicSizeInCtbsY (the raster/tile mapping itself is 6.5.1), so
+		 * this refuses no conformant stream; measured over the 96
+		 * scored streams the address checks never fired - the refusals
+		 * on record are the tiled and the single-CTB-row shapes.
+		 */
+		if (run.slices[i].slice_segment_addr >= run.ctu_count)
+			return -EINVAL;
+		/*
+		 * The vendor start path covers a first slice that does not
+		 * begin at CTB 0 with a one-bit dummy slice; that path is not
+		 * implemented here, so such frames are refused rather than
+		 * handed to the engine with a chain that starts mid-picture.
+		 */
+		if (!i && run.slices[i].slice_segment_addr)
+			return -EINVAL;
+		/*
+		 * The chain is a partition of the CTB grid: each slice's range
+		 * end (D43/D44) is the next slice's start minus one, so an
+		 * address that repeats or goes backwards puts the previous
+		 * slot's end at or below its own start while this slot claims a
+		 * range another slot already covers. Nothing can be clamped
+		 * here without dropping CTBs out of every window, which is what
+		 * the engine would then be told to skip. H.265 7.4.3 emits
+		 * slice addresses in increasing raster order, and this never
+		 * fired on anything measured so far: the scored corpus carries
+		 * one slice per picture, so the multi-slice chains that
+		 * exercise it are H.264's. TODO: one HEVC picture submitted as
+		 * two increasing slices and scored byte-exact would show that
+		 * the range arithmetic holds at the boundary between the two
+		 * slots.
+		 */
+		if (i && run.slices[i].slice_segment_addr <=
+		    run.slices[i - 1].slice_segment_addr)
+			return -EINVAL;
+
+		ret = histb_hevc_assemble_slice(dev, ctx, hevc, &run, i,
+						nal_bit, next_bit,
+						payload_bits);
+		if (ret) {
+			dev_dbg(dev->dev, "hevc refuse: slice %u seg=%u l0=%u l1=%u col=%u "
+				"flags=%#llx dbo=%u bits=%u\n",
+				i, run.slices[i].slice_segment_addr,
+				run.slices[i].num_ref_idx_l0_active_minus1,
+				run.slices[i].num_ref_idx_l1_active_minus1,
+				run.slices[i].collocated_ref_idx,
+				run.slices[i].flags,
+				run.slices[i].data_byte_offset,
+				run.slices[i].bit_size);
+			return ret;
+		}
+	}
+
+	histb_hevc_program_regs(dev, &run);
+	histb_vdec_hw_kick(dev, HISTB_VIDSTD_HEVC);
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_config histb_vdec_hevc_ctrls[] = {
+	{
+		.id = V4L2_CID_STATELESS_HEVC_SPS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_HEVC_PPS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_HEVC_SLICE_PARAMS,
+		.name = "HEVC Slice Parameters",
+		.type = V4L2_CTRL_TYPE_HEVC_SLICE_PARAMS,
+		.dims = { 8 },
+		.flags = V4L2_CTRL_FLAG_DYNAMIC_ARRAY,
+	},
+	{
+		.id = V4L2_CID_STATELESS_HEVC_SCALING_MATRIX,
+	},
+	{
+		.id = V4L2_CID_STATELESS_HEVC_DECODE_PARAMS,
+	},
+	{
+		.id = V4L2_CID_STATELESS_HEVC_DECODE_MODE,
+		.min = V4L2_STATELESS_HEVC_DECODE_MODE_FRAME_BASED,
+		.max = V4L2_STATELESS_HEVC_DECODE_MODE_FRAME_BASED,
+		.def = V4L2_STATELESS_HEVC_DECODE_MODE_FRAME_BASED,
+	},
+	{
+		.id = V4L2_CID_STATELESS_HEVC_START_CODE,
+		.min = V4L2_STATELESS_HEVC_START_CODE_NONE,
+		.max = V4L2_STATELESS_HEVC_START_CODE_ANNEX_B,
+		.def = V4L2_STATELESS_HEVC_START_CODE_ANNEX_B,
+	},
+};
+
+static const struct histb_vdec_codec_ops histb_vdec_hevc_codec_ops = {
+	.start = histb_vdec_hevc_start,
+	.stop = histb_vdec_hevc_stop,
+	.run = histb_vdec_hevc_run,
+};
+
+const histb_vdec_fmt_desc histb_vdec_hevc_fmt = {
+	.fourcc = V4L2_PIX_FMT_HEVC_SLICE,
+	.stride = histb_vdec_hevc_stride,
+	.grid_align = 64,
+	.num_ctrls = ARRAY_SIZE(histb_vdec_hevc_ctrls),
+	.ctrls = histb_vdec_hevc_ctrls,
+	.ops = &histb_vdec_hevc_codec_ops,
+	.vidstd = HISTB_VIDSTD_HEVC,
+};
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_hw.c b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_hw.c
new file mode 100644
index 000000000000..56c3af22b2da
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_hw.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * VDM hardware sequencing for the HiSilicon VDH v2 video decoder.
+ *
+ * The VDM is started by a doorbell register and reports completion through a
+ * single level-triggered interrupt; the message pool it reads and writes is a
+ * plain DMA region prepared by the codec layers.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/regmap.h>
+#include <linux/bitfield.h>
+#include <linux/build_bug.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/reset.h>
+
+#include "histb_vdec_v2.h"
+#include "histb_vdec_v2_tables_h264.h"
+#include "histb_vdec_v2_tables_hevc.h"
+
+/**
+ * histb_vdec_hw_init() - prepare the VDM register interface
+ * @dev: decoder device
+ *
+ * Masks every interrupt source and drops anything latched across the reset.
+ * Runs once at probe, after the reset is released and before the interrupt
+ * handler is registered; the per-frame start path unmasks the frame-done source
+ * again.
+ *
+ * Return: 0 on success, a negative error code otherwise.
+ */
+int histb_vdec_hw_init(struct histb_vdec_dev *dev)
+{
+	vdm_write(dev, VDM_INT_MASK, 0xffffffff);
+	vdm_write(dev, VDM_INT_STATE, 0xffffffff);
+
+	return 0;
+}
+
+/**
+ * histb_vdec_hw_reset() - pulse the VDM main FSM reset
+ * @dev: decoder device
+ *
+ * Asserts the decoder reset line for a short pulse and re-applies the
+ * all-masked interrupt state, which the reset clears. Used to recover from a
+ * wedged frame.
+ */
+void histb_vdec_hw_reset(struct histb_vdec_dev *dev)
+{
+	reset_control_assert(dev->rst);
+	usleep_range(10, 20);
+	reset_control_deassert(dev->rst);
+
+	vdm_write(dev, VDM_INT_MASK, 0xffffffff);
+	vdm_write(dev, VDM_INT_STATE, 0xffffffff);
+}
+
+
+/**
+ * histb_vdec_hw_kick() - start decoding of the programmed frame
+ * @dev: decoder device
+ * @std: protocol of the frame about to be decoded
+ *
+ * Selects the protocol's clock gating mode in the SCD block's global register
+ * window (0 for HEVC, 3 for every other protocol) and rings the VDM doorbell
+ * with the 0-1-0 write sequence the start logic expects.
+ */
+void histb_vdec_hw_kick(struct histb_vdec_dev *dev, enum histb_vdec_vidstd std)
+{
+	writel(std == HISTB_VIDSTD_HEVC ? VDH_CK_GT_HEVC : VDH_CK_GT_OTHER,
+	       dev->scd + SCD_VDH_CK_GT);
+
+	/* Drain the message pool writes before ringing the doorbell. */
+	wmb();
+
+	vdm_write(dev, VDM_START, 0);
+	vdm_write(dev, VDM_START, 1);
+	vdm_write(dev, VDM_START, 0);
+}
+
+/**
+ * histb_vdec_hw_init_tables() - program the constant protocol tables
+ * @dev: decoder device
+ *
+ * Copies the CABAC M/N tables of H.264 and HEVC into the table area of the
+ * message pool, from where the VDM fetches them by DMA. The VDM expects them at
+ * fixed offsets once per probe; they are read-only afterwards.
+ */
+void histb_vdec_hw_init_tables(struct histb_vdec_dev *dev)
+{
+	void *tables = histb_vdec_tables_base(&dev->pool);
+	unsigned int i;
+
+	BUILD_BUG_ON(HISTB_TABLE_OFF_CABAC_MN_H264 +
+		     HISTB_VDEC_CABAC_MN_H264_SIZE >
+		     HISTB_TABLE_OFF_CABAC_MN_HEVC);
+	BUILD_BUG_ON(HISTB_TABLE_OFF_CABAC_MN_HEVC +
+		     HISTB_VDEC_CABAC_MN_HEVC_SIZE >
+		     HISTB_TABLE_OFF_TILE_INFO);
+	BUILD_BUG_ON(HISTB_TABLE_OFF_TILE_INFO + HISTB_VDEC_TILE_INFO_SIZE >
+		     HISTB_TABLE_OFF_PPFD);
+	BUILD_BUG_ON(HISTB_TABLE_OFF_PPFD + HISTB_VDEC_PPFD_SIZE >
+		     HISTB_TABLE_OFF_SCRATCH_BASE);
+
+	memcpy(tables + HISTB_TABLE_OFF_CABAC_MN_H264,
+	       histb_vdec_cabac_mn_h264, HISTB_VDEC_CABAC_MN_H264_SIZE);
+
+	/*
+	 * The HEVC table is stored as readable (m, n) pairs; the vendor loader
+	 * finishes with a byte-swap pass that interleaves every pair as (n, m)
+	 * in memory, which is what the hardware fetcher expects. The H.264
+	 * loader does not swap.
+	 */
+	for (i = 0; i < HISTB_VDEC_CABAC_MN_HEVC_SIZE / 4; i++) {
+		u32 v = histb_vdec_cabac_mn_hevc[i];
+
+		v = ((v & 0xff00ff00) >> 8) | ((v & 0x00ff00ff) << 8);
+		((u32 *)tables)[HISTB_TABLE_OFF_CABAC_MN_HEVC / 4 + i] = v;
+	}
+
+	/*
+	 * Every HEVC picture message points at the tile info image, but untiled
+	 * pictures decode with it all zero and the HEVC run path refuses tiled
+	 * ones, so it is programmed once here rather than per frame.
+	 */
+	memset(tables + HISTB_TABLE_OFF_TILE_INFO, 0,
+	       HISTB_VDEC_TILE_INFO_SIZE);
+}
+
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_mpeg2.c b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_mpeg2.c
new file mode 100644
index 000000000000..f3430218a389
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_mpeg2.c
@@ -0,0 +1,1113 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon VDH v2 stateless MPEG-1/MPEG-2 decoder (V4L2 codec layer).
+ * The hardware consumes a fully parsed picture header packed into the
+ * downstream message pool (slot words D0-D63) plus a slice descriptor list, the
+ * two 64-byte quantisation matrices carried in the picture slot itself
+ * (D16-D47), and the usual per-frame register set.
+ *
+ * The message layout below was re-derived from the packing loops the vendor
+ * firmware runs for MPEG-2 - the picture message, the slice descriptors and the
+ * per-frame registers - and then checked against board behaviour wherever the
+ * field is observable.
+ *
+ * Known syntax gaps against V4L2_CID_STATELESS_MPEG2_*: the control set has no
+ * mpeg1_flag / full_pel_*_vector, so the hardware fields are always written 0,
+ * i.e. MPEG-1 streams and full-pel motion vectors are not supported. Slices are
+ * found by scanning the submitted span for slice_start_codes; a picture whose
+ * slices do not tile the macroblock grid in raster order is rejected.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/kernel.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "histb_vdec_v2.h"
+
+/*
+ * Band-line scratch area inside the pool table region: eight 480 KiB buffers,
+ * one per enum histb_vdec_scratch entry. MPEG-2 references only PMV_TOP (D7
+ * current_pmv_addr and D48 pmv_top_addr); the SED/RCN/DBLK line buffers of this
+ * protocol are internal to the hardware.
+ */
+
+/* The vendor firmware's MPEG-2 packer adds 24 dummy bits to both picture-level
+ * segment lengths.
+ */
+#define HISTB_MPEG2_DUMMY_BITS		24
+
+/*
+ * Slot words D0..D7 of the picture message: two stream segments (the second is
+ * unused here), quantiser_scale_code with intra_slice, the macroblock range and
+ * the chain pointer.
+ *
+ * The vendor firmware's MPEG-2 slice packer lays these descriptors out as an
+ * array of 32-byte entries: it indexes them by slot number times 32 and points
+ * each entry's chain word at the following entry. That stride is smaller than
+ * the shared HISTB_VDEC_SLOT_BYTES the H.264 and HEVC messages need, and with
+ * the wide stride the MPEG-2 engine finished every picture without reading a
+ * single bit of it (the reconstruction was the same for three different streams
+ * on the same boot), so the slice descriptors are packed at the narrow stride.
+ */
+#define HISTB_MPEG2_SLC_BYTES		32
+
+/* picture_coding_type travels through the control as the stream value. */
+#define HISTB_MPEG2_PIC_I		1
+#define HISTB_MPEG2_PIC_P		2
+#define HISTB_MPEG2_PIC_B		3
+
+/* picture_structure 6.2.23.1: 1 = top field, 2 = bottom field, 3 = frame. */
+#define HISTB_MPEG2_STRUCT_FRAME	3
+
+static void *histb_vdec_mpeg2_slc_slot(const struct histb_vdec_msgpool *p,
+				       unsigned int i)
+{
+	return p->va + p->slice_off + i * HISTB_MPEG2_SLC_BYTES;
+}
+
+static dma_addr_t
+histb_vdec_mpeg2_slc_slot_dma(const struct histb_vdec_msgpool *p, unsigned int i)
+{
+	return p->dma + p->slice_off + i * HISTB_MPEG2_SLC_BYTES;
+}
+
+/*
+ * MPEG-1 has no per-picture f_code: 11172-1 keeps one forward and one
+ * backward code in the GOP header, and the encoders in use write 1. A
+ * control that leaves the field 0 says nothing about the picture, and
+ * r=0 is not a range the engine can use: measured on the board, the two
+ * P pictures of a 352x288 MPEG-1 stream stopped at 327 and 390 of 396
+ * macroblocks with 0 and were covered in full with 1 (2 and 7 stayed
+ * short).
+ */
+static u8 histb_vdec_mpeg2_fcode(bool mpeg1, u8 fc)
+{
+	return mpeg1 && !fc ? 1 : fc;
+}
+
+static void histb_vdec_mpeg2_pack_slice(u32 *w, u32 data_bit,
+					u32 end_bit, u32 buf_end_bit, u32 qsc,
+					u32 intra,
+					u32 start_mbn, u32 end_mbn,
+					dma_addr_t next_dma)
+{
+	u32 len_end = end_bit;
+
+	/*
+	 * The vendor firmware gives each slice the bits still buffered after
+	 * its header: it points the window at the slice's first data bit and
+	 * declares the rest of the packet. A window cut at the next
+	 * slice_start_code decodes the same pictures, so the shorter,
+	 * self-contained span is used here. Only the picture level segments
+	 * carry the +24 of HISTB_MPEG2_DUMMY_BITS.
+	 *
+	 * Nothing is trimmed off the end: MPEG-2 has no RBSP stop bit - a slice
+	 * ends where the next start code begins - and the engine counts the
+	 * whole declared length as macroblock layer. Cutting the trailing
+	 * zeros, as the H.264 and HEVC paths do, eats the last bits of any
+	 * codeword ending in a zero, and a level-64 escape (`000001` + run +
+	 * `000001000000`) always does. It was on single-coefficient probes at
+	 * seven scan positions: with the trim 19 of 20 macroblocks hit the
+	 * theoretical amplitude and the last came out at exactly half; skipping
+	 * the trim gives 20 of 20. No corpus stream changed verdict either way,
+	 * so this is conformance rather than score.
+	 *
+	 * The segment is addressed as a byte granule offset plus a bit offset
+	 * inside that granule, both measured from the programmed stream base -
+	 * the same arithmetic as the H.264 path. Passing the plane start
+	 * address with an absolute bit offset instead drops the byte part, and
+	 * then every slice decodes from the first 16 bytes of the span.
+	 */
+	w[0] = FIELD_PREP(GENMASK(23, 0), len_end - data_bit) |
+	       FIELD_PREP(GENMASK(30, 24), data_bit & 127U);
+	w[1] = (data_bit / 8) & ~15U;
+	w[2] = 0;
+	w[3] = 0;
+	w[4] = FIELD_PREP(GENMASK(5, 0), qsc) | FIELD_PREP(BIT(6), intra);
+	w[5] = FIELD_PREP(GENMASK(19, 0), start_mbn);
+	w[6] = FIELD_PREP(GENMASK(19, 0), end_mbn);
+	w[7] = next_dma & ~15U;
+}
+
+/*
+ * Decode one slice header. @p points at the first byte after the 32-bit start
+ * code, @code is that start code's low byte and @idx the index of this slice in
+ * the picture. Returns the row where the slice starts, its quantiser scale code
+ * and how many bits of header follow the start code.
+ */
+/*
+ * Read @n bits of a slice header, bit 0 being the most significant bit of
+ * @p[0]. No field of 6.2.2.4 is wider than eight bits, so @n stays in 1..8 and
+ * the window never leaves the four bytes the caller has already checked.
+ */
+static unsigned int histb_vdec_mpeg2_hdr_bits(const u8 *p, unsigned int pos,
+					     unsigned int n)
+{
+	unsigned int val = 0;
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		val = val << 1 |
+		      ((p[(pos + i) / 8] >> (7 - (pos + i) % 8)) & 1U);
+	return val;
+}
+
+/*
+ * Decode one slice header (6.2.2.4). @p points at the first byte after the
+ * 32-bit slice_start_code, @code is that start code's low byte and @idx the
+ * index of this slice in the picture. Returns the macroblock row the slice
+ * starts on, its quantiser scale code, its intra_slice flag and how many bits
+ * of header follow the start code.
+ *
+ * The MPEG-2 form is slice_vertical_position (8 bits when progressive_sequence
+ * is set, otherwise a 3-bit extension plus 7 bits), slice_horizontal_position,
+ * quantiser_scale_code (1..31), intra_slice_flag and, when that is set,
+ * intra_slice plus seven reserved bits, then extra_bit_slice. Field pictures,
+ * slices that start mid-row and MPEG-1's extra_image_information are rejected
+ * rather than decoded at a guessed bit position.
+ *
+ * ffmpeg's MPEG-1/MPEG-2 encoder (mpeg12enc.c ff_mpeg1_encode_slice_header())
+ * writes a short form for both codecs: the row sits in the start code's low
+ * byte and only quantiser_scale_code plus the extra bit follow. Streams
+ * produced and reference decoded by ffmpeg therefore need that form, and one
+ * further legacy shape is accepted where the vertical position reads as zero
+ * and the quantiser follows immediately after it.
+ *
+ * A picture detected as MPEG-1 never reaches those shapes: 11172-1 gives it
+ * a header of its own, and its start code names the row the slice starts on
+ * rather than its place in the picture, so one slice may cover several rows.
+ */
+static int histb_vdec_mpeg2_slice_hdr(const u8 *p, unsigned int code,
+				      bool progressive, bool mpeg1,
+				      unsigned int mb_height,
+				      unsigned int idx, unsigned int *row,
+				      unsigned int *qsc, unsigned int *intra,
+				      unsigned int *hdr_bits)
+{
+	unsigned int bits = progressive ? 8 : 10;
+	unsigned int vpos, flag;
+
+	if (mpeg1) {
+		/*
+		 * ISO/IEC 11172-1 6.2.2.4 gives a slice header of
+		 * quantiser_scale_code (5) and extra_bit_slice (1) after the
+		 * vertical position that the start code already carries, and
+		 * no intra_slice_flag: that field is a 13818-2 addition. The
+		 * reference decoder reads exactly these six bits (mpeg12dec.c
+		 * mpeg_decode_slice()), and one slice may span several rows,
+		 * so the row comes from the start code and not from the
+		 * slice's place in the picture.
+		 */
+		if (code < 1 || code > 0x8f || p[0] < 0x08 || p[0] & 0x04)
+			return -EINVAL;
+		*qsc = p[0] >> 3;
+		*intra = 0;
+		*row = code - 1;
+		*hdr_bits = 6;
+		return 0;
+	}
+
+	if (progressive) {
+		vpos = histb_vdec_mpeg2_hdr_bits(p, 0, 8);
+	} else {
+		/*
+		 * slice_vertical_position_extension (13818-2 6.2.2.4) is only
+		 * ever non-zero on pictures this driver refuses on other
+		 * grounds: the field pictures of a non-progressive sequence,
+		 * which histb_vdec_mpeg2_run() rejects on picture_structure,
+		 * and the 4:2:2 variant its chroma_format gate rejects. Nothing
+		 * here could use a non-zero value either: @row becomes
+		 * start_mbn = row * mb_width and D0 budgets a single frame
+		 * grid, so a slice naming a row beyond it has no addressable
+		 * macroblock range and is refused rather than placed at a
+		 * guessed row. This arm has never been measured on a conformant
+		 * stream - the only headers built here that set it wrote the
+		 * quantiser at a wrong offset, which the reference decoder
+		 * itself rejects (qscale == 0) - so settling it needs a legal
+		 * MPEG-2 form slice header on a field picture, which the local
+		 * encoder does not produce.
+		 */
+		if (histb_vdec_mpeg2_hdr_bits(p, 0, 3))
+			return -EINVAL;
+		vpos = histb_vdec_mpeg2_hdr_bits(p, 3, 7);
+	}
+
+	/*
+	 * quantiser_scale_code is 1..31 (0 is forbidden) and a row-aligned
+	 * slice carries horizontal position 0: together with the vertical
+	 * position naming this slice's row that is enough to tell the two forms
+	 * apart without ever guessing a data position.
+	 */
+	if (vpos == idx + 1 && vpos >= 1 && vpos <= mb_height &&
+	    histb_vdec_mpeg2_hdr_bits(p, bits, 8) == 0) {
+		bits += 8;
+		*qsc = histb_vdec_mpeg2_hdr_bits(p, bits, 5);
+		/*
+		 * 0 is the single quantiser_scale_code value 13818-2 6.2.2.4
+		 * forbids, and the upper bound only restates the range of the
+		 * 5-bit field, so a rejection here means the walk landed on the
+		 * wrong bits rather than on an unusual stream: the probes that
+		 * misplaced this field are the only corpus members the
+		 * reference decoder ever called qscale == 0. With the parse in
+		 * place the arm costs nothing - the scored MPEG-2 corpus is 68
+		 * valid inputs, and this gate refused 0 of them.
+		 */
+		if (!*qsc || *qsc > 31)
+			return -EINVAL;
+		bits += 5;
+		flag = histb_vdec_mpeg2_hdr_bits(p, bits, 1);
+		bits += 1;
+		if (flag) {
+			*intra = histb_vdec_mpeg2_hdr_bits(p, bits, 1);
+			bits += 8;
+		} else {
+			*intra = 0;
+		}
+		/*
+		 * The last header bit of this form, and it has to read 0:
+		 * 13818-2 6.2.2.4 keeps it as the place-holder for MPEG-1's
+		 * extra_image_information, and a set bit opens a trailing field
+		 * that nothing here consumes, so every macroblock after it
+		 * would be read at an offset this driver has not walked.
+		 * Offsets are not tunable at this layer - feeding the engine
+		 * the same macroblock layer one bit short of the header end
+		 * moved every DC level of the picture, +112 against +17, which
+		 * is the measurement that fixed the MPEG-1 arm below - so the
+		 * slice is refused instead.
+		 */
+		if (histb_vdec_mpeg2_hdr_bits(p, bits, 1))
+			return -EINVAL;
+		*row = vpos - 1;
+		*hdr_bits = bits + 1;
+		return 0;
+	}
+
+	if (progressive && !vpos) {
+		/*
+		 * MPEG-1 6.2.2.4 puts extra_bit_slice after intra_slice_flag,
+		 * so both of those bits belong to the header: reading only the
+		 * flag started the macroblock layer one bit early and every
+		 * macroblock level came out wrong (measured with the same
+		 * macroblock layer with and without the conformant bit: +112
+		 * versus +17). Both bits must read 0 here; a slice that sets
+		 * intra_slice_flag is refused rather than mis-parsed.
+		 */
+		*qsc = histb_vdec_mpeg2_hdr_bits(p, 8, 5);
+		if (!*qsc || *qsc > 31 ||
+		    histb_vdec_mpeg2_hdr_bits(p, 13, 2))
+			return -EINVAL;
+		*intra = 0;
+		*row = idx;
+		*hdr_bits = 15;
+		return 0;
+	}
+
+	if (code >= 1 && code <= 0x8f && code - 1 == idx &&
+	    p[0] >= 0x08 && !(p[0] & 0x04)) {
+		*qsc = p[0] >> 3;
+		*intra = 0;
+		*row = code - 1;
+		*hdr_bits = 5 + 1;
+		return 0;
+	}
+
+	/*
+	 * None of the three shapes above matched, so the bit at which this
+	 * slice's macroblock layer starts is unknown. What reaches here is a
+	 * slice that starts mid-row (horizontal position other than 0), a
+	 * vertical position that does not name this slice's row, or MPEG-1's
+	 * extra_image_information. The first two have no representation to
+	 * program even if the position were guessed: the descriptor states its
+	 * range as macroblock numbers derived from row * mb_width, so a mid-row
+	 * start cannot be expressed at all, and a wrong guess costs the whole
+	 * picture rather than one macroblock (see the +112/+17 reading above).
+	 * Accepting the rest needs per-slice geometry from the client, which
+	 * V4L2 defines no MPEG-2 control for.
+	 */
+	return -EINVAL;
+}
+
+/*
+ * Width in bits of the first macroblock_address_increment of a slice (13818-2
+ * Table B-1). The slice segment has to start *after* it: the engine consumes
+ * that codeword itself, so a window opened at the end of the slice header hands
+ * it one codeword too many and the whole macroblock layer misaligns. Measured
+ * on the board: shifting the declared start by this width makes the DC-only
+ * probe pictures byte-exact against the software reference, and only a one-bit
+ * shift does so - which is exactly the width Table B-1 gives increment 1.
+ *
+ * B-1 is canonical and every length group is a contiguous range, so an 11-bit
+ * window is classified by the first group whose left-aligned range contains it.
+ * Stuffing (00000001, 8 bits) may precede the codeword; the escape form
+ * (00000010 + escape_code) and any window matching no group are refused rather
+ * than guessed, because a start wrong by one bit costs the whole picture.
+ */
+static int histb_vdec_mpeg2_first_incr(const u8 *p, unsigned int pos,
+				       unsigned int avail, unsigned int *len)
+{
+	static const struct {
+		unsigned char bits;
+		u16 first;
+		u16 last;
+	} grp[] = {
+		{ 1, 0x001, 0x001 },	/* increment 1 */
+		{ 3, 0x002, 0x003 },	/* 2..3 */
+		{ 4, 0x004, 0x005 },	/* 4..5 */
+		{ 5, 0x008, 0x009 },	/* 6..7 */
+		{ 7, 0x006, 0x007 },	/* 8..9 */
+		{ 8, 0x006, 0x00b },	/* 10..15 */
+		{ 10, 0x012, 0x017 },	/* 16..21 */
+		{ 11, 0x018, 0x023 },	/* 22..33 */
+	};
+	unsigned int i, w11;
+
+	for (;;) {
+		/*
+		 * Classifying needs an 11-bit window, the width of Table B-1's
+		 * longest macroblock_address_increment group (22..33), and
+		 * histb_vdec_mpeg2_hdr_bits() checks no bounds of its own.
+		 * Accepting a shorter span means the rest of the slice.
+		 */
+		if (avail < 11)
+			return -EINVAL;
+
+		w11 = (histb_vdec_mpeg2_hdr_bits(p, pos, 8) << 3) |
+		      histb_vdec_mpeg2_hdr_bits(p, pos + 8, 3);
+
+		if ((w11 >> 3) == 0x01) {	/* stuffing_code */
+			pos += 8;
+			avail -= 8;
+			continue;
+		}
+		/*
+		 * The escape form (`00000010` + escape_code) is the one shape
+		 * whose width Table B-1 does not give, so no window start
+		 * follows from it, and a start wrong by one bit costs the whole
+		 * picture. TODO: pin the escape codeword's width on a slice
+		 * that skips past the 33 the table reaches.
+		 */
+		if ((w11 >> 3) == 0x02)		/* escape form: unmeasured width */
+			return -EINVAL;
+
+		for (i = 0; i < ARRAY_SIZE(grp); i++) {
+			unsigned int code = w11 >> (11 - grp[i].bits);
+
+			if (code >= grp[i].first && code <= grp[i].last) {
+				*len = grp[i].bits;
+				return 0;
+			}
+		}
+		/*
+		 * None of Table B-1's eight groups owns this window, and the
+		 * groups are contiguous and left-aligned, so this is not a
+		 * macroblock_address_increment codeword and the walk is not at
+		 * the slice's data start; recovering it would mean decoding the
+		 * macroblock layer; 0 of 68 inputs reach it.
+		 */
+		return -EINVAL;
+	}
+}
+
+/*
+ * Fill the slice descriptor chain of one picture; returns the number of slots
+ * written or a negative error.
+ *
+ * histb_vdec_mpeg2_slice_hdr() parses each header (6.2.2.4 plus the MPEG-1 form
+ * ffmpeg's encoder writes) and the descriptors delimit exactly the bits it
+ * identifies as slice_data().
+ *
+ * Slices that do not tile the picture in raster order, that start in the middle
+ * of a macroblock row, or that carry an out-of-range quantiser are rejected:
+ * the hardware gets an explicit macroblock range per slice, so an unsupported
+ * shape must not silently decode at the wrong place.
+ *
+ * Each slice needs its own descriptor: the engine stops a slice's macroblock
+ * layer at that slice's end_mbn and continues in the slot D7 points at, so a
+ * single descriptor for a whole multi-slice picture makes it read the following
+ * slice_start_code as macroblock data and time the job out.
+ */
+static int histb_vdec_mpeg2_pack_slices(struct histb_vdec_msgpool *pool,
+					const u8 *buf, unsigned int size,
+					bool progressive, bool mpeg1,
+					unsigned int mb_width,
+					unsigned int mb_total,
+					dma_addr_t stream_base,
+					dma_addr_t data_addr)
+{
+	unsigned int mb_height = mb_total / mb_width;
+	unsigned int i = 0, slot = 0, end_bit = size * 8;
+	unsigned int prev_data_bit = 0, prev_qsc = 0, prev_start_mbn = 0;
+	unsigned int prev_intra = 0;
+	bool have_prev = false;
+
+	while (i + 7 < size) {
+		unsigned int hdr_bit = i * 8, data_bit, mbn, qsc, code, row;
+		unsigned int intra, hdr_bits, inc_bits;
+
+		if (buf[i] || buf[i + 1] || buf[i + 2] != 1) {
+			i++;
+			continue;
+		}
+		code = buf[i + 3];
+		if (code < 0x01 || code > 0x8f) {
+			/*
+			 * A GOP/picture end or an extension closes the picture.
+			 */
+			if (have_prev) {
+				end_bit = hdr_bit;
+				break;
+			}
+			i += 4;
+			continue;
+		}
+		/*
+		 * A header that matches no accepted form is the whole job, not
+		 * just this slice: its data start is unknown, so the previous
+		 * slice's window cannot be closed against it and this one's
+		 * cannot be opened. histb_vdec_mpeg2_slice_hdr() carries the
+		 * reasons - no mid-row starts, no field pictures, no MPEG-1
+		 * extra information - and the walk cannot substitute a guessed
+		 * position, because a start wrong by one bit misaligns every
+		 * macroblock codeword that follows it.
+		 */
+		if (histb_vdec_mpeg2_slice_hdr(buf + i + 4, code, progressive,
+					       mpeg1, mb_height, slot, &row, &qsc,
+					       &intra, &hdr_bits))
+			return -EINVAL;
+
+		mbn = row * mb_width;
+		/*
+		 * Slices hand the grid over in raster order and start on a
+		 * row: the first opens at row 0, each later one on a row
+		 * after the previous. One slice may span several rows -
+		 * MPEG-1 starts a slice every few rows - so the rule is
+		 * strict increase, not one row per slice: the engine gets
+		 * an explicit macroblock range and walks it. A revisited
+		 * row, a row the picture does not have, or an exhausted
+		 * slot pool is refused rather than trimmed, because the
+		 * engine honours the range it is given and a wrong range
+		 * decodes silently at the wrong place. One slot stays held
+		 * back for the cleared terminator written after the chain.
+		 */
+		if ((!have_prev && mbn) || (have_prev && mbn <= prev_start_mbn) ||
+		    mbn >= mb_total || slot + 1 >= HISTB_VDEC_MAX_SLICE_SLOTS)
+			return -EINVAL;
+		/*
+		 * The vendor's syntax layer consumes
+		 * macroblock_address_increment before recording the window, so
+		 * its declared start is the first mb_type bit.
+		 */
+		data_bit = hdr_bit + 32 + hdr_bits;
+		/*
+		 * No window can be declared without this codeword's width: the
+		 * slice segment starts at the first mb_type bit, and the width
+		 * comes from the codeword itself. histb_vdec_mpeg2_first_incr()
+		 * refuses three shapes - fewer than 11 bits left in the
+		 * submitted span, the escape form (00000010 followed by
+		 * escape_code), whose width is not in Table B-1, and any 11-bit
+		 * window matching no length group - and all three are answered
+		 * here with a refusal of the picture, not a fallback window:
+		 * the reading that pinned the window rule is that a start wrong
+		 * by one bit misaligns every macroblock after it. Stuffing
+		 * before the codeword is skipped by the callee, so only these
+		 * shapes end up here.
+		 */
+		if (histb_vdec_mpeg2_first_incr(buf, data_bit,
+						size * 8 - data_bit, &inc_bits))
+			return -EINVAL;
+		data_bit += inc_bits;
+
+		if (have_prev)
+			histb_vdec_mpeg2_pack_slice(
+				histb_vdec_mpeg2_slc_slot(pool, slot - 1),
+				prev_data_bit, hdr_bit, size * 8,
+				prev_qsc, prev_intra,
+				prev_start_mbn, mbn - 1,
+				histb_vdec_mpeg2_slc_slot_dma(pool, slot));
+		prev_data_bit = data_bit;
+		prev_qsc = qsc;
+		prev_intra = intra;
+		prev_start_mbn = mbn;
+		have_prev = true;
+		slot++;
+		i += 4;
+	}
+
+	/*
+	 * The span holds no slice_start_code in the picture's range at all, so
+	 * there is no macroblock layer to point the engine at: 13818-2 6.2.2.4
+	 * begins every coded picture with a slice header, and a submission
+	 * without one carries picture-level syntax only (a sequence or GOP
+	 * header, or an empty buffer). It cannot be served either as nothing or
+	 * as data: the chain head in D63 would point at a slot this job never
+	 * wrote - the slice area is not cleared per job - while CFG0 still
+	 * announces mb_total macroblocks to decode, so the engine would walk
+	 * bytes that are not macroblock layer. Accepting such a buffer would
+	 * mean the client supplying the slice positions, which the MPEG-2
+	 * controls do not have; nothing in the scored corpus reaches this arm.
+	 */
+	if (!have_prev)
+		return -EINVAL;
+
+	histb_vdec_mpeg2_pack_slice(histb_vdec_mpeg2_slc_slot(pool, slot - 1),
+				    prev_data_bit, end_bit, size * 8,
+				    prev_qsc, prev_intra,
+				    prev_start_mbn, mb_total - 1, 0);
+	/*
+	 * The vendor firmware's MPEG-2 slice packer writes a null chain word
+	 * for the slot whose successor index equals the slice count, so the
+	 * chain ends on a null pointer instead of on a descriptor. The slot
+	 * after the last one stays cleared as well: it is where a follower that
+	 * ignores the null pointer would land.
+	 */
+	memset(histb_vdec_mpeg2_slc_slot(pool, slot), 0, HISTB_MPEG2_SLC_BYTES);
+
+	return slot;
+}
+
+static const struct v4l2_ctrl_config histb_vdec_mpeg2_ctrls[] = {
+	{ .id = V4L2_CID_STATELESS_MPEG2_SEQUENCE },
+	{ .id = V4L2_CID_STATELESS_MPEG2_PICTURE },
+	{ .id = V4L2_CID_STATELESS_MPEG2_QUANTISATION },
+};
+
+static const struct v4l2_ctrl_mpeg2_sequence *
+histb_vdec_mpeg2_seq(struct histb_vdec_ctx *ctx)
+{
+	struct v4l2_ctrl *ctrl;
+
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_MPEG2_SEQUENCE);
+	return ctrl->p_cur.p;
+}
+
+static const struct v4l2_ctrl_mpeg2_picture *
+histb_vdec_mpeg2_pic(struct histb_vdec_ctx *ctx)
+{
+	struct v4l2_ctrl *ctrl;
+
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_MPEG2_PICTURE);
+	return ctrl->p_cur.p;
+}
+
+static const struct v4l2_ctrl_mpeg2_quantisation *
+histb_vdec_mpeg2_quant(struct histb_vdec_ctx *ctx)
+{
+	struct v4l2_ctrl *ctrl;
+
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
+			      V4L2_CID_STATELESS_MPEG2_QUANTISATION);
+	return ctrl->p_cur.p;
+}
+
+/*
+ * Resolve a reference picture named by timestamp, as v4l2_ctrl_mpeg2_picture
+ * documents it (v4l2_timeval_to_ns() of the OUTPUT buffer's timestamp, which
+ * the mem2mem core copies onto the capture buffer the picture is written to).
+ * Returns 0 and fills @addr, -ENOENT when no picture is named (@ts is 0), and
+ * -EINVAL when the name matches no capture buffer the client still holds.
+ */
+static int histb_vdec_ref_addr(struct histb_vdec_ctx *ctx, u64 ts,
+			       dma_addr_t *addr)
+{
+	struct vb2_buffer *vb;
+
+	/*
+	 * A zero timestamp is what the picture control carries when the picture
+	 * names no reference at all. An I picture may do that, and the caller
+	 * answers it by keeping the destination in the slot - every macroblock
+	 * of an I picture is intra there.
+	 */
+	if (!ts)
+		return -ENOENT;
+
+	/*
+	 * A name the client set but no longer holds queued, and the capture
+	 * queue is the only place a timestamp resolves. The fallback of
+	 * programming the destination instead read back through the pool window
+	 * as D4, D5 and D6 holding one address rather than three. Only a client
+	 * that keeps the reference queued can be served here.
+	 */
+	vb = vb2_find_buffer(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx), ts);
+	if (!vb)
+		return -EINVAL;
+
+	*addr = histb_vdec_frame_dma(ctx, vb);
+	if (!*addr)
+		return -ENOMEM;
+	return 0;
+}
+
+/*
+ * ISO/IEC 13818-2 Table 6-17 (normal scan): scan position -> raster index of
+ * the same coefficient. The uAPI arrays are documented "in zigzag scanning
+ * order" (v4l2-controls.h, struct v4l2_ctrl_mpeg2_quantisation) and the
+ * elementary stream carries them the same way, while the VDM's matrix words
+ * address the coefficients by raster position: submitting the array unpermuted
+ * makes the engine apply weight intra[SCAN[k]] at scan position k (measured on
+ * a corpus stream with a non-flat declared table, where the unpermuted reading
+ * is off by up to 23 levels and the permuted one lands in the one-level
+ * rounding band). A flat table is permutation-invariant, which is why no
+ * earlier measurement could see this.
+ */
+static const u8 histb_mpeg2_scan2raster[64] = {
+	 0,  1,  8, 16,  9,  2,  3, 10, 17, 24, 32, 25, 18, 11,  4,  5,
+	12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13,  6,  7, 14, 21, 28,
+	35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51,
+	58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63
+};
+
+static void histb_mpeg2_permute_matrix(const u8 *scan, u8 *raster)
+{
+	unsigned int s;
+
+	for (s = 0; s < 64; s++)
+		raster[histb_mpeg2_scan2raster[s]] = scan[s];
+}
+
+/*
+ * Pack the two 64-byte quantisation matrices into slot words 16-47: words
+ * 0-15 carry the intra matrix, 16-31 (slot words 32-47) the non-intra one,
+ * four matrix bytes per word. Word 2c holds matrix column c rows
+ * {0, 2, 4, 6} in bytes {0, 1, 2, 3} and word 2c+1 column c rows
+ * {1, 3, 5, 7} (the two packing loops of the vendor firmware's MPEG-2
+ * picture-message packer).
+ */
+static void histb_vdec_mpeg2_pack_qmatrix(u32 *w, const u8 *intra,
+					  const u8 *nonintra)
+{
+	unsigned int c, r, i;
+
+	for (i = 0; i < 16; i++) {
+		w[16 + i] = 0;
+		w[32 + i] = 0;
+	}
+
+	for (c = 0; c < 8; c++) {
+		for (r = 0; r < 4; r++) {
+			w[16 + 2 * c] |= (u32)intra[2 * r * 8 + c] << (8 * r);
+			w[17 + 2 * c] |= (u32)intra[(2 * r + 1) * 8 + c] << (8 * r);
+			w[32 + 2 * c] |= (u32)nonintra[2 * r * 8 + c] << (8 * r);
+			w[33 + 2 * c] |= (u32)nonintra[(2 * r + 1) * 8 + c] << (8 * r);
+		}
+	}
+}
+
+/*
+ * MPEG-1 has no sequence extension: a span that carries a sequence header
+ * (0xB3) and no MPEG-2 sequence extension (0xB5 with identifier 1) belongs to
+ * the older standard. A span with neither keeps the decision the last header
+ * gave, since continuation pictures need not repeat it.
+ */
+static void histb_vdec_mpeg2_detect(struct histb_vdec_ctx *ctx,
+				    const u8 *p, size_t n)
+{
+	bool seq = false, ext = false;
+	size_t i;
+
+	if (!p)
+		return;
+	for (i = 0; i + 3 < n; i++) {
+		if (p[i] || p[i + 1] || p[i + 2] != 1)
+			continue;
+		if (p[i + 3] == 0xb3)
+			seq = true;
+		else if (p[i + 3] == 0xb5 && i + 4 < n &&
+			 (p[i + 4] >> 4) == 1)
+			ext = true;
+	}
+	if (seq && !ext)
+		ctx->mpeg1 = true;
+	else if (ext)
+		ctx->mpeg1 = false;
+}
+
+static int histb_vdec_mpeg2_run(struct histb_vdec_ctx *ctx,
+				struct vb2_v4l2_buffer *src,
+				struct vb2_v4l2_buffer *dst)
+{
+	const struct v4l2_ctrl_mpeg2_sequence *seq;
+	const struct v4l2_ctrl_mpeg2_picture *pic;
+	const struct v4l2_ctrl_mpeg2_quantisation *quant;
+	struct histb_vdec_dev *dev = video_get_drvdata(ctx->fh.vdev);
+	struct histb_vdec_msgpool *pool = &dev->pool;
+	dma_addr_t stream_base, src_addr, dst_addr, fwd, bwd, scratch;
+	unsigned int mb_width, mb_height, mb_total, tile_stride, lines;
+	unsigned int bytesused;
+	u32 *w = histb_vdec_pic_slot(pool);
+	u32 seg[3];
+	u32 cfg1;
+	unsigned int cap_w, cap_h;
+	bool mpeg1;
+	int ret;
+	int i;
+
+	ret = histb_vdec_cap_dims(ctx, &cap_w, &cap_h);
+	if (ret)
+		return ret;
+
+	seq = histb_vdec_mpeg2_seq(ctx);
+	pic = histb_vdec_mpeg2_pic(ctx);
+	quant = histb_vdec_mpeg2_quant(ctx);
+
+	/*
+	 * The engine writes the reconstruction into the queued CAPTURE buffer
+	 * at the geometry that buffer's format promised - histb_vdec_buf_geom()
+	 * takes the tile stride and row count from the negotiated rectangle,
+	 * not from the coded one - so a picture larger than the client
+	 * negotiated has nowhere to land. This is judged before the message
+	 * pool, the registers and the kick, so a refusal leaves the buffer as
+	 * it arrived: the same ordering measured on the H.264 path, where the
+	 * identical gate kept a stream that was larger than the negotiated
+	 * capture geometry from writing a single byte. Accepting it would need
+	 * the capture queue to be re-negotiated for the coded size, which the
+	 * stateless API leaves to the client (and this device reports the
+	 * geometry at TRY_FMT time only).
+	 */
+	if (seq->horizontal_size > cap_w || seq->vertical_size > cap_h)
+		return -EINVAL;
+
+	/*
+	 * The picture is laid out in the 4:2:0 geometry the capture format
+	 * promises, and nothing here reads seq->chroma_format, so any other
+	 * sampling is programmed as if it were 4:2:0. Measured on the board
+	 *   with a
+	 * 4:2:2 Profile stream (ffmpeg mpeg2video -pix_fmt yuv422p, quantiser tables
+	 * declared so the comparison is one-variable): 10290 of 76800 luma
+	 *   bytes and
+	 * 4693 of 38400 chroma bytes agree with the reference decode, max |d|
+	 *   240 -
+	 * the block layer stops staying in step. The 4:2:0 control under the same
+	 * recipe lands in the rounding tier only (76505 luma and 38134 chroma equal,
+	 * max |d| 1). The scored MPEG-2 corpus is 4:2:0 throughout, so this refusal
+	 * costs no frame that decodes acceptably today; serving 4:2:2 would
+	 *   need a
+	 * chroma-subsampled capture path, which is not a lightweight bypass.
+	 */
+	if (seq->chroma_format != 1)
+		return -EINVAL;
+
+	/*
+	 * Only frame-structured pictures are served. The VDM is programmed with
+	 * picture_structure in D1 bits 8-9 and no second_field_flag at all - the
+	 * control has no such field, and a field pair is two OUTPUT jobs while a
+	 * capture buffer holds one picture - so the engine is left to interpret a
+	 * field picture on its own. Measured with a frame-coded stream and the
+	 * control's structure overridden (one variable: D1 bits 8-9): struct 1
+	 * delivers 51468 differing luma samples of 76800 with max |d| 230 and a
+	 * +20 to +24 mean bias, struct 2 the same class (51423 differing, max
+	 * 168), while struct 3 under the same recipe is the rounding tier
+	 * (329 differing, max 1). The bad frames come back with a full
+	 * payload, so this is an anomalous delivery that only a refusal can
+	 * express. top_field_first does not need the same treatment: with
+	 * structure 3 forcing it to 1 leaves the frame identical (329/268,
+	 * max 1) - the bit is inert for frame pictures. Structure 0 never
+	 * reaches here (the control handler validates the range), and no scored
+	 * stream uses 1 or 2, so this refusal costs nothing. Accepting field
+	 * pictures would need a control that carries the second-field flag and
+	 * a submission model that pairs two OUTPUT jobs with one capture
+	 * buffer; the current uAPI provides neither.
+	 */
+	if (pic->picture_structure != HISTB_MPEG2_STRUCT_FRAME)
+		return -EINVAL;
+
+	mb_width = DIV_ROUND_UP(seq->horizontal_size, 16);
+	mb_height = DIV_ROUND_UP(seq->vertical_size, 16);
+	mb_total = mb_width * mb_height;
+	/*
+	 * Report the picture's macroblock count so the completion path can tell a
+	 * cut-short decode from the engine's benign DEC_ERR bit (see
+	 * histb_vdec_irq_handler): the per-slice end macroblock is only usable
+	 * against a known total.
+	 */
+	dev->mb_total = mb_total;
+	/*
+	 * The picture size is judged per job, not in a control .try_ctrl(): the
+	 * handler's all-zero default control is read back by TRY_EXT_CTRLS as
+	 * if a client had set it, and a size below one macroblock would also
+	 * leave histb_vdec_mpeg2_pack_slices() dividing the MB total by zero.
+	 *
+	 * That division is what the lower bound actually protects: only a size
+	 * of 0 (the unset control) makes DIV_ROUND_UP() give a grid of zero
+	 * columns, and with it a zero MB total for both the division and the
+	 * mb_total - 1 programmed into CFG0's macroblock count. One macroblock
+	 * column is *not* refused here, unlike the H.264 path: the write defect
+	 * that makes a one-column H.264 picture undeliverable was measured on
+	 * that protocol alone, and MPEG-2 jobs at 16 wide were accepted on the
+	 * board (which is why histb_vdec_enum_framesizes() keeps min_width = 16
+	 * for this fourcc and raises it to 32 only for
+	 * V4L2_PIX_FMT_H264_SLICE). The upper bound is the pair the format
+	 * layer advertises and clamps to, so nothing larger can be negotiated
+	 * into a capture buffer in the first place; the geometry check above
+	 * refuses it as well, this one is the cheaper statement of the same
+	 * limit.
+	 */
+	if (seq->horizontal_size < 16 || seq->vertical_size < 16 ||
+	    seq->horizontal_size > HISTB_VDEC_MAX_WIDTH ||
+	    seq->vertical_size > HISTB_VDEC_MAX_HEIGHT)
+		return -EINVAL;
+	histb_vdec_buf_geom(ctx, &tile_stride, &lines);
+
+	src_addr = histb_vdec_src_dma(&src->vb2_buf);
+	dst_addr = histb_vdec_frame_dma(ctx, &dst->vb2_buf);
+	if (!dst_addr)
+		return -ENOMEM;
+	stream_base = src_addr & ~255U;
+
+	fwd = bwd = dst_addr;
+	/*
+	 * An inter picture whose reference does not resolve is programmed with
+	 * the frame being written, and then predicts from itself. Measured with
+	 * the reference named in the wrong units (microseconds rather than the
+	 * v4l2_timeval_to_ns() the control documents), every P picture of a
+	 * 30-picture chain came back with 113238 of 115200 samples differing and
+	 * max |d| 240, while the same stream with resolvable references stays
+	 * inside 4 levels over a 59-frame chain. So a picture that cannot
+	 * address the references its own
+	 * coding type needs is refused: P names a forward reference and B names
+	 * both (ISO/IEC 13818-2 6.2.31 keeps backward_f_code at '0000' only for
+	 * P pictures). I pictures keep the destination in both slots: every
+	 * macroblock is intra there, and the 68-stream corpus decodes
+	 * byte-exactly that way.
+	 */
+	if (pic->picture_coding_type != HISTB_MPEG2_PIC_I) {
+		int ferr, berr;
+
+		ferr = histb_vdec_ref_addr(ctx, pic->forward_ref_ts, &fwd);
+		berr = histb_vdec_ref_addr(ctx, pic->backward_ref_ts, &bwd);
+		if (ferr == -EINVAL || berr == -EINVAL ||
+		    (pic->picture_coding_type == HISTB_MPEG2_PIC_P && ferr) ||
+		    (pic->picture_coding_type == HISTB_MPEG2_PIC_B && (ferr ||
+								       berr))) {
+			dev_dbg(dev->dev, "mpeg2 refuse: type %u fwd=%llu(%d) bwd=%llu(%d)\n",
+				pic->picture_coding_type,
+				pic->forward_ref_ts, ferr,
+				pic->backward_ref_ts, berr);
+			return -EINVAL;
+		}
+	}
+	scratch = histb_vdec_tables_dma(pool) +
+		  HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_PMV_TOP);
+
+	memset(w, 0, HISTB_VDEC_SLOT_BYTES);
+
+	/* D0: macroblock frame size minus one; bit 25 selects MPEG-1 syntax. */
+	w[0] = FIELD_PREP(GENMASK(8, 0), mb_width - 1) |
+	       FIELD_PREP(GENMASK(24, 16), mb_height - 1);
+	histb_vdec_mpeg2_detect(ctx, histb_vdec_src_va(&src->vb2_buf),
+				vb2_get_plane_payload(&src->vb2_buf, 0));
+	mpeg1 = ctx->mpeg1;
+	if (mpeg1)
+		w[0] |= BIT(25);
+
+	/* D1: frame_pred_frame_dct, picture_structure, second_field_flag
+	 * (field-pair submission is not modelled by V4L2: always 0),
+	 * concealment_motion_vectors, picture_coding_type. The full-pel MPEG-1
+	 * bits have no control counterpart: 0.
+	 *
+	 * frame_pred_frame_dct is written for MPEG-1 whatever the control
+	 * says: 11172-1 defines no field DCT and no field prediction, so the
+	 * standard implies the bit and its syntax cannot carry it. With the
+	 * control's 0 the engine read two macroblocks of a 300-MB MPEG-1
+	 * picture and stopped (end_mb=1/300); the same job with the bit set
+	 * covered the frame (end_mb=299/300, and 395/396 on a five-slice
+	 * picture).
+	 */
+	if ((pic->flags & V4L2_MPEG2_PIC_FLAG_FRAME_PRED_DCT) || mpeg1)
+		w[1] |= BIT(0);
+	w[1] |= FIELD_PREP(GENMASK(9, 8), pic->picture_structure);
+	if (pic->flags & V4L2_MPEG2_PIC_FLAG_CONCEALMENT_MV)
+		w[1] |= BIT(16);
+	w[1] |= FIELD_PREP(GENMASK(26, 24), pic->picture_coding_type);
+
+	/* D2: f_code[2][2] maps directly onto the four hardware slots (fwd h/v
+	 * and bwd h/v); the control carries the full matrix, no userspace
+	 * reconstruction needed. top_field_first at bit 31.
+	 */
+	w[2] |= FIELD_PREP(GENMASK(3, 0),
+		     histb_vdec_mpeg2_fcode(mpeg1, pic->f_code[1][1]));
+	w[2] |= FIELD_PREP(GENMASK(11, 8),
+		     histb_vdec_mpeg2_fcode(mpeg1, pic->f_code[1][0]));
+	w[2] |= FIELD_PREP(GENMASK(19, 16),
+		     histb_vdec_mpeg2_fcode(mpeg1, pic->f_code[0][1]));
+	w[2] |= FIELD_PREP(GENMASK(27, 24),
+		     histb_vdec_mpeg2_fcode(mpeg1, pic->f_code[0][0]));
+	if (pic->flags & V4L2_MPEG2_PIC_FLAG_TOP_FIELD_FIRST)
+		w[2] |= BIT(31);
+
+	/*
+	 * D3: intra_dc_precision, q_scale_type, intra_vlc_format,
+	 * alternate_scan, packed as the vendor firmware's MPEG-2 packer does.
+	 *
+	 * An earlier measurement of this field (which suggested it be written
+	 * as intra_dc_precision + 1, because a flat picture then came back
+	 * as 128) is void: it was taken while the slice segments still pointed
+	 * at the wrong byte granule, so the engine was not reading the
+	 * bitstream at all and the level it reported was not a decoded DC. With
+	 * the segments correct, sweeping the field over 0..3 leaves the
+	 * reconstruction at 146/137/130/130 for a picture whose DC is 128 and
+	 * does not make the per-macroblock DC differences appear at all (fitted
+	 * slope ~0), so what these bits really select is still open. The syntax
+	 * value is written here, which is what the vendor packing does.
+	 */
+	w[3] |= FIELD_PREP(GENMASK(1, 0), pic->intra_dc_precision);
+	if (pic->flags & V4L2_MPEG2_PIC_FLAG_Q_SCALE_TYPE)
+		w[3] |= BIT(8);
+	if (pic->flags & V4L2_MPEG2_PIC_FLAG_INTRA_VLC)
+		w[3] |= BIT(16);
+	if (pic->flags & V4L2_MPEG2_PIC_FLAG_ALT_SCAN)
+		w[3] |= BIT(24);
+
+	/* D4-D7: backward/forward reference, reconstruction (output) frame and
+	 * the PMV band-line scratch. References fall back to the output frame
+	 * for I pictures where no timestamp is given.
+	 */
+	w[4] = bwd & ~15U;
+	w[5] = fwd & ~15U;
+	w[6] = dst_addr & ~15U;
+	w[7] = scratch & ~15U;
+
+	/* D8/D9: picture bitstream segment (whole OUTPUT plane, relative to the
+	 * 256-byte aligned stream base). D10/D11: second segment, unused (seg1
+	 * = 0 like the single-segment vendor path).
+	 */
+	bytesused = vb2_get_plane_payload(&src->vb2_buf, 0);
+	histb_vdec_seg_pack(seg, stream_base, src_addr, 0, bytesused * 8);
+	w[8] = seg[0];
+	w[9] = FIELD_PREP(GENMASK(23, 0),
+			  (seg[2] + HISTB_MPEG2_DUMMY_BITS) & GENMASK(23, 0)) |
+	       FIELD_PREP(GENMASK(30, 24), seg[1]);
+
+	/* D16-D47: intra and non-intra quantisation matrices, loaded whenever
+	 * the hardware is kicked (LD_QMATRIX: the vendor sets it only when the
+	 * matrix changed; reloading per frame is simpler and never stale). The
+	 * uAPI and the bitstream both hold them in scan order; the matrix words
+	 * are raster addressed, so the arrays are permuted before packing.
+	 */
+	{
+		u8 intra_hw[64], nonintra_hw[64];
+
+		histb_mpeg2_permute_matrix(quant->intra_quantiser_matrix,
+					   intra_hw);
+		histb_mpeg2_permute_matrix(quant->non_intra_quantiser_matrix,
+					   nonintra_hw);
+		histb_vdec_mpeg2_pack_qmatrix(w, intra_hw, nonintra_hw);
+	}
+
+	/* D48: pmv_top band-line scratch. D63: slice chain head. */
+	w[48] = scratch & ~15U;
+	w[63] = histb_vdec_mpeg2_slc_slot_dma(pool, 0) & ~15U;
+
+	/*
+	 * One descriptor per slice, chained through D7 and ended by a cleared
+	 * slot. The slice start codes are found by scanning the submitted span:
+	 * the uAPI carries no per-slice control for MPEG-2.
+	 */
+	{
+		const u8 *va = histb_vdec_src_va(&src->vb2_buf);
+		int n_sl;
+
+		/*
+		 * MPEG-2 has no per-slice control, so the only source of the
+		 * slice windows is the submitted bytes, and reading those bytes
+		 * needs a kernel address. The OUTPUT queue deliberately keeps
+		 * one (histb_vdec_queue_init() in histb_vdec_drv.c declines
+		 * DMA_ATTR_NO_KERNEL_MAPPING for exactly this scan), so this
+		 * arm answers a missing mapping rather than a stream shape:
+		 * without the bytes nothing can be delimited, and programming
+		 * the job would hand the engine a picture segment with no
+		 * descriptor chain behind it. A client that cannot map the
+		 * plane would need per-slice descriptors through a control
+		 * instead, which the stateless MPEG-2 API does not carry.
+		 */
+		if (!va) {
+			dev_warn_once(dev->dev,
+				      "OUTPUT queue has no kernel mapping, cannot delimit "
+				      "slices\n");
+			return -EINVAL;
+		}
+		n_sl = histb_vdec_mpeg2_pack_slices(pool, va, bytesused,
+						   seq->flags &
+						   V4L2_MPEG2_SEQ_FLAG_PROGRESSIVE,
+						   mpeg1,
+						   mb_width, mb_total, stream_base,
+					   src_addr);
+		if (n_sl < 0)
+			return n_sl;
+	}
+
+	/*
+	 * Per-frame register set. Two vendor firmware paths exist for MPEG-2
+	 * and they disagree: the one its MPEG-2 start sequence calls writes the
+	 * 256x16 band geometry the H.264 path uses - the band stride is the
+	 * band pitch, the maximum slice group number is 3 and CFG0 carries the
+	 * COEFIDX/MARKER detect bits - while the other writes a linear picture
+	 * (stride counted in 16-byte lines, chroma right behind luma) with CFG0
+	 * reduced to LD_QMATRIX. The capture format is the same tiled NV21 for
+	 * every protocol and dropping the detect bits changed nothing
+	 * measurable, so this driver follows the path the firmware actually
+	 * takes.
+	 */
+	vdm_write(dev, VDM_CFG0,
+		  FIELD_PREP(VDM_CFG0_MBAMT, mb_total - 1) |
+		  VDM_CFG0_COEFIDX_DETECT | VDM_CFG0_MARKER_DETECT |
+		  VDM_CFG0_LD_QMATRIX);
+	cfg1 = FIELD_PREP(VDM_CFG1_VID_STD, HISTB_VIDSTD_MPEG2) |
+	       FIELD_PREP(VDM_CFG1_DDR_STRIDE, tile_stride >> 6) |
+	       VDM_CFG1_FST_SLC_GRP |
+	       FIELD_PREP(VDM_CFG1_MAX_SLCGRP_NUM, 3) |
+	       VDM_CFG1_DBLK_1D_EN;
+	/*
+	 * Measurement arms for the MPEG-1 inter-picture gap: the firmware's
+	 * MP2HAL_V300R001_CfgReg reaches this word through byte writes that
+	 * set bit 22 (slice-group 64 rather than 3) and clear FST_SLC_GRP for
+	 * pictures under 64 slices, and it leaves MV_OUT_EN, LINE_NUM_OUT_EN
+	 * and PPFD_EN as the reset value for this protocol. Measured here: none
+	 * of these arms moves the MPEG-1 inter pictures off 2 of 8 delivered
+	 * (PPFD_EN takes it to 0), while the picture that does complete still
+	 * lands at the same pixels as without the arms, so the inter gap is not
+	 * a CFG1 programming choice.
+	 */
+	vdm_write(dev, VDM_CFG1, cfg1);
+	vdm_write(dev, VDM_AVM_ADDR, pool->dma & ~15U);
+	vdm_write(dev, VDM_VAM_ADDR, histb_vdec_up_msgs_dma(pool) & ~15U);
+	vdm_write(dev, VDM_STREAM_BASE, stream_base);
+	/*
+	 * The reconstruction address is masked to 16 bytes here, like the
+	 * vendor path; the reference and FF-APT registers are written too
+	 * because the values a previous frame of another protocol left in them
+	 * would otherwise apply (the MPEG-2 path keeps FF_APT_EN at 0, unlike
+	 * H.264's 2 for frame pictures).
+	 */
+	vdm_write(dev, VDM_YSTADDR_1D, dst_addr & ~15U);
+	vdm_write(dev, VDM_YSTRIDE_1D, histb_vdec_band_bytes(tile_stride));
+	vdm_write(dev, VDM_UVOFFSET_1D,
+		  histb_vdec_luma_bytes(tile_stride, lines) +
+		  histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_HEAD_INF_OFFSET, histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_REF_PIC_TYPE, 0);
+	vdm_write(dev, VDM_FF_APT_EN, 0);
+
+	for (i = 1; i <= 7; i++)
+		vdm_write(dev, VDM_TO(i), VDM_TIMEOUT_MOD);
+	vdm_write(dev, VDM_INT_STATE, 0xffffffff);
+	vdm_write(dev, VDM_INT_MASK, 0xfffffffe);
+
+	histb_vdec_hw_kick(dev, ctx->desc->vidstd);
+
+	return 0;
+}
+
+static const struct histb_vdec_codec_ops histb_vdec_mpeg2_ops = {
+	.run		= histb_vdec_mpeg2_run,
+};
+
+const histb_vdec_fmt_desc histb_vdec_mpeg2_fmt = {
+	.fourcc		= V4L2_PIX_FMT_MPEG2_SLICE,
+	.stride		= histb_vdec_tile_stride,
+	.grid_align	= 16,
+	.num_ctrls	= ARRAY_SIZE(histb_vdec_mpeg2_ctrls),
+	.ctrls		= histb_vdec_mpeg2_ctrls,
+	.ops		= &histb_vdec_mpeg2_ops,
+	.vidstd		= HISTB_VIDSTD_MPEG2,
+};
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_mpeg4.c b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_mpeg4.c
new file mode 100644
index 000000000000..52842bb2ab8b
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_mpeg4.c
@@ -0,0 +1,2336 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon VDH v2 stateless MPEG-4 Part 2 / H.263 short-header
+ * decoder (V4L2 codec layer).
+ *
+ * Neither protocol has a V4L2 stateless control set, so the OUTPUT plane
+ * carries the raw elementary stream and the driver reads the VOL/VOP, H.263
+ * picture and slice headers itself - the shape coda uses for the same class of
+ * hardware (coda_buffer_parse_headers() in
+ * drivers/media/platform/chips-media/coda/coda-bit.c). The VDM still consumes
+ * fully parsed syntax: one picture message (slot words D0-D63) plus a chain of
+ * 32-byte slice descriptors. It never looks at a start code.
+ *
+ * Message and register layout: re-derived field by field from the three packing
+ * paths of the vendor firmware's MPEG-4 decoder layer - the register setup, the
+ * picture message and the slice descriptors. Header field order and widths are
+ * cross-checked against the vendor's own software MPEG-4/H.263 decoder, which
+ * is ffmpeg-derived and agrees with the firmware's syntax layer.
+ *
+ * Capability gates, all refused in .run() rather than decoded at a guessed bit
+ * position: data partitioning, new prediction, reduced-resolution VOPs,
+ * scalability, non-rectangular shapes, studio and core profiles, interlaced
+ * VOLs, GMC and sprite usage, complexity-estimation signalling, a
+ * quant_precision other than 5, MPEG-4 short VOP headers, and the H.263+
+ * extended PTYPE branch (source_format 6/7, where Annex I/D/J signalling lives)
+ * along with the group geometry that picture message D1 cannot state (a 16CIF
+ * picture's 352-macroblock group exceeds its seven-bit field). The firmware's
+ * VOL checks refuse the same set and report each of those shapes as
+ * unsupported.
+ *
+ * Verification status: the header parse is exercised on 19 streams by a
+ * user-space harness that builds against these functions; the message and
+ * register values below come from re-deriving the vendor firmware's packing,
+ * not from a board run, so some of them are still unmeasured on hardware.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "histb_vdec_v2.h"
+
+/*
+ * Slice descriptors are 32 bytes (8 words), one per slice, chained through word
+ * D7: the vendor firmware's MPEG-4 slice packer writes entry i at (slice pool
+ * base) + i * 32 and puts (slice pool base) + (i + 1) * 32 in D7, ending the
+ * chain with 0. The picture message D63 points at the pool base, so the first
+ * descriptor has to sit there.
+ */
+#define HISTB_MPEG4_SLC_BYTES		32
+#define HISTB_MPEG4_MAX_SLICES		511
+
+/*
+ * The CFG1 VID_STD field for this engine is 2, which is what the vendor
+ * firmware's MPEG-4 register setup writes (the literal 0x20000002: VID_STD 2
+ * plus DBLK_1D_EN); the register value is not inherited from any other
+ * protocol. The picture message word D0 carries 4 (the H.263 protocol code)
+ * when the picture uses short headers, which is how the macroblock layer is
+ * told to read GOB headers instead of MPEG-4 packet headers.
+ */
+#define HISTB_MPEG4_CFG1_VIDSTD		2
+#define HISTB_MPEG4_D0_H263_SHORT	4
+
+/* Motion-vector storage per macroblock, the size the vendor firmware allocates
+ * the motion-vector buffer by (the same 32 bytes per macroblock the H.264 layer
+ * uses).
+ */
+#define HISTB_MPEG4_PMV_BYTES_PER_MB	32
+
+/* MPEG-4 vop_coding_type (14496-2 table 6-2). */
+#define HISTB_MPEG4_I_VOP		0
+#define HISTB_MPEG4_P_VOP		1
+#define HISTB_MPEG4_B_VOP		2
+
+/*
+ * MPEG-4 start codes, held as the low byte of the 32-bit 0x000001xx code (the
+ * three leading bytes are what the scan matches). The VOL is coded 0x120 +
+ * vol_number and the video object 0x100 + vo_number: that is what ffmpeg's
+ * MPEG-4 encoder writes and what the vendor firmware's own picture-header
+ * dispatcher matches - start code 0x120..0x12F is the VOL there too, and it
+ * refuses an access unit that carried none. Xvid and Lavc streams were checked
+ * to carry the VOL at 0x120 and the visual object at 0x1B5, so 0x1B5 is not a
+ * VOL and must not be parsed as one. Low bytes 0x20..0x2F are also slice codes
+ * (mbk_number 32..47), which is why only the codes *ahead of the VOP* are read
+ * as a VOL - the same disambiguation the vendor firmware applies. Everything
+ * else the scan meets (VOS 0xB0, video object 0x00..0x1F, GOP 0xB3, user data
+ * 0xB2, visual object 0xB5) contributes no descriptor input and is stepped
+ * over.
+ */
+#define HISTB_MP4_CODE_VOL_FIRST	0x20
+#define HISTB_MP4_CODE_VOL_LAST		0x2f
+#define HISTB_MP4_CODE_VOP		0xb6
+
+/*
+ * Default quant matrices in macroblock (raster) order, entry 0 = DC, taken from
+ * the two constant tables the vendor firmware's MPEG-4 syntax layer carries, 64
+ * entries each. They are also what ffmpeg's MPEG-4 decoder installs as its
+ * defaults, so a stream that sets vol_quant_type and loads no table of its own
+ * has both sides reading the same weights. The first transcription here was not
+ * that table (row 1 ended 32 not 28, rows 2..7 were a diagonal progression),
+ * and that is what left mpegquant.raw 16277 bytes wrong by as much as 31: the
+ * wrong weight is read per frequency, so the error grows with the coefficient's
+ * position.
+ */
+static const u8 histb_mp4_intra_matrix[64] = {
+	 8, 17, 18, 19, 21, 23, 25, 27,
+	17, 18, 19, 21, 23, 25, 27, 28,
+	20, 21, 22, 23, 24, 26, 28, 30,
+	21, 22, 23, 24, 26, 28, 30, 32,
+	22, 23, 24, 26, 28, 30, 32, 35,
+	23, 24, 26, 28, 30, 32, 35, 38,
+	25, 26, 28, 30, 32, 35, 38, 41,
+	27, 28, 30, 32, 35, 38, 41, 45,
+};
+
+static const u8 histb_mp4_inter_matrix[64] = {
+	16, 17, 18, 19, 20, 21, 22, 23,
+	17, 18, 19, 20, 21, 22, 23, 24,
+	18, 19, 20, 21, 22, 23, 24, 25,
+	19, 20, 21, 22, 23, 24, 26, 27,
+	20, 21, 22, 23, 25, 26, 27, 28,
+	21, 22, 23, 24, 26, 27, 28, 30,
+	22, 23, 24, 26, 27, 28, 30, 31,
+	23, 24, 25, 27, 28, 30, 31, 33,
+};
+
+/* A VOL lists a custom matrix in scan order while the descriptor table is
+ * indexed by block position; this is the mapping the vendor firmware applies
+ * when it loads a VOL matrix (scan entry i lands at block position
+ * histb_mp4_zigzag[i]).
+ */
+static const u8 histb_mp4_zigzag[64] = {
+	 0,  1,  8, 16,  9,  2,  3, 10,
+	17, 24, 32, 25, 18, 11,  4,  5,
+	12, 19, 26, 33, 40, 48, 41, 34,
+	27, 20, 13,  6,  7, 14, 21, 28,
+	35, 42, 49, 50, 43, 36, 29, 22,
+	15, 23, 30, 37, 44, 51, 52, 45,
+	38, 31, 39, 46, 53, 54, 47, 55,
+	56, 57, 62, 63, 58, 59, 60, 61,
+};
+
+/*
+ * VOL parameters, kept per context: a raw-fourcc submission carries no
+ * sequence-level control, and a stream writes the VOL once while every later
+ * buffer carries only its VOP. Dropped with the context (and by a format change
+ * through .stop()/.start()).
+ */
+struct histb_vdec_mpeg4_vol {
+	unsigned int width;
+	unsigned int height;
+	unsigned int time_incr_res;
+	unsigned int time_incr_bits;
+	u8 quant_type;
+	u8 quarter_sample;
+	u8 resync_marker_disable;
+	bool parsed;
+	/* Set when a configuration boundary was met but not read (a VOL this
+	 * parser could not parse in a stream whose packet codes make its
+	 * position ambiguous): the grid of every later picture is then unknown
+	 * and they are refused until an access unit opens with a readable VOL.
+	 */
+	bool config_pending;
+	u8 intra_matrix[64];
+	u8 inter_matrix[64];
+};
+
+/* An anchor picture, the reference of the pictures that follow it. */
+struct histb_vdec_mpeg4_ref {
+	u64 timestamp;
+	unsigned int pmv_slot;
+	bool valid;
+};
+
+struct histb_vdec_mpeg4_ctx {
+	void *pmv_va[HISTB_VDEC_MAX_PMV_SLOTS];
+	dma_addr_t pmv_dma[HISTB_VDEC_MAX_PMV_SLOTS];
+	unsigned int pmv_slot_size;
+	struct histb_vdec_mpeg4_vol vol;
+	/* [0] is the most recently decoded anchor, [1] the one before it */
+	struct histb_vdec_mpeg4_ref anchor[2];
+	/*
+	 * The vop time-code accumulation the picture message's B-VOP distances
+	 * (word D3) are derived from, same units as the vendor's decoder: a
+	 * second count in modulo_time_base steps and a picture time in
+	 * vop_time_increment_resolution ticks.
+	 */
+	unsigned int time_base;
+	unsigned int last_time_base;
+	unsigned int last_non_b_time;
+	unsigned int pp_time;
+};
+
+/* Everything the descriptors need about one picture. */
+struct histb_vdec_mpeg4_pic {
+	unsigned int width;
+	unsigned int height;
+	unsigned int mb_width;
+	unsigned int mb_height;
+	unsigned int mb_total;
+	unsigned int mb_bits;		/* width of a slice macroblock number */
+	unsigned int msg_mb_bits;	/* the width MP4HAL states in D2 */
+	unsigned int coding_type;
+	unsigned int quant;
+	unsigned int rounding;
+	unsigned int fcode_fwd;
+	unsigned int fcode_bwd;
+	unsigned int intra_dc_vlc_thr;
+	unsigned int quarter_sample;
+	unsigned int resync_marker_disable;
+	unsigned int time_incr_bits;
+	unsigned int time_modulo;	/* modulo_time_base run length */
+	unsigned int time_increment;	/* vop_time_increment */
+	unsigned int quant_type;
+	unsigned int mb_per_gob;	/* H.263: macroblocks in one GOB */
+	unsigned int num_gobs;
+	bool short_header;
+};
+
+/* One parsed slice header. */
+struct histb_vdec_mpeg4_slice {
+	unsigned int data_bit;
+	unsigned int start_mbn;
+	unsigned int quant;
+	unsigned int coding_type;
+	unsigned int intra_dc_vlc_thr;
+};
+
+/* ------------------------------------------------------------------ bits */
+
+static unsigned int histb_vdec_mpeg4_bits(const u8 *p, unsigned int pos,
+					  unsigned int n)
+{
+	unsigned int val = 0;
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		val = val << 1 |
+		      ((p[(pos + i) / 8] >> (7 - (pos + i) % 8)) & 1U);
+	return val;
+}
+
+static unsigned int histb_vdec_mpeg4_bit(const u8 *p, unsigned int pos)
+{
+	return (p[pos / 8] >> (7 - pos % 8)) & 1U;
+}
+
+/* Number of zero bits at @pos, stopping at @max or at the first one. */
+static unsigned int histb_vdec_mpeg4_zero_run(const u8 *p, unsigned int pos,
+					      unsigned int max)
+{
+	unsigned int n = 0;
+
+	while (n < max && !histb_vdec_mpeg4_bit(p, pos + n))
+		n++;
+	return n;
+}
+
+/*
+ * Bounds-checked bit cursor. Every read advances @p, and a read that would pass
+ * the end of the span latches an error instead of running past the buffer
+ * mapping - a VOL near the end of a full OUTPUT buffer is the case that would
+ * otherwise read unowned memory.
+ */
+struct histb_vdec_mpeg4_bs {
+	const u8 *buf;
+	unsigned int limit;
+	unsigned int p;
+	int err;
+};
+
+static unsigned int histb_vdec_mpeg4_bs_get(struct histb_vdec_mpeg4_bs *bs,
+					    unsigned int n)
+{
+	unsigned int v;
+
+	if (bs->err || bs->p + n > bs->limit) {
+		bs->err = -EINVAL;
+		return 0;
+	}
+	v = histb_vdec_mpeg4_bits(bs->buf, bs->p, n);
+	bs->p += n;
+	return v;
+}
+
+static void histb_vdec_mpeg4_bs_skip(struct histb_vdec_mpeg4_bs *bs,
+				     unsigned int n)
+{
+	histb_vdec_mpeg4_bs_get(bs, n);
+}
+
+/* Find a byte-aligned MPEG-4 32-bit start code 0x000001xx at or after @from. */
+static int histb_vdec_mpeg4_find_code(const u8 *buf, unsigned int size,
+				      unsigned int from, unsigned int *pos,
+				      unsigned int *code)
+{
+	unsigned int i;
+
+	for (i = from; i + 4 <= size; i++) {
+		if (buf[i] || buf[i + 1] || buf[i + 2] != 1)
+			continue;
+		*pos = i;
+		*code = buf[i + 3];
+		return 0;
+	}
+
+	/*
+	 * No byte-aligned 0x000001xx code is left, and every VOL and VOP sits
+	 * behind one (14496-2 6.2.1, 6.2.5), so the rest of the span holds no
+	 * header to read. A picture scan that meets this has no grid, quantiser
+	 * or packet geometry to program, so the job is refused; serving it
+	 * needs the VOP inside the same submission.
+	 */
+	return -EINVAL;
+}
+
+/* ------------------------------------------------------- VOL/VOP parsing */
+
+/*
+ * Parse one MPEG-4 VOL header (14496-2 6.2.1); @pos is the byte of the
+ * 0x000001B5 start code. Markers are checked where the syntax requires them,
+ * because a VOL the driver mis-locates puts every slice window at the wrong
+ * bit.
+ */
+static int histb_vdec_mpeg4_vol(struct histb_vdec_mpeg4_vol *vol, const u8 *buf,
+				unsigned int size, unsigned int pos)
+{
+	struct histb_vdec_mpeg4_bs bs = { buf, size * 8, pos * 8 + 32, 0 };
+	unsigned int ver_id = 1, width, height, bits, i, v, last, load;
+	u8 *table;
+
+	/* random_access: legal either way, it says nothing the descriptors
+	 * carry (the VOL of a short VOP header stream sets it as well, and that
+	 * syntax is refused further down for want of a vop_time_code)
+	 */
+	histb_vdec_mpeg4_bs_skip(&bs, 1);
+
+	/*
+	 * video_object_type_indication. The layout walked below is the one
+	 * these types share, and the gate keeps the ranges the encoders of this
+	 * family actually write: 1..5 (ffmpeg names those values simple,
+	 * simple-scalable, core, main and non-strict-timing video object
+	 * layers) and 17..20 (advanced simple and its AQC, pixel-adaptive-RLD
+	 * and interleaved variants, which is what lavc writes for advanced
+	 * simple and what Xvid writes for B-frames or quarter-pel). 6..16
+	 * (long-term, slice-structured, the scalability types, ARTS, ACE) and
+	 * 21 on (including the studio profiles, whose VOL header is a different
+	 * syntax) have no reference here for the field order, and 0 is
+	 * reserved.
+	 */
+	bits = histb_vdec_mpeg4_bs_get(&bs, 8);
+	/*
+	 * Disposition of the ranges above: this is a refusal with no fallback,
+	 * because video_object_type_indication (14496-2 6.2.1) is what tells
+	 * the reader which field order follows. Inside the accepted set the
+	 * layout walked below is the one those types share; outside it every
+	 * later read in this VOL - and with it the grid, the quarter-pel flag
+	 * and the position, so the VOL is not cached: a submission that opens
+	 * with it is refused here, and one that meets it after a picture's own
+	 * data marks the configuration unread until an access unit starts with
+	 * a VOL this walk does parse (histb_vdec_mpeg4_tail_config()).
+	 */
+	if (!bits || (bits > 5 && bits < 17) || bits > 20)
+		return -EINVAL;
+
+	/*
+	 * video_object_layer_id_present, verid, priority. The verid only
+	 * selects the layout branches below (1 = the original version, which
+	 * has no quarter-pel/newpred fields); every version above 1 takes the
+	 * wider branch, so the value itself is not a capability and is not
+	 * gated - with B-frames or quarter-pel the encoders write 5, which is
+	 * neither of the two versions the vendor firmware warns about.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1)) {
+		ver_id = histb_vdec_mpeg4_bs_get(&bs, 4);
+		histb_vdec_mpeg4_bs_skip(&bs, 3);
+	}
+
+	/* aspect_ratio_info, the extended form (15) carries
+	 * par_width/par_height and Xvid writes it for every 4:3 stream
+	 * (ffmpeg's extended-par case)
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 4) == 15)
+		histb_vdec_mpeg4_bs_skip(&bs, 16);
+
+	/* vol_control_parameters: chroma_format, low_delay, vbv_parameters */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1)) {
+		/*
+		 * chroma_format (14496-2 6.2.1) other than the 4:2:0 value 1 is
+		 * refused for the same reason as the MPEG-2 path's
+		 * seq->chroma_format gate: the capture geometry this engine is
+		 * programmed with is 4:2:0 (one luma plane plus the interleaved
+		 * chroma plane at histb_vdec_buf_geom()'s offset), and nothing
+		 * in the VOL read here reaches the message, so 4:2:2 or 4:4:0
+		 * would be laid out as if it were 4:2:0. Serving it needs a
+		 * chroma subsampled capture path, which is not a lightweight
+		 * bypass.
+		 */
+		if (histb_vdec_mpeg4_bs_get(&bs, 2) != 1)	/* not 4:2:0 */
+			return -EINVAL;
+		histb_vdec_mpeg4_bs_skip(&bs, 1);		/* low_delay */
+		if (histb_vdec_mpeg4_bs_get(&bs, 1))
+			/* 15 m 15 m 15 m 3 11 m 15 m */
+			histb_vdec_mpeg4_bs_skip(&bs, 15 + 1 + 15 + 1 + 15 + 1 +
+						 3 + 11 + 1 + 15 + 1);
+	}
+
+	/*
+	 * video_object_layer_shape: rectangular only. Both reference decoders
+	 * number that shape 0 (the rectangular entry of their shape tables) and
+	 * every VOL measured here reads 0.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 2) != 0)
+		return -EINVAL;
+
+	/*
+	 * marker, time_increment_resolution, marker. The markers are skipped
+	 * rather than checked: the VOL writer emits '1' in each of these
+	 * positions (ffmpeg's encoder writes a literal one there), so a check
+	 * here would reject every real stream, which is why neither the vendor
+	 * firmware nor ffmpeg acts on the mismatch.
+	 */
+	histb_vdec_mpeg4_bs_skip(&bs, 1);
+	bits = histb_vdec_mpeg4_bs_get(&bs, 16);
+	histb_vdec_mpeg4_bs_skip(&bs, 1);
+	/*
+	 * vop_time_increment_resolution (14496-2 6.2.1) is the tick the picture
+	 * timing is counted in, so 0 has no use anywhere in this driver: it is
+	 * the multiplier of every time value below (time_incr_bits is derived
+	 * from it, and the B-VOP distances written to D3 are
+	 * (modulo_time_base * this + vop_time_increment) differences). A VOL
+	 * naming 0 makes both the width of vop_time_increment and the anchor
+	 * distances meaningless, so the configuration is refused rather than
+	 * cached with a bogus grid.
+	 */
+	if (!bits)
+		return -EINVAL;
+	vol->time_incr_res = bits;
+
+	/* the width of a vop_time_increment: bits needed for resolution - 1 */
+	vol->time_incr_bits = bits > 1 ? ilog2(bits - 1) + 1 : 1;
+
+	/* fixed_vop_rate, then fixed_vop_time_increment when it is set */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1))
+		histb_vdec_mpeg4_bs_skip(&bs, vol->time_incr_bits);
+
+	/* marker, width(13), marker, height(13), marker (markers skipped as
+	 * above; the vendor's own software decoder skips them outright too)
+	 */
+	histb_vdec_mpeg4_bs_skip(&bs, 1);
+	width = histb_vdec_mpeg4_bs_get(&bs, 13);
+	histb_vdec_mpeg4_bs_skip(&bs, 1);
+	height = histb_vdec_mpeg4_bs_get(&bs, 13);
+	histb_vdec_mpeg4_bs_skip(&bs, 1);
+	/*
+	 * video_object_layer_width/height (14496-2 6.2.1) are the grid every
+	 * later picture is measured on, and they are 13-bit fields: 0 has no
+	 * macroblock grid at all (histb_vdec_mpeg4_grid() would derive a total
+	 * of 0 from them, which the packet parse width ilog2(total - 1) and the
+	 * engine's macroblock count mb_total - 1 cannot express), and a size
+	 * beyond HISTB_VDEC_MAX_WIDTH/MAX_HEIGHT is one the format layer
+	 * neither advertises nor can clamp into a capture buffer, so no CAPTURE
+	 * geometry this job could be programmed against exists. Refused per VOL
+	 * rather than per picture: caching such a grid would mislabel every
+	 * later picture's descriptor range.
+	 */
+	if (!width || !height || width > HISTB_VDEC_MAX_WIDTH ||
+	    height > HISTB_VDEC_MAX_HEIGHT)
+		return -EINVAL;
+
+	/*
+	 * interlaced: a field picture is not a submission this driver can make
+	 * (one buffer per frame picture, no per-field descriptor), so an
+	 * interlaced VOL is refused - the same boundary the H.264 layer keeps.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1))
+		return -EINVAL;
+
+	/*
+	 * obmc_disable (14496-2 6.2.1): a VOL that clears it announces
+	 * overlapped-block motion compensation for every VOP of this sequence,
+	 * and the descriptor set has no input for it - the vendor firmware
+	 * keeps that flag in one of its MPEG-4 parameter blocks, but nothing in
+	 * its firmware or message program reads it, and the engine starts
+	 * reading at the descriptor's data bit, so it never sees the header.
+	 *
+	 * The H.263 picture header's same bit is deliberately consumed and
+	 * ignored instead (see histb_vdec_h263_pic()), on the measured argument
+	 * that OBMC changes prediction but never the syntax the engine walks.
+	 * This VOL gate has not been re-derived under that argument. TODO:
+	 * settle it with the same one-variable pair on an MPEG-4 stream - one
+	 * VOL with obmc_disable=1 and one identical VOL with it 0, coded
+	 * content that has a motion-vector discontinuity between neighbouring
+	 * macroblocks - and compare both against the software reference: if the
+	 * 0 arm stays inside the rounding band, this gate becomes
+	 * consume-and-ignore like its H.263 counterpart.
+	 */
+	if (!histb_vdec_mpeg4_bs_get(&bs, 1))
+		return -EINVAL;
+
+	/* vol_sprite_usage: GMC and sprite warping have no reachable descriptor
+	 * path in this port, so any sprite usage is refused.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, ver_id == 1 ? 1 : 2))
+		return -EINVAL;
+
+	/*
+	 * not_8_bit (14496-2 6.2.1): set, it opens the quant_precision,
+	 * vertical FDC length and horizontal FDC length fields and moves the
+	 * sample depth away from 8. Every consumer here is written for the
+	 * 8-bit, precision-5 shape: the quantiser travels in the descriptor's
+	 * 5-bit field, the matrix words carry one byte per coefficient, and the
+	 * capture format is the 8-bit tiled NV21 the board read back
+	 * byte-exactly. The firmware's own VOL walk refuses the same set.
+	 * Accepting it would need both a depth-carrying capture format and
+	 * measured matrix packing for that depth.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1))
+		return -EINVAL;
+
+	/*
+	 * vol_quant_type, then the two custom matrices the VOL may load. The
+	 * descriptor matrices are macroblock-order tables: the defaults, then
+	 * any loaded table (scan order, terminated by a zero byte, the
+	 * remaining entries replicating the last value). A quant_type=1 VOL
+	 * that loads nothing keeps the MPEG-4 defaults - the flat MPEG-2 tables
+	 * were seeded here once and scored worse on the board.
+	 */
+	vol->quant_type = histb_vdec_mpeg4_bs_get(&bs, 1);
+	if (vol->quant_type) {
+		for (load = 0; load < 2; load++) {
+			table = load ? vol->inter_matrix : vol->intra_matrix;
+			if (!histb_vdec_mpeg4_bs_get(&bs, 1))
+				continue;
+			last = 0;
+			for (i = 0; i < 64; i++) {
+				v = histb_vdec_mpeg4_bs_get(&bs, 8);
+				if (bs.err)
+					return bs.err;
+				if (!v)
+					break;
+				last = v;
+				table[histb_mp4_zigzag[i]] = v;
+			}
+			for (; i < 64; i++)
+				table[histb_mp4_zigzag[i]] = last;
+		}
+	}
+
+	/* quarter_sample, only from verid 2 on */
+	vol->quarter_sample = ver_id != 1 ? histb_vdec_mpeg4_bs_get(&bs, 1) : 0;
+
+	/*
+	 * complexity_estimation_disable: while the VOL keeps estimation
+	 * signalling, every VOP carries a data-dependent amount of estimation
+	 * data. The firmware layer refuses these streams and so does this
+	 * driver.
+	 */
+	if (!histb_vdec_mpeg4_bs_get(&bs, 1))
+		return -EINVAL;
+
+	vol->resync_marker_disable = histb_vdec_mpeg4_bs_get(&bs, 1);
+
+	/*
+	 * data_partitioned (14496-2 6.2.1), with the rvlc flag it guards behind
+	 * it: a partitioned slice is three independently decodable segments
+	 * (header, intra, inter) with their own start codes, while this
+	 * protocol gives each slice one window, one quantiser and one coding
+	 * type in the descriptor, and the engine consumes the window as one
+	 * continuous macroblock layer from its data bit. There is no field to
+	 * say "this slice continues in that other segment", so the shapes
+	 * cannot be expressed; the firmware syntax layer refuses them too (its
+	 * VOL checks report the same flags unsupported). Accepting one would
+	 * need the segment addresses and resynchronisation markers to become
+	 * per-slice inputs.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1))
+		return -EINVAL;
+
+	if (ver_id != 1) {
+		/*
+		 * newpred_enable (14496-2 6.2.1): the VOL then carries
+		 * newpred_times, and every macroblock may scale its motion
+		 * vectors by it instead of using the VOP's fcode pair. The
+		 * descriptor carries the picture's fcode_forward/backward only,
+		 * so the per-macroblock prediction would be programmed with the
+		 * wrong scale; the same argument refuses reduced_res_vop below.
+		 * The firmware walk rejects both.
+		 */
+		if (histb_vdec_mpeg4_bs_get(&bs, 1))	/* newpred_enable */
+			return -EINVAL;
+		/*
+		 * reduced_res_vop_enable (14496-2 6.2.1): VOPs smaller than the
+		 * VOL grid are legal from here on, and the reference then has
+		 * to be upsampled per VOP. This message states one grid (D4)
+		 * and one size (D5) for the picture and gives the engine the
+		 * reference addresses to read at that grid, so a smaller VOP
+		 * cannot be described at all; refusing is the only answer that
+		 * keeps the descriptors from naming rows the buffer does not
+		 * have.
+		 */
+		if (histb_vdec_mpeg4_bs_get(&bs, 1))	/* reduced_res_vop */
+			return -EINVAL;
+	}
+
+	/*
+	 * scalability (14496-2 6.2.1): a layered stream carries the enhancement
+	 * layers' own VOL/VOP syntax behind this flag, which this parser does
+	 * not walk, and the base-layer picture is not decodable without the
+	 * layer parameters the message has no words for. Refused with the rest
+	 * of the scalability family.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1))		/* scalability */
+		return -EINVAL;
+
+	if (bs.err)
+		return bs.err;
+
+	vol->width = width;
+	vol->height = height;
+	vol->parsed = true;
+
+	return 0;
+}
+
+/*
+ * Parse one MPEG-4 VOP header (14496-2 6.2.5) at the 0x000001B6 start code and
+ * return the first bit of the macroblock layer in @data_bit.
+ */
+static int histb_vdec_mpeg4_vop(const struct histb_vdec_mpeg4_vol *vol,
+				const u8 *buf, unsigned int size,
+				unsigned int pos,
+				struct histb_vdec_mpeg4_pic *pic,
+				unsigned int *data_bit)
+{
+	unsigned int limit = size * 8;
+	unsigned int p = pos * 8 + 32;
+	unsigned int type, run;
+
+	/* vop_coding_type; N-VOPs carry S-VOPs, and sprite usage is refused by
+	 * the VOL parser, so only I/P/B are acceptable.
+	 */
+	type = histb_vdec_mpeg4_bits(buf, p, 2);
+	/*
+	 * 14496-2 table 6-2 codes vop_coding_type, and 3 names the N-VOP: its
+	 * sprite/GMC reference signalling is what vol_sprite_usage announces,
+	 * and the VOL gate above refuses that configuration, so no stream this
+	 * driver accepts can legitimately reach here with the value set.
+	 * Reaching it means the parse is not at a VOP header, which is why the
+	 * picture is refused rather than re-read at another position: the
+	 * macroblock layer address every descriptor needs is derived from this
+	 * header's length.
+	 */
+	if (type > HISTB_MPEG4_B_VOP)
+		return -EINVAL;
+	p += 2;
+
+	/* modulo_time_base: a run of ones, a terminating zero, marker one */
+	run = 0;
+	while (run < 512 && p < limit && histb_vdec_mpeg4_bit(buf, p)) {
+		p += 1;
+		run++;
+	}
+	/*
+	 * The run is open-ended in the syntax (one '1' per second), so 512 is
+	 * this walk's bound rather than 14496-2's: a longer run cannot be a
+	 * picture timing field, and letting the loop run on would scan most of
+	 * the OUTPUT plane looking for a zero bit. The packet header's extended
+	 * timing fields stop at the same count, so both walks refuse the same
+	 * shape.
+	 */
+	if (run >= 512)
+		return -EINVAL;
+	/*
+	 * The rest of the fixed header - terminating zero, marker,
+	 * vop_time_increment, marker, vop_coded - has to sit inside the
+	 * submitted span, because @p is published as the first bit of the
+	 * macroblock layer and the descriptor window is measured from it. A VOP
+	 * header cut by the buffer end is refused here rather than read past
+	 * the mapping.
+	 */
+	if (p + 2 + vol->time_incr_bits + 2 > limit)
+		return -EINVAL;
+	p += 1 + 1;		/* terminating zero + marker */
+	pic->time_modulo = run;
+	pic->time_increment = histb_vdec_mpeg4_bits(buf, p, vol->time_incr_bits);
+	p += vol->time_incr_bits;
+
+	/* marker before vop_coded, then vop_coded */
+	/*
+	 * The marker here is checked, unlike the VOL's markers: encoders write
+	 * '1' in this position (the VOP writer's one-bit put) and a 0 means
+	 * this walk is not at the start of a VOP header. Every field after it -
+	 * and therefore the macroblock layer address - is positioned by this
+	 * bit, so a mismatch ends the picture; guessing it is the +112/-class
+	 * failure of the MPEG-2 path, one wrong bit moving the whole macroblock
+	 * layer.
+	 */
+	if (!histb_vdec_mpeg4_bit(buf, p))
+		return -EINVAL;
+	p += 1;
+	/*
+	 * vop_coded = 0 is the skipped picture of 14496-2 6.2.5: it carries no
+	 * macroblock layer at all, the display is supposed to repeat the
+	 * previous anchor, and a stateless job that names no slice data cannot
+	 * be programmed (the engine would be handed whatever follows in the
+	 * buffer and CFG0 would still announce mb_total macroblocks). The
+	 * client's answer for a skipped picture is to submit nothing.
+	 */
+	if (!histb_vdec_mpeg4_bit(buf, p))	/* a skipped VOP has no data */
+		return -EINVAL;
+	p += 1;
+
+	pic->coding_type = type;
+
+	/* vop_rounding_type is carried for P-VOPs only */
+	pic->rounding = 0;
+	if (type == HISTB_MPEG4_P_VOP) {
+		/*
+		 * From here to the end of the header every read is guarded the
+		 * same way: the field has to lie inside the submitted span, or
+		 * the position published as the macroblock layer's first bit
+		 * would be outside the buffer the descriptors address. These
+		 * guards read like boilerplate, but each one stands in front of
+		 * a histb_vdec_mpeg4_bits() call that does no bounds checking
+		 * of its own, so dropping any of them turns a truncated VOP
+		 * header into a read beyond the plane mapping rather than a
+		 * refusal.
+		 */
+		if (p >= limit)
+			return -EINVAL;
+		pic->rounding = histb_vdec_mpeg4_bit(buf, p);
+		p += 1;
+	}
+
+	/* No complexity-estimation data is carried (VOL gate). */
+
+	/*
+	 * intra_dc_vlc_threshold (14496-2 6.2.5) is the next read and the
+	 * descriptor's bits 9:7 come straight from it, so a header the
+	 * submitted span cuts inside this field cannot be walked: the value
+	 * would be taken from bytes the buffer does not contain and the
+	 * macroblock layer start published below would land outside the
+	 * picture.
+	 */
+	if (p + 3 > limit)
+		return -EINVAL;
+	pic->intra_dc_vlc_thr = histb_vdec_mpeg4_bits(buf, p, 3);
+	p += 3;
+
+	/* top_field_first / alternate_vertical_scan are only carried by an
+	 * interlaced VOL, which is refused, so they stay 0.
+	 */
+
+	/*
+	 * Same guard for vop_quant, the 5-bit field of 14496-2 6.2.5 that
+	 * picture message D1 and every descriptor carry: the five bits have to
+	 * be inside the span before the read, because the uncapped
+	 * histb_vdec_mpeg4_bits() below would otherwise walk past the plane
+	 * mapping and the picture would be programmed from the bytes that
+	 * happen to follow it.
+	 */
+	if (p + 5 > limit)
+		return -EINVAL;
+	pic->quant = histb_vdec_mpeg4_bits(buf, p, 5);
+	/*
+	 * vop_quant is the 5-bit field of 14496-2 6.2.5 and 0 is not a usable
+	 * scale: it is the divisor of the dequantiser on the way in and the
+	 * value the picture message carries in D1 bits 30:26, so a zero picture
+	 * would be programmed with a step the engine cannot apply. The
+	 * firmware's own walk shows the alternative it chose - rewriting a zero
+	 * vop_quant to 1 and carrying on - which decodes against a scale the
+	 * stream never declared, so this driver refuses instead of
+	 * substituting. The upper bound only restates the width of the field.
+	 */
+	if (!pic->quant || pic->quant > 31)
+		return -EINVAL;
+	p += 5;
+
+	pic->fcode_fwd = 1;
+	pic->fcode_bwd = 1;
+	if (type != HISTB_MPEG4_I_VOP) {
+		/*
+		 * The bound for the fcode read: an inter picture whose 3 bits
+		 * are cut by the span end has no motion-vector range and, for
+		 * MPEG-4 packets, no start-code prefix length either (both come
+		 * from this field), so the picture cannot be windowed; refusing
+		 * it keeps the read inside the mapping.
+		 */
+		if (p + 3 > limit)
+			return -EINVAL;
+		pic->fcode_fwd = histb_vdec_mpeg4_bits(buf, p, 3);
+		/*
+		 * 14496-2 6.2.5 gives fcode_forward the range 1..7 and 0 is not
+		 * a code any consumer could use: the descriptor carries it
+		 * verbatim as the vector range, and
+		 * histb_vdec_mpeg4_packet_prefix() turns it into the length of
+		 * this picture's video packet start code, so a zero here means
+		 * the walk is not at a VOP header at all.
+		 */
+		if (!pic->fcode_fwd)
+			return -EINVAL;
+		p += 3;
+	}
+	if (type == HISTB_MPEG4_B_VOP) {
+		/*
+		 * The same bound as the forward side of 14496-2 6.2.5: an I-VOP
+		 * carries no fcode at all, so this read only happens for a
+		 * B-VOP and its three bits have to be inside the span like
+		 * every other field whose value reaches the descriptors.
+		 */
+		if (p + 3 > limit)
+			return -EINVAL;
+		pic->fcode_bwd = histb_vdec_mpeg4_bits(buf, p, 3);
+		/*
+		 * fcode_backward of 14496-2 6.2.5, same 1..7 range and the same
+		 * two consumers as the forward side: the descriptor's
+		 * vector-range field and, through
+		 * histb_vdec_mpeg4_packet_prefix(), the prefix length of this
+		 * picture's video packet start code.
+		 */
+		if (!pic->fcode_bwd)
+			return -EINVAL;
+		p += 3;
+	}
+
+	/*
+	 * The position published as the macroblock layer's first bit has to be
+	 * inside the submitted span: every descriptor window is measured from it,
+	 * and a start past the end would have the engine read the bytes after this
+	 * buffer's mapping. Nothing in the walk above leaves @p able to pass
+	 * @limit, so this is the invariant stated once more at the exit rather
+	 * than a stream shape; a picture that really trips it is one whose header
+	 * fields were misread, which is the class of defect that costs the whole
+	 * picture rather than one macroblock.
+	 */
+	if (p > limit)
+		return -EINVAL;
+
+	pic->width = vol->width;
+	pic->height = vol->height;
+	pic->quarter_sample = vol->quarter_sample;
+	pic->resync_marker_disable = vol->resync_marker_disable;
+	pic->time_incr_bits = vol->time_incr_bits;
+	pic->quant_type = vol->quant_type;
+	*data_bit = p;
+
+	return 0;
+}
+
+/* -------------------------------------------------- H.263 header parsing */
+
+/*
+ * H.263 source_format to picture size, the table the vendor's software decoder
+ * carries: the two extended-format entries it leaves out are the ones whose
+ * size is signalled in the header instead.
+ */
+static const u16 histb_h263_format[6][2] = {
+	{ 0, 0 }, { 128, 96 }, { 176, 144 },
+	{ 352, 288 }, { 704, 576 }, { 1408, 1152 },
+};
+
+/*
+ * Locate and walk an H.263 picture header: the 22-bit picture start code 0x20
+ * at a byte boundary, the 8-bit temporal reference, then the PTYPE. Only the
+ * H.263v1 PTYPE is accepted - source_format 6 and 7 are the H.263+ extended
+ * PTYPE, whose custom size, BILME and rounding-control fields have no
+ * descriptor input, and 0 is reserved. The fields this returns are everything
+ * the messages need from this syntax: the grid from source_format, and the type
+ * and quantiser, which for a picture with no Annex-E group headers have no
+ * other carrier.
+ */
+static int histb_vdec_h263_pic(struct histb_vdec_mpeg4_pic *pic, const u8 *buf,
+			       unsigned int size, unsigned int *data_bit)
+{
+	struct histb_vdec_mpeg4_bs bs;
+	unsigned int i, format;
+
+	for (i = 0; i + 4 <= size; i++) {
+		/* 16 zero bits, the '1' of the start code, and the two low bits
+		 * of that byte belong to the temporal reference
+		 */
+		if (!buf[i] && !buf[i + 1] && (buf[i + 2] & 0xfc) == 0x80)
+			break;
+	}
+	/*
+	 * No byte-aligned picture start code in the span (the 22-bit pattern of
+	 * ITU-T H.263 6.2.5 with its Annex G short header: sixteen zero bits,
+	 * the '1', then the 8-bit temporal reference). This buffer then carries
+	 * no H.263 picture header, and there is no VOL to fall back on for the
+	 * grid the way MPEG-4 has - source_format here is the only carrier of
+	 * the picture size, the type and the quantiser - so the job ends
+	 * instead of being programmed from the grid a previous picture cached.
+	 */
+	if (i + 4 > size)
+		return -EINVAL;
+
+	bs.buf = buf;
+	bs.limit = size * 8;
+	bs.p = i * 8 + 30;	/* start code (22) + temporal reference (8) */
+	bs.err = 0;
+
+	/* marker, H.263 identification and the split-screen, camera and freeze
+	 * signalling: the vendor firmware warns on the first two and skips the
+	 * rest, and none of them reaches a descriptor, so they are consumed
+	 * here without gating on them.
+	 */
+	histb_vdec_mpeg4_bs_skip(&bs, 5);
+
+	format = histb_vdec_mpeg4_bs_get(&bs, 3);
+	/*
+	 * source_format (ITU-T H.263 Annex C table, which the sizes in
+	 * histb_h263_format[] transcribe) is how this header states the picture
+	 * geometry: 0 is reserved and 6/7 are the H.263+ extended PTYPE, which
+	 * moves the size into its own custom-picture-format fields along with
+	 * the BILME and rounding-control signalling - none of which has a
+	 * descriptor input, and the firmware's short-header walk only has
+	 * group-geometry entries through 4CIF before it rejects the larger
+	 * formats. So the grid cannot be named for 0, 6 or 7 and the picture is
+	 * refused; accepting one needs the custom size path plus the Annex
+	 * I/D/J fields. 16CIF (5) is read here and refused one gate later,
+	 * where picture message D2 cannot state its group geometry.
+	 */
+	if (format < 1 || format > 5)
+		return -EINVAL;
+
+	/* intra/inter, then unrestricted vector range and slice-based coding,
+	 * both of which change what the macroblock layer means and neither of
+	 * which the descriptor set can state, so they are refused. The OBMC bit
+	 * between them and the PB-frame flag has the same no-input status but a
+	 * different consequence: it only changes prediction, never the syntax
+	 * the engine walks, and this engine generation has no field for it at
+	 * all - the obmc_disable flag the vendor firmware keeps in one
+	 * parameter structure has no consumer anywhere in its message program,
+	 * and the engine starts reading at the descriptor's data bit, so it
+	 * never sees this header. Decoding without the overlapped smoothing is
+	 * what the vendor's own product delivers, so the bit is consumed and
+	 * ignored rather than gating the picture.
+	 */
+	pic->coding_type = histb_vdec_mpeg4_bs_get(&bs, 1);
+	/*
+	 * The two bits are unrestricted_motion_vector and
+	 * slice_based_coding_flag (ITU-T H.263 Annex G picture header). URR
+	 * widens every motion-vector range in the picture and SBC changes what
+	 * the macroblock layer means (slice groups signalled as groups rather
+	 * than as whole rows), and the descriptor set can state neither: a
+	 * short-header picture carries no fcode for the wider vector range to
+	 * be scaled by, and there is no group-geometry word. The firmware's own
+	 * walk skips these four bits as one group immediately before the
+	 * quantiser and acts on none of them, so a product built on it decodes
+	 * such streams with the plain interpretation; this driver refuses them
+	 * because the delivered pixels then do not match the standard.
+	 * Accepting them needs engine inputs for the vector range and for
+	 * slice-group geometry. The OBMC bit between these and the PB flag is
+	 * consumed and ignored instead - the paragraph above is the measured
+	 * reason for that difference.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1) || histb_vdec_mpeg4_bs_get(&bs, 1))
+		return -EINVAL;
+	histb_vdec_mpeg4_bs_skip(&bs, 1);		/* OBMC */
+	/*
+	 * pb_frame_flag: an H.263+ PB picture is two coded frames behind one
+	 * header. One OUTPUT submission is one picture written to one CAPTURE
+	 * buffer, and neither the picture message nor the descriptors name a
+	 * second target, so the shape has no representation here; the firmware
+	 * skips this bit with the three above and would be handed one job for
+	 * what the syntax says are two frames.
+	 */
+	if (histb_vdec_mpeg4_bs_get(&bs, 1))		/* PB frame */
+		return -EINVAL;
+
+	pic->quant = histb_vdec_mpeg4_bs_get(&bs, 5);
+	histb_vdec_mpeg4_bs_skip(&bs, 1);		/* continuous presence */
+	/*
+	 * bs.err means the PTYPE ran out of the submitted span, so nothing read
+	 * above this - the grid among it - was complete. QSCALE 0 is not a
+	 * quantiser: for a picture with no Annex-E group headers this short
+	 * header is the only carrier of the value, and it goes to picture
+	 * message D1 bits 30:26, where a zero step has nothing for the
+	 * dequantiser to divide by. The firmware's own walk shows the
+	 * alternative it chose - rewriting a zero vop_quant to 1 and carrying
+	 * on, at the store that follows this field - which decodes against a
+	 * scale the stream never declared, so this driver refuses instead of
+	 * substituting.
+	 */
+	if (bs.err || !pic->quant)
+		return -EINVAL;
+
+	/* The header's "1 stop bit, 8 data bits" trailer, which the vendor
+	 * firmware loops over after the continuous-presence flag and bounds at
+	 * sixteen data words. The macroblock layer starts after the terminating
+	 * zero: a picture whose groups are addressed by number has no start
+	 * code before the first one for the engine to resync on, so leaving the
+	 * trailer unconsumed costs exactly the leading group - the board showed
+	 * it as one wrong macroblock row of an Annex-E picture.
+	 */
+	for (i = 0; i < 16; i++) {
+		if (histb_vdec_mpeg4_bs_get(&bs, 1))
+			histb_vdec_mpeg4_bs_skip(&bs, 8);
+		else
+			break;
+	}
+
+	pic->width = histb_h263_format[format][0];
+	pic->height = histb_h263_format[format][1];
+	pic->short_header = true;
+	*data_bit = bs.p;
+
+	return 0;
+}
+
+/* ------------------------------------------------------- slice discovery */
+
+/*
+ * Length of the zero run in front of an MPEG-4 video packet start code (14496-2
+ * 6.2.5.1.4; the firmware syntax layer and the vendor software decoder use the
+ * same expression): 16 for an I-VOP, fcode_forward + 15 for P,
+ * max(fcode_forward, fcode_backward, 2) + 15 for B.
+ */
+static unsigned int
+histb_vdec_mpeg4_packet_prefix(const struct histb_vdec_mpeg4_pic *pic)
+{
+	if (pic->coding_type == HISTB_MPEG4_I_VOP)
+		return 16;
+	if (pic->coding_type == HISTB_MPEG4_P_VOP)
+		return pic->fcode_fwd + 15;
+	return max(max(pic->fcode_fwd, pic->fcode_bwd), 2U) + 15;
+}
+
+/*
+ * Read one MPEG-4 video packet header whose zero run starts at bit @pos.
+ * mbk_number is the first macroblock of the packet; its width is the bit length
+ * of the macroblock total, which is what both the firmware's packet walk and
+ * the slice descriptor carry.
+ */
+static int histb_vdec_mpeg4_packet(const u8 *buf, unsigned int size,
+				   unsigned int pos, unsigned int prefix,
+				   const struct histb_vdec_mpeg4_pic *pic,
+				   struct histb_vdec_mpeg4_slice *sl)
+{
+	unsigned int limit = size * 8;
+	unsigned int p = pos, run, bits;
+
+	/* the zero run, its terminating '1', the macroblock number, the
+	 * quantiser, the extension flag and, for an extended header, at least a
+	 * two-bit type and a three-bit threshold: everything read before the
+	 * next bounds check fits in this.
+	 *
+	 * -ENOENT here is the answer "this byte is not a header", not an error
+	 * under 14496-2 6.2.5.1.4: histb_vdec_mpeg4_slice_headers() steps to
+	 * the next byte-aligned position and keeps looking, and when the scan
+	 * runs out of span it returns the chain found so far. That is the
+	 * intended shape for an MPEG-4 packet picture, whose last window is
+	 * declared to the end of the span precisely so that a stream with a
+	 * missing tail still terminates; what must not happen is a header read
+	 * past the mapping, and that is what this bound exists for: the 14496-2
+	 * 6.2.5.1.4 packet header is a fixed-length prefix, so a span that
+	 * cannot hold it holds no header.
+	 */
+	if (p + prefix + 1 + pic->mb_bits + 5 + 1 + 2 + 1 + 3 > limit)
+		return -ENOENT;
+	/*
+	 * The run has to be exactly @prefix bits. 14496-2 6.2.5.1.4 gives this
+	 * picture's video packet code that many leading zeros - 16 for an
+	 * I-VOP, fcode_forward + 15 for a P-VOP, max(fcode_forward,
+	 * fcode_backward, 2) + 15 for a B-VOP, as
+	 * histb_vdec_mpeg4_packet_prefix() computes - and the two other shapes
+	 * are both things this function must not read as a header: a shorter
+	 * run is an ordinary macroblock codeword, and a longer one is a 32-bit
+	 * start code (a byte-aligned 00 00 01 is a run of 23 zeros, which is
+	 * why the picture's own data can never be mistaken for one of these
+	 * codes either). The length is matched exactly rather than as a minimum
+	 * because a false hit inside macroblock data has to be excluded by what
+	 * it looks like, which is the rule the caller states.
+	 */
+	if (histb_vdec_mpeg4_zero_run(buf, p, prefix + 1) != prefix)
+		return -ENOENT;
+	/*
+	 * The '1' that closes the video packet code and separates it from
+	 * mbk_number (14496-2 6.2.5.1.4). The exact-length run above already
+	 * implies it, since a run that stops at @prefix bits has a set bit at
+	 * its end; it is retested so that the scan cannot be handed a code
+	 * position whose fields start one bit early if the length test ever
+	 * changes - an off-by-one here is the same class of defect that costs
+	 * the whole macroblock layer its alignment.
+	 */
+	if (!histb_vdec_mpeg4_bit(buf, p + prefix))
+		return -ENOENT;
+	p += prefix + 1;
+
+	bits = histb_vdec_mpeg4_bits(buf, p, pic->mb_bits);
+	/*
+	 * mbk_number names the packet's first macroblock, so a value at or
+	 * above the grid total is not a header of this picture: either the
+	 * field was read at the wrong position (the parse width comes from this
+	 * VOL, so a picture whose grid disagrees with it lands here) or it is a
+	 * false hit in macroblock data. Neither can be windowed: the value is
+	 * published as the descriptor's start_mbn, and the previous packet's
+	 * end_mbn is derived from it as start_mbn - 1, so an out-of-range
+	 * number would address macroblocks the picture has no rows for. The
+	 * vendor's video packet walk compares it with the same macroblock total
+	 * and reports the mismatch instead of building a descriptor.
+	 */
+	if (bits >= pic->mb_total)
+		return -ENOENT;
+	p += pic->mb_bits;
+
+	run = histb_vdec_mpeg4_bits(buf, p, 5);
+	/*
+	 * The packet quantiser is that 5-bit field and 0 is not a scale: the
+	 * value is carried to the engine verbatim in descriptor word 4, so
+	 * there is no arithmetic here that could give a zero a meaning. The
+	 * firmware's own picture-level walk shows what the alternative is: it
+	 * rewrites a zero vop_quant to 1 where it stores the picture quantiser
+	 * and carries on, decoding against a scale the stream never declared,
+	 * while the same routine stores this packet field without any range
+	 * check at all. Refusing is the honest answer, and the scored corpus
+	 * pays nothing for it: its refusals all belong to the other gates. The
+	 * upper bound only restates the field's width.
+	 */
+	if (!run || run > 31)
+		return -ENOENT;
+	p += 5;
+
+	sl->start_mbn = bits;
+	sl->quant = run;
+	sl->coding_type = pic->coding_type;
+	sl->intra_dc_vlc_thr = pic->intra_dc_vlc_thr;
+
+	/* header_extension: the packet carries its own timing and, for a
+	 * non-intra packet, its own intra_dc_vlc_threshold. The fcode fields
+	 * are consumed for position only - the vendor's video-packet slice walk
+	 * skips them and the descriptor keeps the picture-level fcode.
+	 */
+	if (histb_vdec_mpeg4_bit(buf, p)) {
+		p += 1;
+		run = 0;
+		while (run < 512 && p < limit && histb_vdec_mpeg4_bit(buf, p)) {
+			p += 1;
+			run++;
+		}
+		/*
+		 * Once the extension flag reads 1 this is an extended video
+		 * packet header (14496-2 6.2.5.1.4), so the answer flips from
+		 * -ENOENT to -EINVAL: the header has been recognised, and its
+		 * position cannot be recovered without walking the macroblock
+		 * layer to find where the timing fields end. Returning -ENOENT
+		 * instead would make the caller look past a real header, window
+		 * the previous packet over this one's data, and deliver a
+		 * picture whose every later codeword is misaligned. The 512
+		 * bound is a guard against an open-ended field, not a syntax
+		 * limit - modulo_time_base is one bit per second - and the
+		 * picture-level VOP walk stops at the same count, so a stream
+		 * that really carries 512 seconds of run is refused identically
+		 * in both places.
+		 */
+		if (run >= 512 ||
+		    p + 2 + pic->time_incr_bits + 9 > limit)
+			return -EINVAL;
+		p += 2;		/* terminating zero + marker */
+		p += pic->time_incr_bits;
+		/* marker, ignored as the vendor firmware ignores it */
+		p += 1;
+		bits = histb_vdec_mpeg4_bits(buf, p, 2);
+		/*
+		 * The packet's own vop_coding_type. 3 is the one value outside
+		 * the I/P/B triple this engine is programmed for - it names the
+		 * N-VOP, whose shape the VOL gate rejects on the way in
+		 * (vol_sprite_usage), so a packet claiming it here cannot be
+		 * described in descriptor word 4's two coding-type bits either.
+		 * As with the timing fields, the header is already recognised,
+		 * so this is the picture that is refused and not the byte
+		 * position; the picture-level walk applies the identical bound
+		 * to the same field.
+		 */
+		if (bits > HISTB_MPEG4_B_VOP)
+			return -EINVAL;
+		p += 2;
+		sl->coding_type = bits;
+		sl->intra_dc_vlc_thr = histb_vdec_mpeg4_bits(buf, p, 3);
+		p += 3;
+		if (sl->coding_type != HISTB_MPEG4_I_VOP)
+			p += 3;		/* fcode_for */
+		if (sl->coding_type == HISTB_MPEG4_B_VOP)
+			p += 3;		/* fcode_back */
+	} else {
+		p += 1;
+	}
+
+	/*
+	 * The last invariant before this position is published: sl->data_bit
+	 * becomes the descriptor's window start, and the window length is
+	 * computed from it as end_bit - data_bit
+	 * (histb_vdec_mpeg4_pack_slice()), so a start beyond the submitted span
+	 * would declare a nonsense length over bytes this buffer does not
+	 * describe. Every read above is bounded, so this arm answers a position
+	 * that drifted rather than a stream shape; it is -EINVAL and not
+	 * -ENOENT because the header itself was recognised, and a picture with
+	 * an unreadable packet position has no window left to declare.
+	 */
+	if (p > limit)
+		return -EINVAL;
+	sl->data_bit = p;
+
+	return 0;
+}
+
+/*
+ * Read one H.263 Annex-E group-of-block header at bit @pos: sixteen zero bits,
+ * a '1', GN = u(5), GFID = u(2), GQUANT = u(5). The encoder writes exactly
+ * that, and the vendor firmware reads exactly that: its short-header slice walk
+ * skips 17 bits from the start-code position, then 5 + 2 + 5.
+ *
+ * GN counts groups from zero here, the way both vendor paths turn it into a
+ * macroblock number - the slice descriptor's start macroblock is the group
+ * number times the group height, and the vendor's software decoder scales its
+ * row index the same way - so the standard's 1-based group number would push
+ * the last group past the grid, which is the check right below.
+ *
+ * GFID is not used: the group's macroblock layer carries the intra flag per
+ * macroblock, so the firmware skips those two bits and gives every group the
+ * picture's coding type.
+ */
+static int histb_vdec_h263_gob(const u8 *buf, unsigned int size,
+			       unsigned int pos,
+			       const struct histb_vdec_mpeg4_pic *pic,
+			       struct histb_vdec_mpeg4_slice *sl)
+{
+	unsigned int limit = size * 8;
+	unsigned int p = pos, gbid, gfid, quant;
+
+	/*
+	 * Same shape rule as the MPEG-4 packet scan: the group start code of
+	 * ITU-T H.263 Annex I is sixteen zero bits closed by a '1', so a
+	 * shorter or longer run is macroblock data or a real start code and not
+	 * a header here. -ENOENT keeps the caller's byte scan moving rather
+	 * than refusing the picture, because a group chain is only required to
+	 * be found where the groups actually are; the coverage rule at the end
+	 * of histb_vdec_mpeg4_slice_headers() is what turns a chain that stops
+	 * short of the grid into a refusal.
+	 */
+	if (histb_vdec_mpeg4_zero_run(buf, p, 17) != 16)
+		return -ENOENT;
+	/* The closing '1' of the group start code; implied by the run test
+	 * above and kept so a future change there cannot hand this function a
+	 * group whose GN field starts one bit early.
+	 */
+	if (!histb_vdec_mpeg4_bit(buf, p + 16))
+		return -ENOENT;
+	p += 17;
+	/*
+	 * GN(5) + GFID(2) + GQUANT(5), the twelve bits of ITU-T H.263 Annex I's
+	 * group header, have to be inside the span: all three are published,
+	 * the group number as the descriptor's macroblock range and GQUANT as
+	 * its quantiser, so a header the buffer only holds half of cannot be
+	 * turned into a window. -EINVAL rather than the -ENOENT above, because
+	 * at this point the group start code *was* recognised.
+	 */
+	if (p + 12 > limit)
+		return -EINVAL;
+
+	gbid = histb_vdec_mpeg4_bits(buf, p, 5);
+	gfid = histb_vdec_mpeg4_bits(buf, p + 5, 2);
+	quant = histb_vdec_mpeg4_bits(buf, p + 7, 5);
+	p += 12;
+
+	/*
+	 * Three reasons to answer "not a group header" (-ENOENT) and let the
+	 * caller's scan keep moving: GFID 2 and 3 are the reserved pair of
+	 * ITU-T H.263 Annex I that selects a group allocation table rather than
+	 * saying intra or inter, GQUANT 0 is not a quantiser step (the
+	 * firmware's walk substitutes 1 and carries on where it stores the
+	 * picture quantiser, which decodes at a scale the stream never
+	 * declared), and a value above the 5-bit field cannot come from this
+	 * syntax at all. The picture is not lost by this answer: the chain
+	 * coverage rule in histb_vdec_mpeg4_slice_headers() refuses the group
+	 * stream that stops short of the grid, which is what a mid-chain
+	 * unsupported header produces. Measured on the board with the eighth
+	 * group's GFID set to an allocation-table value: with only this arm
+	 * answering, the picture was accepted and every macroblock row from 8
+	 * down came out wrong - 84480 bytes of a CIF frame, max 250, rows 0..7
+	 * byte-exact.
+	 */
+	if (gfid > 1 || !quant || quant > 31)
+		return -ENOENT;
+
+	sl->start_mbn = gbid * pic->mb_per_gob;
+	/*
+	 * A group number whose product leaves the grid cannot be windowed: the
+	 * value goes into this descriptor as start_mbn and into the previous
+	 * group's record as end_mbn - 1, so the chain would address macroblocks
+	 * the capture buffer has no rows for and the engine would decode past
+	 * the picture. This is a refusal rather than a scan answer because the
+	 * group start code *was* recognised - only its number is impossible.
+	 * The vendor's own walk bounds it the same way: both its short-header
+	 * slice routine and the software decoder compare the derived macroblock
+	 * against the grid total, with the group number counted from zero as
+	 * here.
+	 */
+	if (sl->start_mbn > pic->mb_total - 1)
+		return -EINVAL;
+	sl->quant = quant;
+	sl->coding_type = pic->coding_type;
+	sl->intra_dc_vlc_thr = 0;
+	sl->data_bit = p;
+
+	return 0;
+}
+
+/*
+ * Collect the slice headers of one picture into @sls and return their count.
+ *
+ * A picture without resync markers is one slice spanning the whole grid, the
+ * shape the vendor's descriptors take when the stream carries no packet header.
+ * Otherwise headers are found by their bit pattern; a false hit inside
+ * macroblock data would have to look like a valid header, so the exact
+ * zero-prefix length for this picture, an in-range macroblock number, a
+ * non-zero quantiser and a strictly increasing macroblock number are all
+ * required. Encoders byte-align before every slice header (the MPEG-4 packet
+ * and H.263 GOB writers both assert it), so only byte positions are tried - the
+ * same scan the firmware's resync search makes.
+ *
+ * A picture whose first header does not open the grid gets a leading slice
+ * covering macroblock 0 up to that header, built here rather than by the
+ * vendor's synthesis branch (see below); the returned chain always starts at
+ * macroblock 0 and is contiguous.
+ */
+static int histb_vdec_mpeg4_slice_headers(const u8 *buf, unsigned int size,
+					  const struct histb_vdec_mpeg4_pic *pic,
+					  unsigned int data_bit,
+					  struct histb_vdec_mpeg4_slice *sls,
+					  unsigned int max)
+{
+	struct histb_vdec_mpeg4_slice sl;
+	unsigned int n = 0, pos = data_bit, prefix = 0, last = 0;
+	unsigned int step;
+	int ret;
+
+	if (!pic->short_header && pic->resync_marker_disable) {
+		sls[0].data_bit = data_bit;
+		sls[0].start_mbn = 0;
+		sls[0].quant = pic->quant;
+		sls[0].coding_type = pic->coding_type;
+		sls[0].intra_dc_vlc_thr = pic->intra_dc_vlc_thr;
+		return 1;
+	}
+
+	/* A GOB chain has a fixed stride and ends with the last macroblock row;
+	 * MPEG-4 packets state their own start, so the only stop condition
+	 * there is that no further header is found.
+	 */
+	step = pic->short_header ? pic->mb_per_gob : 0;
+	if (!pic->short_header)
+		prefix = histb_vdec_mpeg4_packet_prefix(pic);
+
+	while (n < max) {
+		pos = n ? sls[n - 1].data_bit : data_bit;
+
+		for (;;) {
+			if (pos + prefix + 17 >= size * 8) {
+				/* A short-header picture whose stream carries
+				 * no group header at all cannot be given to
+				 * this engine: the firmware's short-header walk
+				 * reads a group header before every group,
+				 * skipping the 17-bit start code then reading
+				 * GN, GFID and GQUANT, so Annex E is not a
+				 * layout the driver may fake. The board showed
+				 * the consequence of trying - a header-less
+				 * QCIF picture decoded as a flat black frame
+				 * with either group count stated in D1, one
+				 * group for the whole grid or one group per
+				 * macroblock row. Accepting one would need the
+				 * engine to walk its macroblock layer without
+				 * consuming a group header per group, which
+				 * short-header mode does not do.
+				 */
+				if (!n)
+					return -EINVAL;
+				/* The coverage rule below applies here too: a
+				 * chain that runs out of stream before the grid
+				 * ends is a picture whose later headers are not
+				 * readable here, and an unsupported GFID is the
+				 * case measured on the board.
+				 */
+				if (pic->short_header &&
+				    last + step != pic->mb_total)
+					return -EINVAL;
+				return n;
+			}
+
+			if (pic->short_header)
+				ret = histb_vdec_h263_gob(buf, size, pos,
+							  pic, &sl);
+			else
+				ret = histb_vdec_mpeg4_packet(buf, size, pos,
+							      prefix, pic,
+							      &sl);
+			if (ret != -ENOENT)
+				break;
+			pos = (pos + 8) & ~7U;
+		}
+		if (ret)
+			return ret;
+		/*
+		 * The picture's first macroblock need not open with a header:
+		 * the data before the first packet header is a packet of its
+		 * own starting at grid position 0 (the corpus's Lavc-encoded
+		 * I-VOP has its first header at macroblock 88). The vendor
+		 * firmware's MPEG-4 slice packer synthesises a leading slot for
+		 * that case, when the first descriptor's start macroblock is
+		 * not 0, but gives it the *next* packet's address with a zero
+		 * length and then indexes the real slots 128 bytes per skipped
+		 * macroblock instead of 32, which breaks the chain it just
+		 * wrote; the leading slot is therefore built here, from this
+		 * picture's own data start, and the chain stays contiguous.
+		 */
+		if (!n && sl.start_mbn) {
+			sls[0].data_bit = data_bit;
+			sls[0].start_mbn = 0;
+			sls[0].quant = pic->quant;
+			sls[0].coding_type = pic->coding_type;
+			sls[0].intra_dc_vlc_thr = pic->intra_dc_vlc_thr;
+			n = 1;
+		} else if (n && sl.start_mbn <= last) {
+			return -EINVAL;
+		}
+
+		sls[n++] = sl;
+		last = sl.start_mbn;
+		if (step && last + step >= pic->mb_total)
+			break;
+	}
+
+	/*
+	 * A group chain has to reach the end of the grid. Groups are addressed
+	 * by number with a fixed stride, so a chain that stops early can only
+	 * mean the headers after that point are unreadable here, and the
+	 * picture would be programmed with one window running to the end of the
+	 * buffer over data that is not macroblock layer. The board case is
+	 * Annex F: with the eighth group's GFID set to an allocation table the
+	 * driver does not carry, the picture was accepted and decoded wrong
+	 * from macroblock row 8 down - 84480 bytes of a CIF frame, max 250,
+	 * rows 0..7 byte exact.
+	 */
+	if (pic->short_header && last + step != pic->mb_total)
+		return -EINVAL;
+
+	return n;
+}
+
+/* ------------------------------------------------------- message packing */
+
+/*
+ * Vendor matrix word layout: word 28 + 2 * column + row parity holds the
+ * entries of that column whose row is congruent to the parity modulo two, least
+ * significant byte first (this is how the vendor firmware's MPEG-4
+ * picture-message packer fills bytes 112-175 and 176-239). The same
+ * interleaving the MPEG-2 layer uses, twelve words later in the slot.
+ */
+static void histb_vdec_mpeg4_pack_qmatrix(u32 *w, const u8 *intra,
+					  const u8 *nonintra)
+{
+	unsigned int c, r, i;
+
+	for (i = 0; i < 16; i++) {
+		w[28 + i] = 0;
+		w[44 + i] = 0;
+	}
+
+	for (c = 0; c < 8; c++) {
+		for (r = 0; r < 4; r++) {
+			w[28 + 2 * c] |= (u32)intra[2 * r * 8 + c] << (8 * r);
+			w[29 + 2 * c] |= (u32)intra[(2 * r + 1) * 8 + c] << (8 * r);
+			w[44 + 2 * c] |= (u32)nonintra[2 * r * 8 + c] << (8 * r);
+			w[45 + 2 * c] |= (u32)nonintra[(2 * r + 1) * 8 + c] << (8 * r);
+		}
+	}
+}
+
+static void *histb_vdec_mpeg4_slc_slot(const struct histb_vdec_msgpool *p,
+				       unsigned int i)
+{
+	return p->va + p->slice_off + i * HISTB_MPEG4_SLC_BYTES;
+}
+
+static dma_addr_t
+histb_vdec_mpeg4_slc_slot_dma(const struct histb_vdec_msgpool *p,
+			      unsigned int i)
+{
+	return p->dma + p->slice_off + i * HISTB_MPEG4_SLC_BYTES;
+}
+
+/*
+ * Write one slice descriptor. The segment is measured from the programmed
+ * stream base: D1 carries the 16-byte granule holding the first data bit and
+ * D0's bit offset counts the bits inside that granule - the vendor firmware's
+ * MPEG-4 slice packer forms it as the bit offset inside the packet plus the low
+ * nibble of the byte address times eight - the same arithmetic the MPEG-2 layer
+ * uses. The descriptor starts at the first bit of the macroblock layer, after
+ * the slice header, because the engine reads macroblock data and nothing else.
+ *
+ * The length runs to the end of the submitted span, as the vendor firmware's
+ * remaining-bits count does: the engine stops a slice at its own end
+ * macroblock, so a window that also covers later slices costs nothing and it is
+ * what lets a picture with a missing tail still terminate. MPEG-4 slice data
+ * carries no stop bit (as in MPEG-2), so nothing is trimmed off the end here.
+ */
+static void histb_vdec_mpeg4_pack_slice(u32 *w, unsigned int end_bit,
+					const struct histb_vdec_mpeg4_slice *sl,
+					const struct histb_vdec_mpeg4_pic *pic,
+				       unsigned int start_mbn,
+				       unsigned int end_mbn,
+				       dma_addr_t next_dma)
+{
+	w[0] = FIELD_PREP(GENMASK(23, 0), end_bit - sl->data_bit) |
+	       FIELD_PREP(GENMASK(30, 24), sl->data_bit & 127U);
+	w[1] = FIELD_PREP(GENMASK(23, 0), (sl->data_bit / 8) & ~15U);
+	w[2] = 0;
+	w[3] = 0;
+	w[4] = FIELD_PREP(GENMASK(4, 0), sl->quant) |
+	       FIELD_PREP(GENMASK(6, 5), sl->coding_type) |
+	       FIELD_PREP(GENMASK(9, 7), sl->intra_dc_vlc_thr) |
+	       FIELD_PREP(GENMASK(12, 10), pic->fcode_fwd) |
+	       FIELD_PREP(GENMASK(15, 13), pic->fcode_bwd);
+	w[5] = FIELD_PREP(GENMASK(19, 0), start_mbn);
+	w[6] = FIELD_PREP(GENMASK(19, 0), end_mbn);
+	w[7] = next_dma & ~15U;
+}
+
+/* ---------------------------------------------------- picture parameters */
+
+/*
+ * The H.263 GOB grid: the vendor's syntax layer takes macroblocks-per-GOB and
+ * GOB count from the picture header's source_format through a table with one
+ * GOB per macroblock row up to CIF and two rows per GOB at 4CIF. That is the
+ * same split as the height rule its software decoder applies (one row up to 400
+ * lines, two up to 800, four above), so the rule is used here - it also covers
+ * 16CIF, which the vendor table has no entry for.
+ */
+static void histb_vdec_mpeg4_grid(struct histb_vdec_mpeg4_pic *pic)
+{
+	unsigned int rows;
+
+	pic->mb_width = DIV_ROUND_UP(pic->width, 16);
+	pic->mb_height = DIV_ROUND_UP(pic->height, 16);
+	pic->mb_total = pic->mb_width * pic->mb_height;
+	/* Width of a video packet's macroblock number: the bits of (total - 1),
+	 * not of the total. ffmpeg's packet writer counts that way, and so does
+	 * the vendor firmware's MPEG-4 parser over its own macroblock width and
+	 * height.
+	 */
+	pic->mb_bits = ilog2(pic->mb_total - 1) + 1;
+	/* Picture message D2 bits [25:22] carries the bit length of the
+	 * macroblock *total* (the vendor firmware's MPEG-4 message packer
+	 * shifts the macroblock width times the height right until it is zero
+	 * and counts the steps), which is one wider than the field above
+	 * whenever the total is a power of two. Both are kept because each has
+	 * its own provenance: the parse width is what the encoder wrote
+	 * (tiny.raw, a 4x4 grid, only decodes its packet headers at 4 bits),
+	 * the message value is what the vendor programmed.
+	 */
+	pic->msg_mb_bits = ilog2(pic->mb_total) + 1;
+
+	if (!pic->short_header)
+		return;
+
+	rows = pic->height <= 400 ? 1 : (pic->height <= 800 ? 2 : 4);
+	pic->mb_per_gob = rows * pic->mb_width;
+	pic->num_gobs = DIV_ROUND_UP(pic->mb_height, rows);
+}
+
+/*
+ * A client that cuts access units at the VOP start codes hands the bytes that
+ * open the *next* configuration - VOS, visual object, VOL, GOP - to this
+ * picture's buffer, so a resolution change arrives here instead of with the
+ * picture it configures. Walk what is left after this picture's data: cache
+ * every VOL that is found (that is what puts the new grid in front of the next
+ * picture) and end this picture's stream window at the first code, because from
+ * there the buffer is not macroblock layer.
+ *
+ * A byte-aligned 00 00 01 cannot appear in the macroblock layer: it is a run of
+ * 23 zero bits, which the macroblock escape exists to break, and a video packet
+ * header is a shorter zero run (16 to 21 bits) closed by a '1', so its third
+ * byte is 0x80 or more and never 0x01. The first code after the picture's data
+ * is therefore its end, in sliced streams as well as in ones with the resync
+ * marker disabled. Over the corpus this fires on 292 of 10616 pictures and
+ * every one of them opens with VOS 0x000001B0 - Lavc and Xvid both re-issue the
+ * sequence header before a GOP - and no VOL there failed to parse. The board
+ * consequence of not doing this is a whole-frame error (168k bytes, max 246) on
+ * every picture after a mid-stream VOL.
+ */
+static void histb_vdec_mpeg4_tail_config(struct histb_vdec_mpeg4_vol *vol,
+					 const struct histb_vdec_mpeg4_pic *pic,
+					 const u8 *buf, unsigned int size,
+					 unsigned int data_bit,
+					 unsigned int *au_end_bit)
+{
+	unsigned int pos = data_bit / 8, code, end = size;
+	int ret;
+
+	if (pic->short_header)
+		return;
+
+	while (!histb_vdec_mpeg4_find_code(buf, size, pos, &pos, &code)) {
+		if (pos < end)
+			end = pos;
+		pos += 4;
+		if (code == HISTB_MP4_CODE_VOP)
+			break;
+		if (code < HISTB_MP4_CODE_VOL_FIRST ||
+		    code > HISTB_MP4_CODE_VOL_LAST)
+			continue;
+		ret = histb_vdec_mpeg4_vol(vol, buf, size, pos - 4);
+		if (ret) {
+			vol->config_pending = true;
+			break;
+		}
+		vol->config_pending = false;
+	}
+
+	*au_end_bit = end * 8;
+}
+
+/*
+ * Find the header structure of this buffer: an MPEG-4 VOL when one is present
+ * (it updates the cached sequence parameters), then the VOP or H.263 picture
+ * header. The start codes that carry nothing the descriptors need (VOS, GOP,
+ * USER_DATA) are stepped over.
+ */
+static int histb_vdec_mpeg4_pic_start(struct histb_vdec_mpeg4_vol *vol,
+				      u32 fourcc, const u8 *buf,
+				      unsigned int size,
+				      struct histb_vdec_mpeg4_pic *pic,
+				      unsigned int *data_bit,
+				      unsigned int *au_end_bit)
+{
+	unsigned int pos, code;
+	int ret;
+
+	*au_end_bit = size * 8;
+
+	if (fourcc == V4L2_PIX_FMT_H263)
+		return histb_vdec_h263_pic(pic, buf, size, data_bit);
+
+	if (fourcc != V4L2_PIX_FMT_MPEG4)
+		/*
+		 * Only the two fourccs this codec's ops are registered for
+		 * reach .run() (V4L2_PIX_FMT_MPEG4 and V4L2_PIX_FMT_H263, both
+		 * bound to histb_vdec_mpeg4_ops), and the VOL/VOP walk below is
+		 * MPEG-4 syntax: any other format arriving here would be parsed
+		 * as something it is not, so the job is refused rather than
+		 * walked.
+		 */
+		return -EINVAL;
+
+	for (pos = 0; pos + 4 <= size;) {
+		ret = histb_vdec_mpeg4_find_code(buf, size, pos, &pos, &code);
+		if (ret)
+			return ret;
+
+		switch (code) {
+		case HISTB_MP4_CODE_VOL_FIRST ... HISTB_MP4_CODE_VOL_LAST:
+			ret = histb_vdec_mpeg4_vol(vol, buf, size, pos);
+			if (ret)
+				return ret;
+			vol->config_pending = false;
+			pos += 4;
+			break;
+		case HISTB_MP4_CODE_VOP:
+			/* A VOL is required: the raw fourcc gives no other way
+			 * to learn the grid, the quarter-pel flag, the packet
+			 * mode and the quantiser tables the picture message
+			 * carries. An unread configuration boundary makes every
+			 * later grid a guess, so those pictures are refused
+			 * too.
+			 */
+			if (!vol->parsed || vol->config_pending)
+				return -EINVAL;
+			ret = histb_vdec_mpeg4_vop(vol, buf, size, pos, pic,
+						   data_bit);
+			if (ret)
+				return ret;
+			histb_vdec_mpeg4_tail_config(vol, pic, buf, size,
+						     *data_bit, au_end_bit);
+			return 0;
+		default:
+			/* VOS, visual object, video object, GOP, user data and
+			 * every other code carry nothing the descriptors need;
+			 * step over them. The vendor's loop does the same (its
+			 * VOS branch only warns about profile/level).
+			 */
+			pos += 4;
+			break;
+		}
+	}
+
+	/*
+	 * The scan stepped over every start code in the buffer and never met a
+	 * VOL followed by a VOP, so this submission carries no picture: a
+	 * buffer of sequence-level syntax only (VOS, VO, GOP, user data), or
+	 * one whose VOP lies beyond the bytes the client handed over. There is
+	 * nothing to program - the picture message takes its grid, quantiser
+	 * tables and packet geometry from the cached VOL and its timing, type
+	 * and quantiser from the VOP - and inventing a window over the rest of
+	 * the buffer would have the engine read sequence headers as macroblock
+	 * layer. A client that splits access units at the VOP codes (the shape
+	 * this driver is written for, see histb_vdec_mpeg4_tail_config()) never
+	 * reaches this.
+	 */
+	return -EINVAL;
+}
+
+/* ----------------------------------------------- per-context frame state */
+
+static void histb_vdec_mpeg4_pmv_free(struct histb_vdec_dev *dev,
+				      struct histb_vdec_mpeg4_ctx *m4)
+{
+	unsigned int i;
+
+	for (i = 0; i < HISTB_VDEC_MAX_PMV_SLOTS; i++) {
+		if (!m4->pmv_va[i])
+			continue;
+		dma_free_wc(dev->memdev, m4->pmv_slot_size, m4->pmv_va[i],
+			    m4->pmv_dma[i]);
+		m4->pmv_va[i] = NULL;
+	}
+	m4->pmv_slot_size = 0;
+}
+
+static int histb_vdec_mpeg4_pmv_grow(struct histb_vdec_ctx *ctx,
+				     unsigned int mb_total)
+{
+	struct histb_vdec_dev *dev = video_get_drvdata(ctx->fh.vdev);
+	struct histb_vdec_mpeg4_ctx *m4 = ctx->priv;
+	unsigned int slot = ALIGN(mb_total * HISTB_MPEG4_PMV_BYTES_PER_MB,
+				  128);
+	unsigned int i;
+
+	if (m4->pmv_slot_size >= slot)
+		return 0;
+
+	histb_vdec_mpeg4_pmv_free(dev, m4);
+
+	for (i = 0; i < HISTB_VDEC_MAX_PMV_SLOTS; i++) {
+		m4->pmv_va[i] = dma_alloc_wc(dev->memdev, slot,
+					     &m4->pmv_dma[i], GFP_KERNEL);
+		if (!m4->pmv_va[i])
+			break;
+	}
+	if (i < HISTB_VDEC_MAX_PMV_SLOTS) {
+		histb_vdec_mpeg4_pmv_free(dev, m4);
+		return -ENOMEM;
+	}
+	m4->pmv_slot_size = slot;
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+
+	return 0;
+}
+
+/* Slot id (+1, so a zeroed pmv_map[] reads as "unallocated") of one capture
+ * buffer index, mirroring the H.264 allocator.
+ */
+static unsigned int histb_vdec_mpeg4_pmv_alloc(struct histb_vdec_ctx *ctx,
+					       unsigned int index)
+{
+	u8 id = ctx->pmv_map[index];
+
+	if (!id) {
+		id = ctx->pmv_next++ % HISTB_VDEC_MAX_PMV_SLOTS + 1;
+		ctx->pmv_map[index] = id;
+	}
+
+	return id;
+}
+
+/*
+ * Address and motion-vector slot of one recorded anchor picture. The capture
+ * buffer is found again by the timestamp its job carried, the reference
+ * mechanism the MPEG-2 and H.264 layers use; a timestamp that no longer maps to
+ * a queued buffer makes the picture fall back to its own frame.
+ */
+static dma_addr_t histb_vdec_mpeg4_ref_addr(struct histb_vdec_ctx *ctx,
+					    const struct histb_vdec_mpeg4_ref *ref,
+					    dma_addr_t cur, dma_addr_t cur_pmv,
+					    dma_addr_t *pmv)
+{
+	struct histb_vdec_mpeg4_ctx *m4 = ctx->priv;
+	struct vb2_buffer *vb;
+
+	*pmv = cur_pmv;
+	if (!ref->valid || ref->pmv_slot > HISTB_VDEC_MAX_PMV_SLOTS)
+		return cur;
+
+	vb = vb2_find_buffer(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx),
+			     ref->timestamp);
+	if (!vb)
+		return cur;
+
+	*pmv = m4->pmv_dma[ref->pmv_slot - 1];
+
+	return histb_vdec_frame_dma(ctx, vb) ?: cur;
+}
+
+/* ------------------------------------------------------------------ run */
+
+static int histb_vdec_mpeg4_run(struct histb_vdec_ctx *ctx,
+				struct vb2_v4l2_buffer *src,
+				struct vb2_v4l2_buffer *dst)
+{
+	struct histb_vdec_dev *dev = video_get_drvdata(ctx->fh.vdev);
+	struct histb_vdec_msgpool *pool = &dev->pool;
+	struct histb_vdec_mpeg4_ctx *m4 = ctx->priv;
+	struct histb_vdec_mpeg4_pic pic = {};
+	struct histb_vdec_mpeg4_slice *sls;
+	unsigned int cap_w, cap_h, bytesused, data_bit = 0, au_end_bit = 0;
+	unsigned int lines, tile_stride, end_bit, n_sl, i, cur_slot, next;
+	void *slot;
+	dma_addr_t src_addr, dst_addr, stream_base;
+	dma_addr_t fwd, bwd, fwd_pmv, bwd_pmv, cur_pmv;
+	dma_addr_t scratch_pmv, scratch_sed, scratch_itrans;
+	u32 *w = histb_vdec_pic_slot(pool);
+	u32 val, trb = 0, trd = 0;
+	int ret;
+
+	ret = histb_vdec_cap_dims(ctx, &cap_w, &cap_h);
+	if (ret)
+		return ret;
+
+	bytesused = vb2_get_plane_payload(&src->vb2_buf, 0);
+	/*
+	 * Empty and runt OUTPUT submissions are refused here, before the header
+	 * scan. The floor is not a syntax number and no measurement pins it:
+	 * the header alone is far shorter than 32 bytes - the Annex-E pictures
+	 * that decoded byte-exactly on this engine start their macroblock layer
+	 * at bit 50 of the picture header, under 7 bytes with their start code,
+	 * and an MPEG-4 VOP header is of the same order - so a buffer this
+	 * short holds no header at all, and anything longer is answered by the
+	 * span checks the parsers carry themselves rather than by this
+	 * constant.
+	 */
+	if (bytesused < 32)
+		return -EINVAL;
+
+	{
+		const u8 *buf = histb_vdec_src_va(&src->vb2_buf);
+
+		/*
+		 * These fourccs carry no stateless control set, so every number
+		 * the picture message needs - the grid, the quantiser tables,
+		 * the packet geometry, the slice windows - comes out of the
+		 * submitted bytes, and reading them needs a kernel address. The
+		 * OUTPUT queue deliberately keeps one (histb_vdec_queue_init()
+		 * in histb_vdec_drv.c declines DMA_ATTR_NO_KERNEL_MAPPING for
+		 * exactly this parse), so this arm answers a missing mapping,
+		 * not a stream shape: with no bytes there is no header to read
+		 * and no descriptor to write, and the alternative would be
+		 * programming the engine with whatever the previous picture
+		 * left in the pool. A client that cannot map its OUTPUT plane
+		 * would need the parsed syntax to arrive through a control,
+		 * which is the interface these two codecs do not have yet.
+		 */
+		if (!buf) {
+			dev_warn_once(dev->dev,
+				      "OUTPUT queue has no kernel mapping, cannot parse headers\n");
+			return -EINVAL;
+		}
+
+		/* H.263 takes its size from the picture header's source_format
+		 * and MPEG-4 from the VOL; either way the coded size has to fit
+		 * the capture buffer the client negotiated, checked below.
+		 */
+		ret = histb_vdec_mpeg4_pic_start(&m4->vol, ctx->desc->fourcc,
+						 buf, bytesused, &pic, &data_bit,
+						 &au_end_bit);
+		if (ret)
+			return ret;
+	}
+
+	histb_vdec_mpeg4_grid(&pic);
+
+	/*
+	 * A picture of one macroblock column is refused for the reason measured
+	 * on the H.264 path: the engine reports an error on such a submission,
+	 * and declaring a wider grid does not fix the delivery.
+	 */
+	if (pic.mb_width < 2 || pic.mb_bits > 20 ||
+	    pic.width > cap_w || pic.height > cap_h)
+		return -EINVAL;
+
+	/*
+	 * The group grid has to fit the fields picture message D2 states it in:
+	 * seven bits for the macroblocks per group and five for the group count
+	 * (the field masks of the vendor firmware's MPEG-4 picture message), so
+	 * a 16CIF picture, whose group is 4 x 88 = 352 macroblocks wide, has no
+	 * representable description and is refused rather than truncated.
+	 */
+	if (pic.short_header && (pic.mb_per_gob > 127 || pic.num_gobs > 32))
+		return -EINVAL;
+
+	/*
+	 * Inter pictures on grids below the smallest one measured reliable are
+	 * refused (176x144 = 99 macroblocks). The reason is a delivery defect
+	 * in the engine's inter path at these sizes: eight streams (16, 49, 64,
+	 * 65, 66, 70, 72 and 80 macroblocks) showed 146..240-count errors from
+	 * their second picture on, while every stream of 99 macroblocks or more
+	 * matched the reference within the rounding family across two
+	 * independent sweeps. The trigger could not be characterised: the same
+	 * stream with the same predecessor gave 229, 1 and 1 in three
+	 * consecutive runs of one boot, and buffer addresses, RAM pressure and
+	 * a long mixed-resolution history were each measured not to move it, so
+	 * no narrower condition can be written. Intra pictures of the same
+	 * grids are not affected and stay accepted, and the H.263 short-header
+	 * path is not gated because its small-grid inter pictures were measured
+	 * clean.
+	 */
+	if (!pic.short_header && pic.coding_type != HISTB_MPEG4_I_VOP &&
+	    pic.mb_total < 99)
+		return -EINVAL;
+
+	src_addr = histb_vdec_src_dma(&src->vb2_buf);
+	dst_addr = histb_vdec_frame_dma(ctx, &dst->vb2_buf);
+	if (!dst_addr)
+		return -ENOMEM;
+	stream_base = src_addr & ~255U;
+	/* The stream base is the minimum of the 16-byte-aligned slice window
+	 * addresses (the vendor firmware's MPEG-4 register setup takes it that
+	 * way); every window lies in this buffer and vb2 dma-contig addresses
+	 * are page aligned, so it is the buffer start - and the descriptor
+	 * offsets are relative to it.
+	 *
+	 * That identity is what the gate below guards, not a stream shape: the
+	 * descriptors count their granule from byte 0 of this buffer
+	 * (histb_vdec_mpeg4_pack_slice() writes (data_bit / 8) & ~15), while
+	 * VDM_STREAM_BASE is programmed with the address rounded down to 256
+	 * bytes. If the two ever differ, every window the engine reads lands
+	 * (src_addr & 255) bytes early - the head of the slice data is missed
+	 * and bytes belonging to whatever precedes this buffer are walked
+	 * instead. Page-aligned dma-contig addresses make that unreachable with
+	 * today's allocator, which is why no measurement is attached to it; it
+	 * would become reachable through a different mem_ops or an
+	 * exporter-provided plane, and refusing the job is the only answer that
+	 * keeps the engine out of memory this job does not own.
+	 */
+	if (stream_base != src_addr)
+		return -EINVAL;
+
+	ret = histb_vdec_mpeg4_pmv_grow(ctx, pic.mb_total);
+	if (ret)
+		return ret;
+
+	sls = kvmalloc_array(HISTB_MPEG4_MAX_SLICES, sizeof(*sls), GFP_KERNEL);
+	if (!sls)
+		return -ENOMEM;
+
+	{
+		const u8 *buf = histb_vdec_src_va(&src->vb2_buf);
+
+		ret = histb_vdec_mpeg4_slice_headers(buf, bytesused, &pic,
+						     data_bit, sls,
+						     HISTB_MPEG4_MAX_SLICES);
+		if (ret < 0)
+			goto out;
+		n_sl = ret;
+		/* The end of this picture's stream window: the buffer payload,
+		 * or the first start code after its data when the client left
+		 * the next configuration in here with it.
+		 */
+		end_bit = au_end_bit;
+
+		if (pic.short_header) {
+			/* A short-header picture takes its quantiser and its
+			 * type from the first group header, which is the only
+			 * place that syntax carries them; it has no fcode and
+			 * no MPEG-4 packet geometry.
+			 */
+			pic.quant = sls[0].quant;
+			pic.coding_type = sls[0].coding_type;
+			pic.fcode_fwd = 0;
+			pic.fcode_bwd = 0;
+		}
+
+		if (n_sl + 1 >= HISTB_VDEC_MAX_SLICE_SLOTS) {
+			ret = -EINVAL;
+			goto out;
+		}
+
+		for (i = 0; i < n_sl; i++) {
+			unsigned int end_mbn = i + 1 < n_sl ?
+				sls[i + 1].start_mbn - 1 : pic.mb_total - 1;
+
+			if (sls[i].start_mbn > end_mbn ||
+			    end_mbn >= pic.mb_total) {
+				ret = -EINVAL;
+				goto out;
+			}
+			slot = histb_vdec_mpeg4_slc_slot(pool, i);
+			next = i + 1 < n_sl ?
+				histb_vdec_mpeg4_slc_slot_dma(pool, i + 1) : 0;
+			histb_vdec_mpeg4_pack_slice(slot, end_bit, &sls[i],
+						    &pic, sls[i].start_mbn,
+						    end_mbn, next);
+		}
+		/* The chain ends on a null pointer, and the slot after the last
+		 * descriptor is left cleared: that is where a follower that
+		 * ignores the terminator lands.
+		 */
+		memset(histb_vdec_mpeg4_slc_slot(pool, n_sl), 0,
+		       HISTB_MPEG4_SLC_BYTES);
+	}
+
+	histb_vdec_buf_geom(ctx, &tile_stride, &lines);
+
+	cur_slot = histb_vdec_mpeg4_pmv_alloc(ctx, dst->vb2_buf.index);
+	cur_pmv = m4->pmv_dma[cur_slot - 1];
+
+	fwd = dst_addr;
+	bwd = dst_addr;
+	fwd_pmv = cur_pmv;
+	bwd_pmv = cur_pmv;
+	if (pic.coding_type == HISTB_MPEG4_P_VOP) {
+		fwd = histb_vdec_mpeg4_ref_addr(ctx, &m4->anchor[0], dst_addr,
+						cur_pmv, &fwd_pmv);
+		bwd = fwd;
+		bwd_pmv = fwd_pmv;
+	} else if (pic.coding_type == HISTB_MPEG4_B_VOP) {
+		/* Both anchors were coded before this picture: anchor[0] is the
+		 * later one, which is the backward reference, anchor[1] the
+		 * earlier one.
+		 */
+		fwd = histb_vdec_mpeg4_ref_addr(ctx, &m4->anchor[1], dst_addr,
+						cur_pmv, &fwd_pmv);
+		bwd = histb_vdec_mpeg4_ref_addr(ctx, &m4->anchor[0], dst_addr,
+						cur_pmv, &bwd_pmv);
+	}
+
+	scratch_pmv = histb_vdec_tables_dma(pool) +
+		HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_PMV_TOP);
+	scratch_sed = histb_vdec_tables_dma(pool) +
+		HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_SED_TOP);
+	scratch_itrans = histb_vdec_tables_dma(pool) +
+		HISTB_TABLE_OFF_SCRATCH(HISTB_SCRATCH_ITRANS_TOP);
+
+	/*
+	 * The B-VOP distances the picture message states in D3 come from the
+	 * vop time code: the forward distance shifted by one into bits [15:0]
+	 * and the anchor-to-anchor distance into [31:17], which is how the
+	 * vendor firmware's MPEG-4 picture-message packer forms them. The two
+	 * variables are the vendor's own accumulation - time in ticks of
+	 * vop_time_increment_resolution, pp_time the anchor-to-anchor distance
+	 * updated by every I/P, pb_time this B's distance from its forward
+	 * anchor, as its software decoder computes them. Writing zero here
+	 * leaves the engine no way to split a bidirectional motion vector in
+	 * time, which is what the board showed on B pictures (max deviation 163
+	 * against the reference, against 1 elsewhere).
+	 */
+	if (!pic.short_header) {
+		unsigned int tir = m4->vol.time_incr_res;
+		unsigned int time, pb;
+
+		if (pic.coding_type == HISTB_MPEG4_B_VOP)
+			time = (m4->last_time_base + pic.time_modulo) * tir +
+			       pic.time_increment;
+		else
+			time = (m4->time_base + pic.time_modulo) * tir +
+			       pic.time_increment;
+
+		if (pic.coding_type != HISTB_MPEG4_B_VOP) {
+			m4->last_time_base = m4->time_base;
+			m4->time_base += pic.time_modulo;
+			if (time < m4->last_non_b_time) {
+				/* the bare time_base rollover DivX/Xvid streams
+				 * produce; the vendor's software decoder
+				 * compensates it the same way under its umpeg4
+				 * work-around
+				 */
+				m4->time_base++;
+				time += tir;
+			}
+			m4->pp_time = time - m4->last_non_b_time;
+			m4->last_non_b_time = time;
+			trd = m4->pp_time;
+		} else {
+			pb = m4->pp_time - (m4->last_non_b_time - time);
+			/*
+			 * The picture must sit strictly between its two
+			 * anchors: 0 < pb_time < pp_time, which is what the
+			 * three tests here say. These two numbers are operands,
+			 * not labels - D3 is the only place the engine learns
+			 * the temporal split of a bidirectional vector, and the
+			 * vendor's own path treats a zero pp_time as a division
+			 * it must not attempt, while its header walk skips the
+			 * picture outright for these same three predicates and
+			 * reports the time code as out of order. A pair outside
+			 * that range cannot be stated in the message either:
+			 * both fields are unsigned and pb_time is the one the
+			 * backward distance is derived from, so writing it
+			 * would leave the engine interpolating between two
+			 * anchors it cannot order. Only this B picture is
+			 * dropped, the accumulation above stays as it is, and
+			 * the vendor drops the same frame for the same reason.
+			 * Accepting it would need the distances from somewhere
+			 * other than the vop time code, which this raw-fourcc
+			 * interface has no control for.
+			 */
+			if (!m4->pp_time || m4->pp_time <= pb ||
+			    m4->pp_time <= m4->pp_time - pb) {
+				/* the vendor drops this frame */
+				ret = -EINVAL;
+				goto out;
+			}
+			trb = pb;
+			trd = m4->pp_time;
+		}
+	}
+
+	memset(w, 0, HISTB_VDEC_SLOT_BYTES);
+	w[3] = ((trb << 1) & GENMASK(14, 0)) | FIELD_PREP(GENMASK(31, 17), trd);
+
+	if (pic.short_header) {
+		/* D0 selects the H.263 slice syntax. D1 carries the GOB grid
+		 * the engine needs to turn a GOB number into a macroblock
+		 * range, D2 the picture type and the slice number width.
+		 */
+		w[0] = HISTB_MPEG4_D0_H263_SHORT;
+		w[1] = FIELD_PREP(GENMASK(4, 0), pic.num_gobs - 1) |
+		       FIELD_PREP(GENMASK(11, 5), pic.mb_per_gob) |
+		       FIELD_PREP(GENMASK(30, 26), pic.quant);
+		w[2] = FIELD_PREP(GENMASK(6, 5), pic.coding_type) |
+		       FIELD_PREP(GENMASK(25, 22), pic.msg_mb_bits);
+	} else {
+		w[1] = FIELD_PREP(GENMASK(30, 26), pic.quant) |
+		       FIELD_PREP(BIT(31), pic.quant_type);
+		/*
+		 * The rounding bit is forced to 0 for B-VOPs, which is what the
+		 * vendor firmware's MPEG-4 picture-message packer does for
+		 * picture type 2.
+		 */
+		val = FIELD_PREP(GENMASK(6, 5), pic.coding_type) |
+		      FIELD_PREP(GENMASK(10, 8), pic.intra_dc_vlc_thr) |
+		      FIELD_PREP(GENMASK(13, 11), pic.fcode_fwd) |
+		      FIELD_PREP(GENMASK(16, 14), pic.fcode_bwd) |
+		      FIELD_PREP(GENMASK(21, 17), pic.time_incr_bits) |
+		      FIELD_PREP(GENMASK(25, 22), pic.msg_mb_bits);
+		if (pic.coding_type != HISTB_MPEG4_B_VOP && pic.rounding)
+			val |= BIT(3);
+		if (pic.quarter_sample)
+			val |= BIT(4);
+		if (pic.resync_marker_disable)
+			val |= BIT(7);
+		/* sprite_enable (bits 27:26), sprite_warping_accuracy (29:28)
+		 * and sprite_warping_points (31:30) stay 0: those pictures are
+		 * refused.
+		 */
+		w[2] = val;
+		/*
+		 * D3 carries the B-VOP time increments (trb, trd), which come
+		 * from sequence-level timing state the raw-fourcc interface has
+		 * no field for, so they stay 0.
+		 */
+	}
+
+	w[4] = FIELD_PREP(GENMASK(15, 0), pic.mb_width - 1) |
+	       FIELD_PREP(GENMASK(31, 16), pic.mb_height - 1);
+	w[5] = FIELD_PREP(GENMASK(15, 0), pic.width) |
+	       FIELD_PREP(GENMASK(31, 16), pic.height);
+	/* D6/D7 carry a one-point warp offset for sprite pictures (refused),
+	 * D8-D11 the picture-level stream segments, which this protocol leaves
+	 * to the slice descriptors, and D19 the encoder-compatibility flags the
+	 * vendor fills from DivX/Xvid build numbers found in USER_DATA -
+	 * nothing here emulates an encoder bug. All stay 0.
+	 */
+	w[12] = dst_addr & ~15U;		/* display frame */
+	w[13] = fwd & ~15U;
+	w[14] = bwd & ~15U;
+	w[15] = cur_pmv & ~15U;
+	w[16] = bwd_pmv & ~15U;
+	w[17] = scratch_itrans & ~15U;
+	w[18] = scratch_pmv & ~15U;
+	/* The matrices go in D28-D59 only when the VOL uses MPEG-2 style
+	 * quantisation (the vendor's load gate); they are written either way,
+	 * CFG0's LD_QMATRIX being set on every picture, because the engine
+	 * ignores them for the linear quantiser.
+	 */
+	histb_vdec_mpeg4_pack_qmatrix(w, m4->vol.intra_matrix,
+				      m4->vol.inter_matrix);
+	w[60] = scratch_sed & ~15U;
+	w[63] = histb_vdec_mpeg4_slc_slot_dma(pool, 0) & ~15U;
+
+	/* Register set. CFG0 reproduces the vendor firmware's MPEG-4 register
+	 * setup bit for bit: the macroblock count with LD_QMATRIX, VOP-type
+	 * detect and marker detect. CFG1 does not: the value the firmware
+	 * writes there is the band pitch shifted right by six into the stride
+	 * field, plus VID_STD 2, DBLK_1D_EN, FST_SLC_GRP, MV_OUT_EN, a maximum
+	 * slice group number of 1 and a compress flag taken from its decode
+	 * parameters. Those extras belong to the vendor's macroblock
+	 * information export: MV_OUT_EN is paired with VDM_DNR_MBINFO_STADDR,
+	 * which the firmware fills from the macroblock-information buffer it
+	 * allocated in its global hardware memory pool and which this driver
+	 * never writes because no such buffer is registered here. Keeping the
+	 * bit clear is therefore the arm that cannot write to an address the
+	 * driver does not own. The compress flag is the vendor's
+	 * compressed-frame output switch, outside the stateless uAPI. The slice
+	 * walk is bounded by the descriptor chain and the capacity gate above,
+	 * not by the maximum slice group number, so the 3 written here and the
+	 * vendor's 1 cannot be told apart by any stream.
+	 */
+	vdm_write(dev, VDM_CFG0,
+		  FIELD_PREP(VDM_CFG0_MBAMT, pic.mb_total - 1) |
+		  VDM_CFG0_MARKER_DETECT | VDM_CFG0_VOPTYPE_DETECT |
+		  VDM_CFG0_LD_QMATRIX);
+	/*
+	 * The vendor firmware feeds this field and VDM_YSTRIDE_1D from one and
+	 * the same parameter (the band pitch shifted right by six into
+	 * CFG1[13:4], the band pitch itself into the stride register), so the
+	 * band pitch goes in both. The H.264 and MPEG-2 paths write the line
+	 * stride here and deliver byte-exact pictures, and an on-board arm that
+	 * cleared DDR_STRIDE moved nothing, so the field is inert either way;
+	 * this file keeps vendor parity.
+	 */
+	vdm_write(dev, VDM_CFG1,
+		  FIELD_PREP(VDM_CFG1_VID_STD, HISTB_MPEG4_CFG1_VIDSTD) |
+		  FIELD_PREP(VDM_CFG1_DDR_STRIDE,
+			     histb_vdec_band_bytes(tile_stride) >> 6) |
+		  FIELD_PREP(VDM_CFG1_MAX_SLCGRP_NUM, 3) |
+		  VDM_CFG1_DBLK_1D_EN);
+	vdm_write(dev, VDM_AVM_ADDR, pool->dma & ~15U);
+	vdm_write(dev, VDM_VAM_ADDR, histb_vdec_up_msgs_dma(pool) & ~15U);
+	vdm_write(dev, VDM_STREAM_BASE, stream_base);
+	vdm_write(dev, VDM_YSTADDR_1D, dst_addr & ~15U);
+	vdm_write(dev, VDM_YSTRIDE_1D, histb_vdec_band_bytes(tile_stride));
+	vdm_write(dev, VDM_UVOFFSET_1D,
+		  histb_vdec_luma_bytes(tile_stride, lines) +
+		  histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_HEAD_INF_OFFSET, histb_vdec_head_inf_bytes(lines));
+	vdm_write(dev, VDM_FF_APT_EN, 0);
+
+	for (i = 1; i <= 7; i++)
+		vdm_write(dev, VDM_TO(i), VDM_TIMEOUT_MOD);
+	vdm_write(dev, VDM_INT_STATE, 0xffffffff);
+	vdm_write(dev, VDM_INT_MASK, 0xfffffffe);
+
+	/* The vendor firmware's MPEG-4 register setup also drives bit16 of the
+	 * SCD global register: set for a picture of at most 120 macroblock
+	 * columns, clear above it.
+	 */
+	val = readl(dev->scd + SCD_EMAR_ID);
+	if (pic.mb_width <= 120)
+		val |= BIT(16);
+	else
+		val &= ~BIT(16);
+	writel(val, dev->scd + SCD_EMAR_ID);
+
+	/* An anchor picture enters the history; B-VOPs are never referenced. */
+	if (pic.coding_type != HISTB_MPEG4_B_VOP) {
+		m4->anchor[1] = m4->anchor[0];
+		m4->anchor[0] = (struct histb_vdec_mpeg4_ref){
+			src->vb2_buf.timestamp, cur_slot, true,
+		};
+	}
+
+	ret = 0;
+
+out:
+	kvfree(sls);
+	if (ret)
+		return ret;
+
+	histb_vdec_hw_kick(dev, ctx->desc->vidstd);
+
+	return 0;
+}
+
+/* --------------------------------------------------------------- wiring */
+
+static int histb_vdec_mpeg4_start(struct histb_vdec_ctx *ctx)
+{
+	struct histb_vdec_mpeg4_ctx *m4;
+
+	m4 = kzalloc_obj(*m4);
+	if (!m4)
+		return -ENOMEM;
+
+	memcpy(m4->vol.intra_matrix, histb_mp4_intra_matrix, 64);
+	memcpy(m4->vol.inter_matrix, histb_mp4_inter_matrix, 64);
+	ctx->priv = m4;
+
+	return 0;
+}
+
+static void histb_vdec_mpeg4_stop(struct histb_vdec_ctx *ctx)
+{
+	struct histb_vdec_dev *dev = video_get_drvdata(ctx->fh.vdev);
+	struct histb_vdec_mpeg4_ctx *m4 = ctx->priv;
+
+	if (!m4)
+		return;
+
+	histb_vdec_mpeg4_pmv_free(dev, m4);
+	kfree(m4);
+	ctx->priv = NULL;
+
+	memset(ctx->pmv_map, 0, sizeof(ctx->pmv_map));
+	ctx->pmv_next = 0;
+}
+
+static const struct histb_vdec_codec_ops histb_vdec_mpeg4_ops = {
+	.start = histb_vdec_mpeg4_start,
+	.stop = histb_vdec_mpeg4_stop,
+	.run = histb_vdec_mpeg4_run,
+};
+
+const histb_vdec_fmt_desc histb_vdec_mpeg4_fmt = {
+	.fourcc = V4L2_PIX_FMT_MPEG4,
+	.stride = histb_vdec_tile_stride,
+	.grid_align = 16,
+	.num_ctrls = 0,
+	.ctrls = NULL,
+	.ops = &histb_vdec_mpeg4_ops,
+	.vidstd = HISTB_VIDSTD_MPEG4,
+};
+
+/* H.263 short-header pictures go through the same MPEG-4 engine, with the
+ * picture message word D0 and the slice syntax switched over.
+ */
+const histb_vdec_fmt_desc histb_vdec_h263_fmt = {
+	.fourcc = V4L2_PIX_FMT_H263,
+	.stride = histb_vdec_tile_stride,
+	.grid_align = 16,
+	.num_ctrls = 0,
+	.ctrls = NULL,
+	.ops = &histb_vdec_mpeg4_ops,
+	.vidstd = HISTB_VIDSTD_MPEG4,
+};
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_regs.h b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_regs.h
new file mode 100644
index 000000000000..96165ae29274
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_regs.h
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Register definitions for the HiSilicon VDH v2 video decoder: the
+ * Hi3716CV200 (HiVDHV200R004) and Hi3798MV100 (HiVDHV300R001) parts, whose
+ * register files the vendor headers hold identical for every offset this
+ * driver names. Derived from the vendor firmware's register description
+ * headers and cross-checked against the firmware's own assembly and the
+ * hardware.
+ */
+#ifndef HISTB_VDEC_REGS_H
+#define HISTB_VDEC_REGS_H
+
+#include <linux/bits.h>
+
+/*
+ * VDM register window, 4 KiB plus the SED block at 0xF8C30000. Offsets are
+ * register indices as used by the vendor firmware. The syntax-error statistics
+ * at 0x1000 belong to the same hardware block (the firmware reads them as its
+ * syntax-error record pair), so the mapping covers them while the luminance
+ * histogram past 0x8100 stays outside.
+ */
+#define VDM_START			0x000	/* doorbell: write 0, 1, 0 */
+#define VDM_REPAIR			0x004	/* RealVideo repair engine start */
+#define VDM_CFG0			0x008
+#define VDM_CFG0_MBAMT			GENMASK(19, 0)
+#define VDM_CFG0_MEM_CG			BIT(20)	/* memory clock gating */
+#define VDM_CFG0_MOD_CG			BIT(21)	/* module clock gating */
+#define VDM_CFG0_MARKER_DETECT	BIT(22)
+#define VDM_CFG0_ACLAST_DETECT	BIT(23)
+#define VDM_CFG0_COEFIDX_DETECT	BIT(24)
+#define VDM_CFG0_VOPTYPE_DETECT	BIT(25)
+#define VDM_CFG0_LD_QMATRIX		BIT(30)
+#define VDM_CFG1			0x00c
+#define VDM_CFG1_VID_STD		GENMASK(3, 0)
+#define VDM_CFG1_DDR_STRIDE		GENMASK(13, 4)	/* stride >> 6 */
+#define VDM_CFG1_FST_SLC_GRP		BIT(14)
+#define VDM_CFG1_MV_OUT_EN		BIT(15)
+#define VDM_CFG1_MAX_SLCGRP_NUM		GENMASK(27, 16)
+#define VDM_CFG1_LINE_NUM_OUT_EN	BIT(28)
+#define VDM_CFG1_DBLK_1D_EN		BIT(29)
+#define VDM_CFG1_COMPRESS_EN		BIT(30)
+#define VDM_CFG1_PPFD_EN			BIT(31)
+#define VDM_AVM_ADDR			0x010	/* downstream msg pool */
+#define VDM_VAM_ADDR			0x014	/* upstream msg pool */
+#define VDM_STREAM_BASE			0x018
+#define VDM_STATE			0x01c
+#define VDM_STATE_SLICE_NUM		GENMASK(16, 0)
+#define VDM_STATE_DEC_OVER		BIT(17)
+#define VDM_STATE_DEC_ERR		BIT(18)
+#define VDM_STATE_VERSION		GENMASK(26, 19)
+#define VDM_INT_STATE			0x020	/* write 1 to clear */
+#define VDM_INT_MASK			0x024	/* write 1 to mask */
+#define VDM_INT_DEC_OVER		BIT(0)
+#define VDM_CTRL_STATE			0x028	/* == 1 means idle */
+#define VDM_EMAR_ID			0x030
+#define VDM_RPT_CNT			0x034
+#define VDM_TO(n)			(0x038 + 4 * (n)) /* 8 module timeouts */
+
+/* The firmware programs the seven module timeout windows 0x3c..0x54 with one
+ * common value and never touches VDM_RPT_CNT / VDM_TO(0).
+ */
+#define VDM_TIMEOUT_MOD			0x00300c03
+#define VDM_TIMEOUT_HEVC			0x00300003
+
+#define VDM_PART_DEC_OVER_LEVEL		0x05c
+#define VDM_YSTADDR_1D			0x060	/* current output frame */
+#define VDM_YSTRIDE_1D			0x064
+#define VDM_UVOFFSET_1D			0x068
+#define VDM_HEAD_INF_OFFSET		0x06c
+#define VDM_PRCMEM1			0x070
+#define VDM_PRCMEM2			0x074	/* line number table */
+#define VDM_PPFD_BUF_ADDR		0x080
+#define VDM_PPFD_BUF_LEN		0x084
+#define VDM_PRC_CACHE_TYPE		0x098	/* HEVC: the vendor programs 2 there */
+#define VDM_DNR_MBINFO_STADDR		0x090
+#define VDM_REF_PIC_TYPE		0x094	/* 16 x 2-bit frame types */
+#define VDM_FF_APT_EN			0x098
+
+/* Per-picture performance counters, updated by the VDM at frame end. */
+#define VDM_DEC_CYCLE_PER_PIC		0x0b0
+#define VDM_RD_BDWIDTH_PER_PIC		0x0b4
+#define VDM_WR_BDWIDTH_PER_PIC		0x0b8
+#define VDM_RD_REQ_PER_PIC		0x0bc
+#define VDM_WR_REQ_PER_PIC		0x0c0
+#define VDM_MB0_QP_IN_CURR_PIC		0x0d0
+#define VDM_SWITCH_ROUNDING		0x0d4
+#define VDM_AXI_TEST_ST			0x0e0
+#define VDM_AXI_TEST_STA		0x0f0
+
+/*
+ * Syntax error detection status. These live past the first 4 KiB of the block
+ * and are where the vendor firmware reads its syntax-error record pair from
+ * (the non-low-delay path looks only at 0x1000 and 0x1014). The block runs to
+ * the end of the mapped window, and the firmware's low-delay path walks it as
+ * 16-byte per-slice records (status at +0, record end at +8, slice index
+ * 1..200), so the dump covers all of it.
+ */
+#define VDM_SED_STA			0x1000
+#define VDM_SED_END0			0x1014
+#define VDM_SED_LAST			0x10f0
+
+/*
+ * VDEC global registers inside the SCD block at 0xF8C3C000. The decoder
+ * data path does not use the SCD. The firmware pokes these registers
+ * around its VDM starts, and the live paths here follow it for the VDH
+ * gate on every picture (histb_vdec_hw.c) and for the MPEG-4 width bit of
+ * EMAR_ID (histb_vdec_mpeg4.c); AVS_FLAG and SELRST are not written by any
+ * live path.
+ */
+#define SCD_AVS_FLAG			0x000
+#define SCD_EMAR_ID			0x004
+/*
+ * VDH select/reset. The vendor firmware's decoder start path writes 1 here
+ * before every picture; no live path in this driver touches the offset.
+ */
+#define SCD_VDH_SELRST			0x008
+#define SCD_VDH_CK_GT			0x00c
+
+/* CRG window offsets: gate/reset/clk_sel of the VDH and its ack window. The
+ * soft-reset request is bit 5 of CRG30 and the reset acknowledge is bit 1 of
+ * CRG93, matching the CRG register descriptions the vendor firmware programs
+ * against.
+ */
+#define VDH_CRG30				0x078
+#define VDH_CRG93				0x174
+
+/* Per-protocol value written to SCD_VDH_CK_GT before each VDM start. */
+#define VDH_CK_GT_HEVC			0x0
+#define VDH_CK_GT_OTHER			0x3
+
+/*
+ * Firmware channel type codes (dispatch table); the VDM_CFG1_VID_STD register
+ * field carries its own per-protocol codes, which each codec source defines
+ * separately (they disagree for HEVC).
+ */
+enum histb_vdec_vidstd {
+	HISTB_VIDSTD_H264	= 0,
+	HISTB_VIDSTD_VC1	= 1,
+	HISTB_VIDSTD_MPEG4	= 2,
+	HISTB_VIDSTD_MPEG2	= 3,
+	HISTB_VIDSTD_H263	= 4,
+	HISTB_VIDSTD_DIVX3	= 5,
+	HISTB_VIDSTD_AVS	= 6,
+	HISTB_VIDSTD_JPEG	= 7,
+	HISTB_VIDSTD_REAL8	= 8,
+	HISTB_VIDSTD_REAL9	= 9,
+	HISTB_VIDSTD_VP6F	= 10,
+	HISTB_VIDSTD_VP6	= 11,
+	HISTB_VIDSTD_VP6A	= 12,
+	HISTB_VIDSTD_HEVC	= 17,
+};
+
+#endif /* HISTB_VDEC_REGS_H */
diff --git a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_tables_h264.h b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_tables_h264.h
