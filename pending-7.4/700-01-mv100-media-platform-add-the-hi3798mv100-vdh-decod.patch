+	0xff4d0146, 0xfe56fb48, 0x003d0000, 0x00000000, 0xfe45fb52, 0xf660023b, 0x024bfd57,
+	0xfd640138, 0xfd4afa55, 0x003bfd51, 0xf956fb5f, 0x00000000, 0x1d101900, 0x0e001428,
+	0x140a1d00, 0x000b0137, 0x00450029, 0x003f003f, 0x003f0000, 0x00000000, 0x14f10236,
+	0x034ae47f, 0xe968fa35, 0xff360733, 0x1f151f1f, 0x19320000, 0x00000000, 0x00000000,
