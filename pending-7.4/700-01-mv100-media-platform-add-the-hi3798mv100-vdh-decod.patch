+ * 5120 bytes); reproduced verbatim, little-endian word order.
+ */
+#ifndef HISTB_VDEC_TABLES_H264_H
+#define HISTB_VDEC_TABLES_H264_H
+
+#include <linux/types.h>
+
+#define HISTB_VDEC_CABAC_MN_H264_WORDS	1280
+
+static const u32 histb_vdec_cabac_mn_h264[HISTB_VDEC_CABAC_MN_H264_WORDS] = {
