+	0x0743fb56, 0x0258003a, 0xfd4cf65e, 0x05360445, 0xfd510058, 0x00000000, 0x16192200,
+	0x10001a22, 0x13162800, 0x000b0137, 0x00450029, 0x003f003f, 0x003f0000, 0x00000000,
