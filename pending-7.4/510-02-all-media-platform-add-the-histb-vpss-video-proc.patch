diff --git a/drivers/media/platform/hisilicon/Kconfig b/drivers/media/platform/hisilicon/Kconfig
index 32415c03621a..a29229ead55b 100644
--- a/drivers/media/platform/hisilicon/Kconfig
+++ b/drivers/media/platform/hisilicon/Kconfig
@@ -41,3 +41,38 @@
 
 	  To compile this driver as a module, choose M here: the module will be
 	  called histb-jpge.
+
+config VIDEO_HISTB_VENC
+	tristate "HiSilicon HiSTB H.264 encoder driver"
+	depends on ARCH_HISI || COMPILE_TEST
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on VIDEO_DEV
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	help
+	  Support for the VEDU hardware H.264 encoder on HiSilicon Hi3798MV100
+	  and Hi3716CV200 set-top-box SoCs. The driver encodes one 8-bit
+	  semi-planar picture per mem2mem job as an IDR frame with CAVLC, writes
+	  the sequence and picture
+	  parameter sets and the slice header the block does not produce itself,
+	  and reads the coded packets back out of the ring buffer it programs.
+
+	  To compile this driver as a module, choose M here: the module will be
+	  called histb-venc.
+
+config VIDEO_HISTB_VPSS
+	tristate "HiSilicon HiSTB video processing subsystem driver"
+	depends on ARCH_HISI || COMPILE_TEST
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on VIDEO_DEV
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	help
+	  Support for the VPSS video processing block on HiSilicon Hi3798MV100
+	  set-top-box SoCs. The driver exposes it as a mem2mem device that turns
+	  a decoder frame into a linear one (undoing the 16x16 tile layout),
+	  optionally scaling it and de-interlacing it with the block's motion
+	  estimator.
+
+	  To compile this driver as a module, choose M here: the module will be
+	  called histb-vpss.
diff --git a/drivers/media/platform/hisilicon/Makefile b/drivers/media/platform/hisilicon/Makefile
index 4dd3f930285e..dd687969c7e6 100644
