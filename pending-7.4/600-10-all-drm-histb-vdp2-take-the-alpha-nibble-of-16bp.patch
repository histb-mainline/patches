Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Sat, 31 Oct 2026 13:31:45 +0800
Subject: drm/histb: vdp2: take the alpha nibble of 16bpp surfaces

A 16bpp surface carries per-pixel alpha in one nibble.
Map that nibble onto the plane alpha the mixer expects.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 2 files changed, 18 insertions(+)


diff --git a/drivers/gpu/drm/histb/histb-vdp2-regs.h b/drivers/gpu/drm/histb/histb-vdp2-regs.h
index ebeb60cc8351..51d78785dab4 100644
--- a/drivers/gpu/drm/histb/histb-vdp2-regs.h
+++ b/drivers/gpu/drm/histb/histb-vdp2-regs.h
@@ -102,6 +102,14 @@
 #define G0_IFMT_RGB444		0x40	/* 16bpp, R in bits 11:8, no alpha */
 #define G0_IFMT_RGB555		0x41	/* 16bpp, R in bits 14:10, no alpha */
 #define G0_IFMT_RGB565		0x42	/* 16bpp, no alpha */
+#define G0_IFMT_ARGB4444	0x48	/* 16bpp, A:R:G:B nibbles */
+/*
+ * 0x49 is the 16bpp code with a single alpha bit. It is not used: with
+ * palpha_en set the layer disappeared for both bit states, under every
+ * combination of palpha_range and premult_en that was tried, while the same
+ * pixels with the bit cleared came back at full level (board, luma 0 for
+ * 0x10ff/0x11ff/0x30ff/0x31ff and 255 for 0x00ff).
+ */
 #define G0_IFMT_RGB888		0x50	/* 24bpp, one byte per channel, no alpha */
 #define G0_IFMT_KRGB888		0x60	/* 32bpp, alpha ignored */
 #define G0_IFMT_ARGB8888	0x68	/* 32bpp, alpha taken from the pixel */
diff --git a/drivers/gpu/drm/histb/histb-vdp2.c b/drivers/gpu/drm/histb/histb-vdp2.c
index e98554a9d17d..f64d0e9ba858 100644
--- a/drivers/gpu/drm/histb/histb-vdp2.c
+++ b/drivers/gpu/drm/histb/histb-vdp2.c
@@ -350,6 +350,7 @@ static const u32 histb_vdp2_formats[] = {
 	DRM_FORMAT_RGBA8888,
 	DRM_FORMAT_RGB565,
 	DRM_FORMAT_XRGB4444,
+	DRM_FORMAT_ARGB4444,
 	DRM_FORMAT_XRGB1555,
 	/* one byte per channel; the fetch stride is in 16-byte units, so the
 	 * width has to be a multiple of 16 pixels for the pitch to divide.
@@ -762,6 +763,15 @@ static void histb_vdp2_g0_set(struct histb_vdp2 *vdp, struct drm_framebuffer *fb
 	case DRM_FORMAT_XRGB1555:
 		ifmt = G0_IFMT_RGB555;
 		break;
+	case DRM_FORMAT_ARGB4444:
+		/*
+		 * The alpha nibble is replicated into a byte before the blend
+		 * (board: a white surface with the nibble 0/1/4/8/15 came back as
+		 * 0/17/67/135/255, which is the nibble times 0x11 over 255), so the
+		 * range bit stays set here as it does for the byte-alpha codes.
+		 */
+		ifmt = blend ? G0_IFMT_ARGB4444 : G0_IFMT_RGB444;
+		break;
 	case DRM_FORMAT_RGB565:
 		ifmt = G0_IFMT_RGB565;
 		break;
-- 
