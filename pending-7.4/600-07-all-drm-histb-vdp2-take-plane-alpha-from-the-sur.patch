Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Sat, 31 Oct 2026 11:14:55 +0800
Subject: drm/histb: vdp2: take plane alpha from the surface when present

A surface can carry its own alpha that the plane property hides.
Prefer the surface alpha when the format provides one.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 2 files changed, 35 insertions(+), 46 deletions(-)


diff --git a/drivers/gpu/drm/histb/histb-vdp2-regs.h b/drivers/gpu/drm/histb/histb-vdp2-regs.h
index d49ad468ce1d..3b4505bf532f 100644
--- a/drivers/gpu/drm/histb/histb-vdp2-regs.h
+++ b/drivers/gpu/drm/histb/histb-vdp2-regs.h
@@ -35,13 +35,6 @@
 #define   VO_MUX_VGA_SEL	BIT(2)
 #define   VO_MUX_HDMI_SEL	BIT(3)
 #define   VO_MUX_DIGITAL	GENMASK(5, 4)
-#define VO_MUX_TESTSYNC		0x0108	/* vo_test_en[31] + test sync polarity bits */
-#define VO_MUX_TESTDATA		0x010c	/* test_data[29:0] */
-/*
- * Reserved on mv100 and mv200: never written, reads back 0. Listed only so the
- * register dump lines up with the rest of the block.
- */
-#define VO_DAC_MUX		0x0140
 #define VO_INTSTA		0x0004
 #define VO_MSKINTSTA		0x0008	/* write 1 to clear int status */
 #define VO_INTMSK		0x000c	/* 1 = that source delivers */
@@ -60,22 +53,6 @@
 #define   VO_AXI_M0_RD1_OSTD GENMASK(7, 4)	/* read outstanding, bus 1 */
 #define   VO_AXI_M0_WR_OSTD GENMASK(11, 8)	/* write outstanding */
 
-/*
- * Second display channel ("SD"), addressed as the DHD0 registers plus
- * CHN_OFFSET. Nothing in this range is named by the SoC's register layout, so
- * the names below mirror the DHD0 layout.
- */
-#define SD_CTRL			0xc400
-#define SD_VSYNC		0xc404
-#define SD_HSYNC1		0xc408
-#define SD_HSYNC2		0xc40c
-#define SD_VPLUS		0xc410
-#define SD_PWR			0xc414
-#define SD_VTTHD3		0xc418
-#define SD_VTTHD		0xc41c
-#define SD_SYNC_INV		0xc420
-#define SD_DATA_SEL		0xc42c
-
 /* ------------------------------------------------------------------ */
 /* G0 graphics (RGB fetch) layer                                       */
 /* ------------------------------------------------------------------ */
@@ -99,7 +76,9 @@
 #define   G0_IRESO_IH GENMASK(23, 12)
 #define G0_CBMPARA		0x6030
 #define   G0_CBMPARA_GALPHA GENMASK(7, 0)
+#define   G0_CBMPARA_PALPHA_RANGE BIT(8)	/* 1: alpha over 255, else 7 bits only */
 #define   G0_CBMPARA_PALPHA_EN BIT(12)	/* take alpha from the pixel, not from galpha */
+#define   G0_CBMPARA_PREMULT_EN BIT(13)	/* the surface is premultiplied by its own alpha */
 #define   G0_CBMPARA_KEY_EN	BIT(14)	/* colour-key the surface */
 #define   G0_CBMPARA_KEY_MODE	BIT(15)
 #define G0_PARAUP		0x6044
@@ -148,8 +127,6 @@
 #define   GP0_PARAUP_VCOEF	BIT(1)	/* latch the vertical step and table */
 #define GP0_DFPOS		0x9100
 #define GP0_DLPOS		0x9104
-#define GP0_BK			0x9110
-#define GP0_ALPHA		0x9114
 #define   GP0_UPD_REGUP BIT(0)
 #define GP0_ORESO		0x9008
 #define   GP0_ORESO_OW GENMASK(11, 0)
@@ -170,8 +147,7 @@
  * cv200 needs a matrix here even though the interface runs in RGB: the G0 fetch
  * hands its three components to the mixer one position rotated, and neither an
  * ifmt code nor any 32-bit DRM pixel format reaches the honest assignment
- * (board-measured on the AR513W). GP0_CSC_CYC below is that compensation;
- * the same stage also
+ * (board-measured on the AR513W). GP0_CSC_CYC below is that compensation; the same stage also
  * carries the 219/255 gain and the +16 code offset that make the luma the
  * limited range the AVI InfoFrame declares (see the comment on the writes in
  * histb-vdp2.c).
@@ -295,8 +271,6 @@
 					 */
 #define   CBM_BKG_BLACK		0x04080200	/* Y=64, Cb=Cr=512 */
 #define CBM_MIX1		0xb408		/* DHD0 mixer priority */
-#define CBM_BKG2		0xb420		/* DHD1 mixer background */
-#define CBM_MIX2		0xb428		/* DHD1 mixer priority */
 #define CBM_ATTR		0xb440
 #define   CBM_ATTR_SUR0 BIT(0)
 #define   CBM_ATTR_SUR1 BIT(1)
@@ -441,9 +415,6 @@
 #define   DHD_SYNC_HDMI_F_INV BIT(11)
 #define   DHD_SYNC_DATE_HS_INV BIT(13)
 #define DHD0_DATA_SEL		0xc02c
-#define DHD0_STATE		0xc0f0	/* live: vblank[1] vcnt[15:3] */
-#define DHD0_DEBUG		0xc0f8	/* live: pix_h[15:0] pix_v[27:16] pix_src[30:28] */
-#define DHD0_DEBUG_STATE	0xc0fc	/* live: pixel_value[29:0] at the sample point */
 #define HDATE_VERSION		0xf000	/* IP version word; anchor of the register layout */
 #define HDATE_STATE		0xf010	/* hd digital port: line_len[12:0] frame_len[26:16] */
 #define HDATE_EN		0xf004	/* hd_en[0]: hd digital output port enable */
@@ -476,6 +447,5 @@
  * register has to be read, patched and written back.
  */
 #define   DHD_DATA_SEL_HDMI BIT(3)
-#define DHD0_ABUFTHD		0xc034
 
 #endif /* _HISTB_VDP2_REGS_H_ */
diff --git a/drivers/gpu/drm/histb/histb-vdp2.c b/drivers/gpu/drm/histb/histb-vdp2.c
index 0e303387c3bc..a5f2ca9173ed 100644
--- a/drivers/gpu/drm/histb/histb-vdp2.c
+++ b/drivers/gpu/drm/histb/histb-vdp2.c
@@ -685,6 +685,7 @@ static void histb_vdp2_g0_set(struct histb_vdp2 *vdp, struct drm_framebuffer *fb
 			    const struct drm_plane_state *pstate, bool enable)
 {
 	u32 ctrl, ifmt;
+	bool palpha;
 	u32 src_x, src_y, src_w, src_h, dst_x, dst_y, dst_w, dst_h;
 	u32 win_w, win_h;
 
@@ -719,17 +720,18 @@ static void histb_vdp2_g0_set(struct histb_vdp2 *vdp, struct drm_framebuffer *fb
 		break;
 	case DRM_FORMAT_ARGB8888:
 		/*
-		 * Scanned out through the opaque 32bpp coding: the alpha byte
-		 * would reach the mixer as a 7-bit field, which is neither the
-		 * coverage nor the premultiplied formula, so the byte is ignored
-		 * and the plane declares blend mode "None".
+		 * The alpha byte only reaches the mixer once the pixel-alpha path is
+		 * switched on, so "None" keeps the opaque coding and the other two
+		 * blend modes hand the byte over.
 		 */
-		ifmt = G0_IFMT_KRGB888;
+		ifmt = pstate->pixel_blend_mode == DRM_MODE_BLEND_PIXEL_NONE ?
+		       G0_IFMT_KRGB888 : G0_IFMT_ARGB8888;
 		break;
 	default:
 		ifmt = G0_IFMT_KRGB888;
 		break;
 	}
+	palpha = ifmt == G0_IFMT_ARGB8888;
 
 	/*
 	 * bitext, read_mode and upd_mode all have to be set for a layer that
@@ -747,11 +749,24 @@ static void histb_vdp2_g0_set(struct histb_vdp2 *vdp, struct drm_framebuffer *fb
 	/*
 	 * The plane's "alpha" is 16-bit (0xffff opaque), this field is 8-bit, so
 	 * the top byte is what reaches the mixer; latched by G0_UPD below.
+	 *
+	 * palpha_range picks the divisor for the pixel's alpha byte: with it set the
+	 * blend is out = a*c + (1-a)*bg over the full byte (measured against a
+	 * non-black mixer background: 0x00/0x40/0x80/0xc0/0xff came back within one
+	 * luma step of that line), cleared it only uses the top seven bits and
+	 * saturates at 0x80. premult_en is the other half of the DRM choice: the
+	 * buffer's colour is then added as it stands and only the background is
+	 * scaled by (1-a), which is what a premultiplied surface expects.
 	 */
 	ctrl = vo_read(vdp, G0_CBMPARA);
-	ctrl &= ~(G0_CBMPARA_GALPHA | G0_CBMPARA_PALPHA_EN |
-		  G0_CBMPARA_KEY_EN | G0_CBMPARA_KEY_MODE);
+	ctrl &= ~(G0_CBMPARA_GALPHA | G0_CBMPARA_PALPHA_EN | G0_CBMPARA_PALPHA_RANGE |
+		  G0_CBMPARA_PREMULT_EN | G0_CBMPARA_KEY_EN | G0_CBMPARA_KEY_MODE);
 	ctrl |= FIELD_PREP(G0_CBMPARA_GALPHA, pstate->alpha >> 8);
+	if (palpha) {
+		ctrl |= G0_CBMPARA_PALPHA_EN | G0_CBMPARA_PALPHA_RANGE;
+		if (pstate->pixel_blend_mode == DRM_MODE_BLEND_PREMULTI)
+			ctrl |= G0_CBMPARA_PREMULT_EN;
+	}
 	vo_write(vdp, G0_CBMPARA, ctrl);
 
 	/*
@@ -2229,14 +2244,18 @@ static int histb_vdp2_bind(struct device *dev)
 	drm_plane_helper_add(&disp->primary, &histb_vdp2_plane_helper_funcs);
 
 	/*
-	 * There is no upstream blend mode that describes what this block does
-	 * with a pixel's alpha byte: the field is 7 bits wide, so bit 7 is
-	 * discarded and coverage wraps (board: alpha 129 scans as transparent,
-	 * 192 as half coverage, 240 as 0.875). The surface is therefore
-	 * scanned out opaque and only "None" is offered.
+	 * The mixer can take the alpha byte as a coverage weight, and it can treat
+	 * the surface as premultiplied, so both upstream modes are offered next to
+	 * "None". Measured over a non-black background with the pixel-alpha path and
+	 * its range bit set, alpha 0x00/0x40/0x80/0xc0/0xff came back at the panel
+	 * within one luma step of a*c + (1-a)*bg; with the range bit clear only part
+	 * of the byte is used, so that bit is always set here. See
+	 * histb_vdp2_g0_set().
 	 */
 	ret = drm_plane_create_blend_mode_property(&disp->primary,
-					BIT(DRM_MODE_BLEND_PIXEL_NONE));
+					BIT(DRM_MODE_BLEND_PIXEL_NONE) |
+					BIT(DRM_MODE_BLEND_PREMULTI) |
+					BIT(DRM_MODE_BLEND_COVERAGE));
 	if (ret) {
 		dev_err_probe(dev, ret, "blend_mode failed\n");
 		goto err_put;
