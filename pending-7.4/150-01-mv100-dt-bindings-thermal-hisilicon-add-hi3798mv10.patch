Replace-From: Hongfu Yang <yanghf_0@126.com>
Replace-Date: Mon, 12 Oct 2026 13:22:48 +0800
Subject: dt-bindings: thermal: hisilicon: add Hi3798MV100 tsensor

The Hi3798MV100 tsensor sits in the PMC block, has no interrupt and
exposes a single sensor.
Add the compatible and allow the thermal sensor cell count to be zero;
the missing interrupt is modelled by forbidding the property on that one
compatible instead of requiring it.

Signed-off-by: Hongfu Yang <yanghf_0@126.com>
Signed-off-by: David Yang <mmyangfl@gmail.com>
 1 file changed, 21 insertions(+), 2 deletions(-)


diff --git a/Documentation/devicetree/bindings/thermal/hisilicon,tsensor.yaml b/Documentation/devicetree/bindings/thermal/hisilicon,tsensor.yaml
index 11aca2b749d7..963501e71d23 100644
--- a/Documentation/devicetree/bindings/thermal/hisilicon,tsensor.yaml
+++ b/Documentation/devicetree/bindings/thermal/hisilicon,tsensor.yaml
@@ -11,12 +11,25 @@ maintainers:
 
 allOf:
   - $ref: thermal-sensor.yaml
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - hisilicon,hi3798mv100-tsensor
+    then:
+      properties:
+        interrupts: false
+    else:
+      required:
+        - interrupts
 
 properties:
   compatible:
     enum:
       - hisilicon,tsensor
       - hisilicon,hi3660-tsensor
+      - hisilicon,hi3798mv100-tsensor
 
   reg:
     maxItems: 1
@@ -32,12 +45,11 @@ properties:
     maxItems: 1
 
   '#thermal-sensor-cells':
-    const: 1
+    enum: [0, 1]
 
 required:
   - compatible
   - reg
-  - interrupts
   - '#thermal-sensor-cells'
 
 unevaluatedProperties: false
@@ -55,3 +67,10 @@ examples:
         clock-names = "thermal_clk";
         #thermal-sensor-cells = <1>;
     };
+
+  - |
+    tsensor@8a23028 {
+        compatible = "hisilicon,hi3798mv100-tsensor";
+        reg = <0x8a23028 0x10>;
+        #thermal-sensor-cells = <0>;
+    };
-- 
