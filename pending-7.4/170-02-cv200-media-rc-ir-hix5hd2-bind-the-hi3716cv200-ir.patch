Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Tue, 27 Oct 2026 17:43:53 +0800
Subject: media: rc: ir-hix5hd2: bind the Hi3716CV200 IR block

The Hi3716CV200 IR receiver has no entry in this driver.
Its register map and its gate (SYS_CTRL + 0x48, bit 4 enable, bit 5
reset) match the hix5hd2 data, and the value its boot leaves in the
symbol-width field is the one this driver programs.
Bind the compatible to that device data; it needs no extra power-enable
bit.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 2 files changed, 9 insertions(+)


diff --git a/drivers/media/rc/ir-hix5hd2.c b/drivers/media/rc/ir-hix5hd2.c
index aa3de4d57a58..a78b053fbae6 100644
--- a/drivers/media/rc/ir-hix5hd2.c
+++ b/drivers/media/rc/ir-hix5hd2.c
@@ -243,6 +243,14 @@ static irqreturn_t hix5hd2_ir_rx_interrupt(int irq, void *data)
 static const struct of_device_id hix5hd2_ir_table[] = {
 	{ .compatible = "hisilicon,hix5hd2-ir", &hix5hd2_data, },
 	{ .compatible = "hisilicon,hi3796cv300-ir", &hi3796cv300_data, },
+	/*
+	 * Hi3716CV200 keeps the same register map and the same gate
+	 * (SYS_CTRL + 0x48, bit 4 enable, bit 5 reset), and its boot
+	 * leaves 0x3e80 in the symbol-width field this driver programs,
+	 * so it reuses the hix5hd2 data. It needs no extra power-enable
+	 * bit.
+	 */
+	{ .compatible = "hisilicon,hi3716cv200-ir", &hix5hd2_data, },
 	{},
 };
 MODULE_DEVICE_TABLE(of, hix5hd2_ir_table);
diff --git a/drivers/media/rc/keymaps/Makefile b/drivers/media/rc/keymaps/Makefile
index 38b84e34b225..f6573da4bc19 100644
--- a/drivers/media/rc/keymaps/Makefile
+++ b/drivers/media/rc/keymaps/Makefile
@@ -107,6 +107,7 @@ obj-$(CONFIG_RC_MAP) += \
 			rc-real-audio-220-32-keys.o \
 			rc-reddo.o \
 			rc-siemens-gigaset-rc20.o \
+			rc-skyworth-yk.o \
 			rc-snapstream-firefly.o \
 			rc-streamzap.o \
 			rc-su3000.o \
