Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Wed, 21 Oct 2026 15:55:25 +0800
Subject: ARM: dts: hisilicon: describe the cv200 display and audio blocks

The output path and the audio path have no description.
The AIAO block and the internal DAC are the mv100 generation, the VDP
channel and the flattened SiI9134 reach an HDMI sink through an of_graph
link so the DRM master needs no encoder node, and the card names the
transmitter DAI and the DAC for its playback links.
Describe the channel, enabled, with the transmitter, the DAC and the card.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 1 file changed, 147 insertions(+), 1 deletions(-)


diff --git a/arch/arm/boot/dts/hisilicon/hi3716cv200.dtsi b/arch/arm/boot/dts/hisilicon/hi3716cv200.dtsi
index 1453c4436d17..44e8b968573f 100644
--- a/arch/arm/boot/dts/hisilicon/hi3716cv200.dtsi
+++ b/arch/arm/boot/dts/hisilicon/hi3716cv200.dtsi
@@ -581,6 +581,15 @@
 		};
 
 		/*
+		 * All three numbers come from the cv200 build of the vendor AIAO
+		 * HAL (msp/drv/aiao/aiao_v1_1/common/include/hal_aiao_common.h):
+		 * AIAO_CBB_REGBASE 0xf8cd0000 with AIAO_CBB_REGBANDSIZE 0x10000,
+		 * AIAO_IRQ_NUM (84 + 32) -- which is what the board's own
+		 * /proc/interrupts shows for hi_aiao -- and CRG70 = 0x0118.
+		 * The block is gated by CRG70[0] and reset by CRG70[4].
+		 */
+
+		/*
 		 * Same IP and same window as the mv100 adapters, so the upstream
 		 * hix5hd2 bus driver drives them. Interrupt numbers are read off
 		 * the board's own vendor Android /proc/interrupts (hi_i2c0..3 =
@@ -894,7 +903,17 @@
 			bus-width = <4>;
 			max-frequency = <50000000>;
 			cap-sd-highspeed;
-			status = "disabled";
+			/*
+			 * broken-cd, not non-removable: a card sits in the slot while
+			 * dw_mci_get_cd() -- !(CDETECT & BIT(0)), dw_mmc.c:897 -- keeps
+			 * answering "absent", so the core would never even
+			 * try to initialise it. The detect line is therefore not usable, which is
+			 * exactly what this property means, and polling on a slot a human can
+			 * empty is the honest description; non-removable would instead claim the
+			 * card can never leave.
+			 */
+			broken-cd;
+			status = "okay";
 		};
 
 		sdio1: mmc@f9830000 {
@@ -1135,6 +1154,79 @@
 			reset-names = "venc";
 			status = "disabled";
 		};
+
+		aiao: audio@f8cd0000 {
+			compatible = "hisilicon,hi3716cv200-aiao-i2s";
+			reg = <0xf8cd0000 0x10000>;
+			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_AIAO_CLK>;
+			resets = <&crg 0x118 4>;
+			#sound-dai-cells = <1>;
+		};
+
+		/*
+		 * (msp/drv/hdmi/hdmi_1_4/hdmi_intf_k.c:116) -- the glue polls HPD
+		 */
+		/*
+		 * The output channel (vdp_v1_0 "DHD0"). Its register file is the VDP
+		 * block: the channel's own window starts at base + 0xc000 and the
+		 * whole block, graphics layers included, fits in one 64 KiB page
+		 * (HDATE_VERSION sits at +0xf000 and reads a date code on the board).
+		 * The interrupt is the vendor's own number for this block, INTID 122,
+		 * taken from the running vendor system's /proc/interrupts rather than
+		 * from mach/irqs.h, which disagrees with the board in three places.
+		 *
+		 * pix is the HD channel clock (CRG10/CRG11's word pair as the vendor's
+		 * mode table pairs it with a pixel rate), vo is the rest of CRG54's
+		 * display gates; the driver enables both before it pulses vou_srst_req,
+		 * because a reset request only reaches the block while it is clocked.
+		 */
+		vdp: display@f8cc0000 {
+			compatible = "hisilicon,hi3716cv200-vdp";
+			reg = <0xf8cc0000 0x10000>;
+			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_CLK_VO_HD>,
+				 <&crg HI3716CV200_VO_CLK>;
+			clock-names = "pix", "vo";
+			resets = <&crg 0xd8 30>;
+			status = "okay";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					vdp_out_hdmi: endpoint {
+						remote-endpoint = <&hdmi_in_vdp>;
+					};
+				};
+			};
+		};
+
+		hdmi: hdmi@f8ce0000 {
+			compatible = "hisilicon,hi3716cv200-hdmi";
+			reg = <0xf8ce0000 0x10000>;
+			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_HDMITX_CTRL_CLK>,
+				 <&crg HI3716CV200_HDMITX_PHY_CLK>;
+			clock-names = "ctrl", "phy";
+			resets = <&crg 0x10c 9>, <&crg 0x10c 8>, <&crg 0x110 4>;
+			reset-names = "base", "bus", "phy";
+			#sound-dai-cells = <0>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hdmi_in_vdp: endpoint {
+						remote-endpoint = <&vdp_out_hdmi>;
+					};
+				};
+			};
+		};
 	};
 };
 
@@ -1147,4 +1239,58 @@
 		stdout-path = "serial0:115200n8";
 	};
 
+	/*
+	 * The internal DAC. It has no register that picks where its serial data
+	 * comes from: the vendor port map connects it to AIAO transmit port 2
+	 * (aiao_v1_1/ao/drv_ao_op.c:33-50), which is why the link below names
+	 * that port rather than any of the others.
+	 */
+	adac: audio-codec@f8a20110 {
+		compatible = "hisilicon,hi3716cv200-adac";
+		reg = <0xf8a20110 0x8>;
+		clocks = <&crg HI3716CV200_ADAC_CLK>;
+		resets = <&crg 0x114 4>;
+		#sound-dai-cells = <0>;
+	};
+
+	/*
+	 */
+	sound {
+		compatible = "hisilicon,hi3716cv200-aiao-card";
+		model = "hi3716cv200-aiao";
+
+		playback {
+			cpu {
+				sound-dai = <&aiao 0>;
+			};
+
+			codec {
+				sound-dai = <&hdmi>;
+			};
+		};
+
+		capture {
+			cpu {
+				sound-dai = <&aiao 1>;
+			};
+		};
+
+		dac-playback {
+			cpu {
+				sound-dai = <&aiao 2>;
+			};
+
+			codec {
+				sound-dai = <&adac>;
+			};
+		};
+
+		/*
+		 */
+		dac-capture {
+			cpu {
+				sound-dai = <&aiao 3>;
+			};
+		};
+	};
 };
