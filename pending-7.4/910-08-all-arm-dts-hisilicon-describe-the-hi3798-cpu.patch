Replace-From: Hongfu Yang <yanghf_0@126.com>
Replace-Date: Mon, 12 Oct 2026 13:22:51 +0800
Subject: ARM: dts: hisilicon: describe the Hi3798 CPU operating points

The A7 cluster of the Hi3798 parts has no operating-points table, so
cpufreq-dt has nothing to scale against.
The vendor PMOC driver names the voltage of each step, and the rail
range in the family file already covers them.
Add the table to the shared S5 include, with the two points this board
uses.

Signed-off-by: Hongfu Yang <yanghf_0@126.com>
Signed-off-by: David Yang <mmyangfl@gmail.com>
 1 file changed, 35 insertions(+)


diff --git a/arch/arm/boot/dts/hisilicon/hi3798-s5.dtsi b/arch/arm/boot/dts/hisilicon/hi3798-s5.dtsi
index d83948b6301d..ccc31073248f 100644
--- a/arch/arm/boot/dts/hisilicon/hi3798-s5.dtsi
+++ b/arch/arm/boot/dts/hisilicon/hi3798-s5.dtsi
@@ -22,24 +22,59 @@ cpu0: cpu@0 {
 			compatible = "arm,cortex-a7";
 			device_type = "cpu";
 			reg = <0>;
+			clocks = <&crg HI3798MV100_CPU_CLK>;
+			operating-points-v2 = <&cpu_opp_table>;
+			cpu-supply = <&vddcpu>;
+			#cooling-cells = <2>;
 		};
 
 		cpu1: cpu@1 {
 			compatible = "arm,cortex-a7";
 			device_type = "cpu";
 			reg = <1>;
+			operating-points-v2 = <&cpu_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu2: cpu@2 {
 			compatible = "arm,cortex-a7";
 			device_type = "cpu";
 			reg = <2>;
+			operating-points-v2 = <&cpu_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu3: cpu@3 {
 			compatible = "arm,cortex-a7";
 			device_type = "cpu";
 			reg = <3>;
+			operating-points-v2 = <&cpu_opp_table>;
+			#cooling-cells = <2>;
+		};
+	};
+
+	/*
+	 * The cluster shares one clock and one rail, so all CPUs use a single
+	 * shared table.  The voltages are the vendor's per-OPP upper bounds
+	 * (msp/drv/include/hi_drv_pmoc.h: HI_VDD_MPU_OPP2_UV and HI_VDD_MPU_OPP4_UV)
+	 * rather than the AVS minimum, which is the conservative choice here
+	 * since this port does not implement the HPM/AVS hardware.
+	 *
+	 * The vendor's 1200 and 1500MHz points need 1420 and 1495mV and are left
+	 * out for now: this board has no heatsink and has no use for them.
+	 */
+	cpu_opp_table: opp-table {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-600000000 {
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <1150000>;
+		};
+
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <1300000>;
 		};
 	};
 
