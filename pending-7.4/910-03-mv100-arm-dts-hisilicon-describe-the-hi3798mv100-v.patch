Replace-From: David Yang <mmyangfl@gmail.com>
Replace-Date: Tue, 3 Nov 2026 13:45:21 +0800
Subject: ARM: dts: hisilicon: describe the Hi3798MV100 VPSS block

The video processing subsystem and the decoder reset names it shares its
CRG word with are not described.
The VPSS sits at 0x8cb0000 behind a CRG60 gate and a CRGf0 reset, takes
its tiled frames from the shared media pool, and the decoder's reset
cells are the three bits the driver actually asserts (global, scd, mfd).
Add the VPSS node and correct the decoder reset names.

Signed-off-by: David Yang <mmyangfl@gmail.com>
 2 files changed, 16 insertions(+)


diff --git a/arch/arm/boot/dts/hisilicon/hi3798mv100-ec6108v9c.dts b/arch/arm/boot/dts/hisilicon/hi3798mv100-ec6108v9c.dts
index 796acdb058a8..a9e82b922ae6 100644
--- a/arch/arm/boot/dts/hisilicon/hi3798mv100-ec6108v9c.dts
+++ b/arch/arm/boot/dts/hisilicon/hi3798mv100-ec6108v9c.dts
@@ -328,6 +328,11 @@ &vdec {
 	status = "okay";
 };
 
+&vpss {
+	memory-region = <&media_cma>;
+	status = "okay";
+};
+
 &jpgd {
 	memory-region = <&media_cma>;
 	status = "okay";
diff --git a/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi b/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi
index dedb96604b03..db2dc64940d3 100644
--- a/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi
+++ b/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi
@@ -60,6 +60,17 @@ venc: video-encoder@8c80000 {
 		status = "disabled";
 	};
 
+	vpss: video-processor@8cb0000 {
+		compatible = "hisilicon,hi3798mv100-vpss";
+		reg = <0x8cb0000 0x10000>;
+		interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&crg HI3798MV100_VPSS_CLK>;
+		clock-names = "vpss";
+		resets = <&crg 0xf0 4>;
+		reset-names = "vpss";
+		status = "disabled";
+	};
+
 	vdec: video-codec@8c30000 {
 		compatible = "hisilicon,hi3798mv100-vdec";
 		reg = <0x8c30000 0x1100>, <0x8c3c000 0x1000>;
-- 
