From d569ec16e49126e4eb1115d2e625147b384f048c Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Sat, 24 Oct 2026 14:43:09 +0800
Subject: [PATCH 3/4] net: hix5hd2: keep the receive queue alive across a close

hix5hd2_net_close() frees the receive buffers while the free queue still
holds the sixteen descriptors the block has already fetched.

A port that keeps receiving then DMAs arrived frames into buffers the
slab has already taken back; on an AR513W (hi3716cv200) the descriptors
the block consumed at the next open all carried the previous session's
stamps, and the frames received then came up as slab garbage -- six
parsed as LLC, the rest with an unrecognized ethertype.

Carry the receive buffers, their descriptors and the queue pointers
through the close and release them with the rings when the device goes
away, so that the block keeps ownership of every address it prefetches.
The sibling hisi_femac block had the same defect and reset the port
before freeing its ring (d54b21d82430); this block has no reset that
reaches the descriptors it has already fetched.

Fixes: 57c5bc9ad7d7 ("net: hisilicon: add hix5hd2 mac driver")
Cc: stable@vger.kernel.org
Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 drivers/net/ethernet/hisilicon/hix5hd2_gmac.c | 25 +++++++++++++++---
 1 file changed, 19 insertions(+), 2 deletions(-)

--- a/drivers/net/ethernet/hisilicon/hix5hd2_gmac.c
+++ b/drivers/net/ethernet/hisilicon/hix5hd2_gmac.c
@@ -792,7 +792,14 @@ static netdev_tx_t hix5hd2_net_xmit(stru
 	return NETDEV_TX_OK;
 }
 
-static void hix5hd2_free_dma_desc_rings(struct hix5hd2_priv *priv)
+/*
+ * Release the receive buffers when the device goes away, not when the
+ * interface is closed: the block prefetches sixteen free-queue
+ * descriptors and keeps them across a close, so freeing rx_skb[] there
+ * hands it buffers it still owns and the reopened interface receives
+ * buffers no DMA ever wrote. Release them with the rings instead.
+ */
+static void hix5hd2_release_rx_buffers(struct hix5hd2_priv *priv)
 {
 	struct hix5hd2_desc *desc;
 	dma_addr_t addr;
@@ -810,6 +817,13 @@ static void hix5hd2_free_dma_desc_rings(
 		dev_kfree_skb_any(skb);
 		priv->rx_skb[i] = NULL;
 	}
+}
+
+static void hix5hd2_free_tx_buffers(struct hix5hd2_priv *priv)
+{
+	struct hix5hd2_desc *desc;
+	dma_addr_t addr;
+	int i;
 
 	for (i = 0; i < TX_DESC_NUM; i++) {
 		struct sk_buff *skb = priv->tx_skb[i];
@@ -873,7 +887,7 @@ static int hix5hd2_net_close(struct net_
 	hix5hd2_irq_disable(priv);
 	napi_disable(&priv->napi);
 	netif_stop_queue(dev);
-	hix5hd2_free_dma_desc_rings(priv);
+	hix5hd2_free_tx_buffers(priv);
 
 	if (dev->phydev) {
 		phy_stop(dev->phydev);
@@ -985,6 +999,9 @@ static void hix5hd2_destroy_hw_desc_queu
 {
 	int i;
 
+	/* the receive buffers survive a close, so they are freed with the rings */
+	hix5hd2_release_rx_buffers(priv);
+
 	for (i = 0; i < QUEUE_NUMS; i++) {
 		if (priv->pool[i].desc) {
 			dma_free_coherent(priv->dev, priv->pool[i].size,
