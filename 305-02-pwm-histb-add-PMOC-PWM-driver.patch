--- /dev/null
+++ b/drivers/pwm/pwm-histb.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: MIT OR GPL-2.0-or-later
+/*
+ * PWM driver for the PMOC outputs of the HiSilicon Hi3798cv200 STB SoC
+ *
+ * Copyright (c) 2026 David Yang
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pwm.h>
+
+/*
+ * Both fields are programmed as the number of clock periods plus one, so
+ * a field of one selects an empty counter range and leaves the output in a
+ * single state for the whole period. The outputs have no gate.
+ *
+ * The counter field counts the high phase of the period: the vendor
+ * miniboot programs 0x006500a1 (counter 0x65, period 0xa1, a 62.5% high
+ * duty) for the 900 mV point of the reference DVFS design, whose feedback
+ * network (Hi3798M V200 data sheet, section 3.2.7) lowers the rail voltage
+ * as the duty cycle rises.
+ */
+#define HISTB_PWM_DUTY		GENMASK(31, 16)
+#define HISTB_PWM_PERIOD	GENMASK(15, 0)
+#define HISTB_PWM_STRIDE	4
+
+/* The largest count a field can still express. */
+#define HISTB_PWM_COUNT_MAX	(U16_MAX - 1)
+
+/* PWM0 on pin PMC_CPU0, PWM1 on PMC_CORE0, PWM2 on PMC_GPU0. */
+#define HI3798CV200_NUM_PWMS		3
+
+struct histb_pwm {
+	void __iomem *base;
+	unsigned long rate;
+};
+
+static void __iomem *histb_pwm_reg(struct histb_pwm *histb, unsigned int index)
+{
+	return histb->base + index * HISTB_PWM_STRIDE;
+}
+
+static unsigned int histb_pwm_count_from_field(u32 field)
+{
+	return field != 0 ? field - 1 : 0;
+}
+
+static int histb_pwm_apply(struct pwm_chip *chip, struct pwm_device *pwm,
+			   const struct pwm_state *state)
+{
+	struct histb_pwm *histb = pwmchip_get_drvdata(chip);
+	unsigned int duty, period;
+
+	/* Bounds both the multiplication below and the fields themselves. */
+	if (state->period > DIV_ROUND_DOWN_ULL((u64) HISTB_PWM_COUNT_MAX *
+					       NSEC_PER_SEC, histb->rate))
+		return -EINVAL;
+
+	period = DIV_ROUND_CLOSEST_ULL((u64) state->period * histb->rate,
+				       NSEC_PER_SEC);
+	if (period == 0)
+		return -EINVAL;
+
+	duty = DIV_ROUND_CLOSEST_ULL((u64) state->duty_cycle * histb->rate,
+				     NSEC_PER_SEC);
+	if (duty > period)
+		duty = period;
+
+	writel(FIELD_PREP(HISTB_PWM_PERIOD, period + 1) |
+	       FIELD_PREP(HISTB_PWM_DUTY, duty + 1),
+	       histb_pwm_reg(histb, pwm->hwpwm));
+
+	return 0;
+}
+
+static int histb_pwm_get_state(struct pwm_chip *chip, struct pwm_device *pwm,
+			       struct pwm_state *state)
+{
+	struct histb_pwm *histb = pwmchip_get_drvdata(chip);
+	unsigned int counter, duty, period;
+	u32 val;
+
+	val = readl(histb_pwm_reg(histb, pwm->hwpwm));
+	period = histb_pwm_count_from_field(FIELD_GET(HISTB_PWM_PERIOD, val));
+	counter = histb_pwm_count_from_field(FIELD_GET(HISTB_PWM_DUTY, val));
+
+	duty = counter > period ? period : counter;
+
+	state->enabled = true;
+	state->polarity = PWM_POLARITY_NORMAL;
+	state->period = DIV_ROUND_CLOSEST_ULL((u64) period * NSEC_PER_SEC,
+					      histb->rate);
+	state->duty_cycle = DIV_ROUND_CLOSEST_ULL((u64) duty * NSEC_PER_SEC,
+						  histb->rate);
+
+	return 0;
+}
+
+static const struct pwm_ops histb_pwm_ops = {
+	.apply = histb_pwm_apply,
+	.get_state = histb_pwm_get_state,
+};
+
+static int histb_pwm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	unsigned int num_pwms = (uintptr_t) of_device_get_match_data(dev);
+	struct resource *res;
+	struct pwm_chip *chip;
+	struct histb_pwm *histb;
+	struct clk *clk;
+
+	chip = devm_pwmchip_alloc(dev, num_pwms, sizeof(*histb));
+	if (IS_ERR(chip))
+		return PTR_ERR(chip);
+	histb = pwmchip_get_drvdata(chip);
+
+	histb->base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(histb->base))
+		return PTR_ERR(histb->base);
+
+	if (resource_size(res) < num_pwms * HISTB_PWM_STRIDE)
+		return dev_err_probe(dev, -EINVAL, "short register window\n");
+
+	clk = devm_clk_get_enabled(dev, NULL);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	histb->rate = clk_get_rate(clk);
+	if (histb->rate == 0)
+		return dev_err_probe(dev, -EINVAL, "missing clock rate\n");
+
+	chip->ops = &histb_pwm_ops;
+
+	return devm_pwmchip_add(dev, chip);
+}
+
+static const struct of_device_id histb_pwm_of_match[] = {
+	{ .compatible = "hisilicon,hi3798cv200-pwm",
+	  .data = (void *) HI3798CV200_NUM_PWMS },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, histb_pwm_of_match);
+
+static struct platform_driver histb_pwm_driver = {
+	.probe = histb_pwm_probe,
+	.driver = {
+		.name = "histb-pwm",
+		.of_match_table = histb_pwm_of_match,
+	},
+};
+module_platform_driver(histb_pwm_driver);
+
+MODULE_DESCRIPTION("HiSilicon STB PMOC PWM driver");
+MODULE_AUTHOR("David Yang <mmyangfl@gmail.com>");
+MODULE_LICENSE("Dual MIT/GPL");
